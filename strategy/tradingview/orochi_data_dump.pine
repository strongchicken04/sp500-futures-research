// @version=5
indicator("Orochi Data Dump", overlay=true, max_labels_count=50)

// -----------------------------------------------------------------------------
// Vytahne vsechny dulezite Orochi Framework levely z aktualniho chartu na
// jedno misto: Daily/Weekly/Monthly VWAP + ±1σ (=DVA), prior day OHLC,
// prior day VWAP final (aprox. POC), overnight range (18:00 ET -> 9:30 ET),
// prior week H/L, ATR14. Vsechno dumpne do Pine Logs jako jeden text blok
// pripraveny na kopirovani do agenta.
//
// POUZITI:
// 1. Nahod indikator na chart tve session (NQ 1min doporuceno).
// 2. Otevri Pine Logs panel dole (Ctrl+Alt+C na Windows / Cmd+Opt+C na Mac,
//    nebo pravy klik chart -> Add to data window / Logs).
// 3. Zkopiruj cely posledni "DUMP" blok.
// 4. Vloz do agenta (viz orochi_agent_prompt.md).
// -----------------------------------------------------------------------------

// ===== INPUTS =====
showLabels = input.bool(true,  "Show levels on chart", group="Display")
showTable  = input.bool(true,  "Show data table",      group="Display")
tblPos     = input.string("bottom_right", "Table position",
             options=["top_left","top_right","middle_right","bottom_left","bottom_right"],
             group="Display")
atrLen     = input.int(14, "ATR length", minval=1, group="Compute")
onStartHr  = input.int(18, "ON start hour ET", minval=0, maxval=23, group="Overnight")
onEndHr    = input.int(9,  "ON end hour ET",   minval=0, maxval=23, group="Overnight")
onEndMin   = input.int(30, "ON end minute ET", minval=0, maxval=59, group="Overnight")

// ===== HELPERS =====
tp = hlc3

// --- anchored VWAP with std dev bands ---
_anchoredVwap(bool anchor) =>
    var float num = 0.
    var float den = 0.
    var float sumSq = 0.
    if anchor
        num := 0.
        den := 0.
        sumSq := 0.
    num += tp * volume
    den += volume
    vwap_ = den > 0 ? num / den : na
    // running variance approximation
    dev = tp - vwap_
    sumSq += dev * dev * volume
    var_ = den > 0 ? sumSq / den : na
    sd_ = math.sqrt(math.max(var_, 0))
    [vwap_, sd_]

// --- prior period anchored VWAP: keep last completed value ---
_priorVwapKeeper(bool anchor) =>
    var float num = 0.
    var float den = 0.
    var float prev_final = na
    if anchor
        prev_final := den > 0 ? num / den : prev_final
        num := 0.
        den := 0.
    num += tp * volume
    den += volume
    prev_final

// ===== ANCHORS =====
// New day / week / month based on time change
new_day   = ta.change(dayofweek) != 0
new_week  = ta.change(weekofyear) != 0
new_month = ta.change(month) != 0

// ===== TODAY: daily VWAP + bands =====
[dvw, dsd] = _anchoredVwap(new_day)
dva_h = dvw + dsd
dva_l = dvw - dsd
dva_h2 = dvw + 2 * dsd
dva_l2 = dvw - 2 * dsd

// ===== WEEKLY VWAP =====
[wvw, wsd] = _anchoredVwap(new_week)
wva_h = wvw + wsd
wva_l = wvw - wsd

// ===== MONTHLY VWAP =====
[mvw, msd] = _anchoredVwap(new_month)
mva_h = mvw + msd
mva_l = mvw - msd

// ===== PRIOR DAY VWAP final (approx POC of prior day) =====
pdVwapFinal = _priorVwapKeeper(new_day)

// ===== PRIOR DAY OHLC (RTH) =====
pdOpen  = request.security(syminfo.tickerid, "D", open[1],  lookahead=barmerge.lookahead_off)
pdHigh  = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_off)
pdLow   = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_off)
pdClose = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_off)

// ===== PRIOR WEEK H/L =====
pwHigh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_off)
pwLow  = request.security(syminfo.tickerid, "W", low[1],  lookahead=barmerge.lookahead_off)

// ===== OVERNIGHT RANGE (18:00 prev -> 9:30 today ET) =====
et_h = hour(time, "America/New_York")
et_m = minute(time, "America/New_York")
in_on = (et_h >= onStartHr) or (et_h < onEndHr) or (et_h == onEndHr and et_m < onEndMin)

var float onH = na
var float onL = na
var float onH_prev = na
var float onL_prev = na
var float onM_prev = na
// On session-start (first bar of RTH), snapshot & reset
rth_start = (et_h == onEndHr and et_m == onEndMin)
if rth_start
    onH_prev := onH
    onL_prev := onL
    onM_prev := (onH + onL) / 2.0
    onH := na
    onL := na
if in_on
    onH := na(onH) ? high : math.max(onH, high)
    onL := na(onL) ? low  : math.min(onL, low)

// ===== ATR =====
atrv = ta.atr(atrLen)

// ===== APPROX PRIOR DAY VA (VWAP ± 1σ) =====
// Using prior day final VWAP and prior day's stored SD approx
var float pdSD = na
var float pdSD_running = 0.
if new_day
    pdSD := pdSD_running != 0 ? pdSD_running : pdSD
    pdSD_running := 0.
pdSD_running := dsd  // approximation: capture the last SD of prior session at day change
pdVA_H = pdVwapFinal + pdSD
pdVA_L = pdVwapFinal - pdSD

// ===== ON-CHART LEVELS =====
plot(showLabels ? dvw : na,   "DVWAP",   color=color.new(color.orange, 0), linewidth=2)
plot(showLabels ? dva_h : na, "D +1σ",   color=color.new(color.orange, 50))
plot(showLabels ? dva_l : na, "D -1σ",   color=color.new(color.orange, 50))
plot(showLabels ? dva_h2 : na, "D +2σ",  color=color.new(color.orange, 75), style=plot.style_stepline)
plot(showLabels ? dva_l2 : na, "D -2σ",  color=color.new(color.orange, 75), style=plot.style_stepline)

plot(showLabels ? wvw : na,   "WVWAP",   color=color.new(color.aqua, 0), linewidth=2)
plot(showLabels ? wva_h : na, "W +1σ",   color=color.new(color.aqua, 50))
plot(showLabels ? wva_l : na, "W -1σ",   color=color.new(color.aqua, 50))

plot(showLabels ? mvw : na,   "MVWAP",   color=color.new(color.purple, 0), linewidth=1)

plot(showLabels ? pdHigh : na,  "PDH",  color=color.new(color.gray, 30), style=plot.style_stepline)
plot(showLabels ? pdLow  : na,  "PDL",  color=color.new(color.gray, 30), style=plot.style_stepline)
plot(showLabels ? pdClose : na, "PDC",  color=color.new(color.gray, 50), style=plot.style_stepline)
plot(showLabels ? pdVwapFinal : na, "PD-VWAP (~POC)", color=color.new(color.yellow, 0), style=plot.style_stepline)

plot(showLabels ? onH_prev : na, "ONH", color=color.new(color.red,  30), style=plot.style_stepline)
plot(showLabels ? onL_prev : na, "ONL", color=color.new(color.lime, 30), style=plot.style_stepline)
plot(showLabels ? onM_prev : na, "ONM", color=color.new(color.white,50), style=plot.style_stepline)

// ===== TABLE =====
var table t = table.new(tblPos == "top_left" ? position.top_left :
                        tblPos == "top_right" ? position.top_right :
                        tblPos == "middle_right" ? position.middle_right :
                        tblPos == "bottom_left" ? position.bottom_left : position.bottom_right,
                        2, 22, border_width=1)
if showTable and barstate.islast
    r = 0
    _addrow(string k, string v) =>
        table.cell(t, 0, r, k, bgcolor=color.new(color.black, 80), text_color=color.white, text_size=size.small)
        table.cell(t, 1, r, v, bgcolor=color.new(color.gray,  80), text_color=color.white, text_size=size.small)
    _addrow("SYM", syminfo.ticker + " @ " + str.tostring(close, "#.##"))
    r += 1
    _addrow("ATR" + str.tostring(atrLen), str.tostring(atrv, "#.##"))
    r += 1
    _addrow("D-VWAP", str.tostring(dvw, "#.##"))
    r += 1
    _addrow("D +1σ / -1σ", str.tostring(dva_h, "#.##") + " / " + str.tostring(dva_l, "#.##"))
    r += 1
    _addrow("D +2σ / -2σ", str.tostring(dva_h2, "#.##") + " / " + str.tostring(dva_l2, "#.##"))
    r += 1
    _addrow("W-VWAP", str.tostring(wvw, "#.##"))
    r += 1
    _addrow("W +1σ / -1σ", str.tostring(wva_h, "#.##") + " / " + str.tostring(wva_l, "#.##"))
    r += 1
    _addrow("M-VWAP", str.tostring(mvw, "#.##"))
    r += 1
    _addrow("M +1σ / -1σ", str.tostring(mva_h, "#.##") + " / " + str.tostring(mva_l, "#.##"))
    r += 1
    _addrow("PD-VWAP (POC~)", str.tostring(pdVwapFinal, "#.##"))
    r += 1
    _addrow("PD-VA H / L", str.tostring(pdVA_H, "#.##") + " / " + str.tostring(pdVA_L, "#.##"))
    r += 1
    _addrow("PD O", str.tostring(pdOpen, "#.##"))
    r += 1
    _addrow("PD H", str.tostring(pdHigh, "#.##"))
    r += 1
    _addrow("PD L", str.tostring(pdLow, "#.##"))
    r += 1
    _addrow("PD C", str.tostring(pdClose, "#.##"))
    r += 1
    _addrow("PW H", str.tostring(pwHigh, "#.##"))
    r += 1
    _addrow("PW L", str.tostring(pwLow, "#.##"))
    r += 1
    _addrow("ONH", str.tostring(onH_prev, "#.##"))
    r += 1
    _addrow("ONL", str.tostring(onL_prev, "#.##"))
    r += 1
    _addrow("ONM", str.tostring(onM_prev, "#.##"))
    r += 1

// ===== LOG DUMP (kopirovatelny text pro agenta) =====
if barstate.islast
    txt = "=== OROCHI DUMP === " + syminfo.ticker + " @ " + str.tostring(close, "#.##") + "\n"
    txt := txt + "TIME_UTC: " + str.format_time(time, "yyyy-MM-dd HH:mm", "UTC") + "\n"
    txt := txt + "TF: " + timeframe.period + "\n"
    txt := txt + "ATR" + str.tostring(atrLen) + ": " + str.tostring(atrv, "#.##") + "\n"
    txt := txt + "\n-- DAILY VWAP (developing VA today) --\n"
    txt := txt + "D-VWAP: " + str.tostring(dvw, "#.##") + "\n"
    txt := txt + "D +1σ: " + str.tostring(dva_h, "#.##") + "\n"
    txt := txt + "D -1σ: " + str.tostring(dva_l, "#.##") + "\n"
    txt := txt + "D +2σ: " + str.tostring(dva_h2, "#.##") + "\n"
    txt := txt + "D -2σ: " + str.tostring(dva_l2, "#.##") + "\n"
    txt := txt + "\n-- WEEKLY VWAP --\n"
    txt := txt + "W-VWAP: " + str.tostring(wvw, "#.##") + "\n"
    txt := txt + "W +1σ: " + str.tostring(wva_h, "#.##") + "\n"
    txt := txt + "W -1σ: " + str.tostring(wva_l, "#.##") + "\n"
    txt := txt + "\n-- MONTHLY VWAP --\n"
    txt := txt + "M-VWAP: " + str.tostring(mvw, "#.##") + "\n"
    txt := txt + "M +1σ: " + str.tostring(mva_h, "#.##") + "\n"
    txt := txt + "M -1σ: " + str.tostring(mva_l, "#.##") + "\n"
    txt := txt + "\n-- PRIOR DAY (established VA) --\n"
    txt := txt + "PD-VWAP (POC~): " + str.tostring(pdVwapFinal, "#.##") + "\n"
    txt := txt + "PD-VA-H (POC+σ): " + str.tostring(pdVA_H, "#.##") + "\n"
    txt := txt + "PD-VA-L (POC-σ): " + str.tostring(pdVA_L, "#.##") + "\n"
    txt := txt + "PD-Open: "  + str.tostring(pdOpen, "#.##")  + "\n"
    txt := txt + "PD-High: "  + str.tostring(pdHigh, "#.##")  + "\n"
    txt := txt + "PD-Low: "   + str.tostring(pdLow, "#.##")   + "\n"
    txt := txt + "PD-Close: " + str.tostring(pdClose, "#.##") + "\n"
    txt := txt + "\n-- PRIOR WEEK --\n"
    txt := txt + "PW-High: " + str.tostring(pwHigh, "#.##") + "\n"
    txt := txt + "PW-Low: "  + str.tostring(pwLow, "#.##")  + "\n"
    txt := txt + "\n-- OVERNIGHT (18:00 ET -> 9:30 ET) --\n"
    txt := txt + "ONH: " + str.tostring(onH_prev, "#.##") + "\n"
    txt := txt + "ONL: " + str.tostring(onL_prev, "#.##") + "\n"
    txt := txt + "ONM: " + str.tostring(onM_prev, "#.##") + "\n"
    txt := txt + "\n=== END DUMP ==="
    log.info(txt)
