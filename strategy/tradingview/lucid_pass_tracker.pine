// @version=5
indicator("Lucid Flex 50K Pass Tracker", overlay=true, max_labels_count=50, max_lines_count=50, max_boxes_count=20)

// =========================================================================
// Pass tracker for Lucid Flex 50K ($2000 DD, $3000 target, 8-week plan).
// Auto-identifies phase, size, daily stop, today's setup priority.
// You only update "Current P&L from start" once a day — rest is automatic.
// =========================================================================

// --- INPUTS -----------------------------------------------------------
grpAcct   = "Account"
startYMD  = input.int(20261014, "Start date (YYYYMMDD)", group=grpAcct)
curPnl    = input.float(0.0, "Current P&L from start ($)", step=50.0, group=grpAcct, tooltip="Update daily after EOD")
targetUSD = input.float(3000.0, "Target profit ($)", step=100.0, group=grpAcct)
maxDDUSD  = input.float(2000.0, "Max DD ($)", step=100.0, group=grpAcct)
weeksTgt  = input.int(8, "Target weeks to pass", minval=2, maxval=16, group=grpAcct)
consist   = input.float(1500.0, "Consistency ceiling / day ($)", group=grpAcct)

grpPos    = "Dashboard"
showDash  = input.bool(true, "Show dashboard table", group=grpPos)
posStr    = input.string("top_right", "Position", options=["top_right","top_left","bottom_right","bottom_left","middle_right"], group=grpPos)

grpSig    = "Signals"
showMonFri = input.bool(true, "Draw Mon-LONG / Fri-SHORT levels", group=grpSig)
showEMA    = input.bool(true, "Plot 5m EMA12 (Mon/Fri reference)", group=grpSig)
showVWAP   = input.bool(true, "Draw VWAP + 20bps band", group=grpSig)
showVWAPsig= input.bool(true, "Draw VWAP Trend entry levels", group=grpSig)
emaLen     = input.int(12, "EMA for Mon/Fri trigger (on 5m)", group=grpSig)
tpPts      = input.float(40.0, "Mon/Fri TP points (if hit before EOD)", group=grpSig)
bandBps    = input.float(0.002, "VWAP band width (fraction)", step=0.0005, group=grpSig)
vwapSLpts  = input.float(75.0, "VWAP Trend SL points (optimum 75)", group=grpSig)

// --- PHASE LOGIC ------------------------------------------------------
phase    = curPnl < 400.0 ? 1 : curPnl < 1000.0 ? 2 : curPnl < 2000.0 ? 3 : 4
sizeStr  = phase == 1 ? "2 MNQ" : phase == 2 ? "3 MNQ" : "1 NQ"
dollarPt = phase == 1 ? 40.0 : phase == 2 ? 60.0 : 200.0
stopPts  = phase == 1 ? 7.0 : phase == 2 ? 7.0 : phase == 3 ? 6.0 : 5.0
riskUSD  = stopPts * dollarPt
dailyMax = phase == 1 ? 400.0 : phase == 2 ? 500.0 : phase == 3 ? 600.0 : 500.0
nextPhaseAt = phase == 1 ? 400.0 : phase == 2 ? 1000.0 : phase == 3 ? 2000.0 : targetUSD
nextSize    = phase == 1 ? "3 MNQ" : phase == 2 ? "1 NQ" : phase == 3 ? "1 NQ (tight)" : "DONE"

// --- TIMELINE ---------------------------------------------------------
startYr = math.floor(startYMD / 10000)
startMo = math.floor((startYMD % 10000) / 100)
startDy = startYMD % 100
startTs = timestamp(startYr, startMo, startDy, 0, 0)
nowTs = timenow
daysElapsed = math.max(0, math.floor((nowTs - startTs) / 86400000))
weeksElapsed = daysElapsed / 7.0
daysInPlan = weeksTgt * 7
daysLeft = math.max(1, daysInPlan - daysElapsed)
tradingDaysLeft = math.max(1, math.floor(daysLeft * 4.0 / 7.0))  // 4 trade days/week (skip Wed)
remainingUSD = math.max(0, targetUSD - curPnl)
reqPerDay = remainingUSD / tradingDaysLeft

// On-pace % — are we ahead or behind linear pace?
expectedByNow = daysElapsed > 0 ? (daysElapsed / math.max(daysInPlan, 1)) * targetUSD : 0
pacePct = expectedByNow > 0 ? (curPnl / expectedByNow) * 100.0 : 100.0

// --- DOW LOGIC --------------------------------------------------------
dowET = dayofweek(time, "America/New_York")
dowName = dowET == dayofweek.monday ? "MON" : dowET == dayofweek.tuesday ? "TUE" : dowET == dayofweek.wednesday ? "WED" : dowET == dayofweek.thursday ? "THU" : dowET == dayofweek.friday ? "FRI" : dowET == dayofweek.saturday ? "SAT" : "SUN"
isTradeDay = dowET == dayofweek.monday or dowET == dayofweek.tuesday or dowET == dayofweek.thursday or dowET == dayofweek.friday
todaySetup = dowET == dayofweek.monday ? "Mon-LONG @9:35 (+VWAP fallback)" : dowET == dayofweek.tuesday ? "VWAP Trend only" : dowET == dayofweek.wednesday ? "SKIP — rest day" : dowET == dayofweek.thursday ? "VWAP Trend only" : dowET == dayofweek.friday ? "Fri-SHORT @9:35 (+VWAP fallback)" : "Weekend"

// --- SESSION STATE ----------------------------------------------------
hET = hour(time, "America/New_York")
mET = minute(time, "America/New_York")
etMin = hET * 60 + mET
sessState = etMin < 570 ? "PRE-OPEN" : etMin < 575 ? "9:30-9:35 WATCH 1ST BAR" : etMin < 695 ? "OPEN WINDOW (edge)" : etMin < 955 ? "MID (VWAP only)" : etMin < 960 ? "CLOSE 5MIN!" : "CLOSED"
sessColor = etMin >= 955 and etMin < 960 ? color.red : etMin >= 570 and etMin < 695 ? color.new(color.green, 20) : etMin < 570 or etMin >= 960 ? color.new(color.gray, 50) : color.new(color.olive, 30)

// --- COLORS -----------------------------------------------------------
f_phaseCol(p) => p == 1 ? color.new(#4A90E2, 20) : p == 2 ? color.new(#9B59B6, 20) : p == 3 ? color.new(#E67E22, 20) : color.new(#27AE60, 20)
f_paceCol(p)  => p >= 100.0 ? color.new(color.green, 20) : p >= 70.0 ? color.new(color.olive, 20) : p >= 40.0 ? color.new(color.orange, 20) : color.new(color.red, 20)
f_pnlCol(v)   => v >= targetUSD ? color.new(color.green, 10) : v >= 0 ? color.new(color.navy, 30) : color.new(color.red, 20)

// --- DASHBOARD --------------------------------------------------------
tblPosV = posStr == "top_left" ? position.top_left : posStr == "bottom_right" ? position.bottom_right : posStr == "bottom_left" ? position.bottom_left : posStr == "middle_right" ? position.middle_right : position.top_right

var table dash = table.new(tblPosV, 2, 14, border_width=1, bgcolor=color.new(color.black, 30), border_color=color.new(color.gray, 50))

if barstate.islast and showDash
    // Header
    table.cell(dash, 0, 0, "LUCID 50K TRACKER", bgcolor=color.new(color.navy, 10), text_color=color.white, text_size=size.normal)
    table.cell(dash, 1, 0, dowName + "  " + str.format("{0,number,00}:{1,number,00}", hET, mET) + " ET", bgcolor=color.new(color.navy, 10), text_color=color.white)

    // Equity vs target
    equityPct = (curPnl / targetUSD) * 100.0
    table.cell(dash, 0, 1, "P&L", bgcolor=color.new(color.gray, 30), text_color=color.white)
    table.cell(dash, 1, 1, "$" + str.tostring(curPnl, "#") + " / $" + str.tostring(targetUSD, "#") + "  (" + str.tostring(equityPct, "#.#") + "%)", bgcolor=f_pnlCol(curPnl), text_color=color.white)

    // Phase + size
    table.cell(dash, 0, 2, "PHASE", bgcolor=color.new(color.gray, 30), text_color=color.white)
    table.cell(dash, 1, 2, "F" + str.tostring(phase) + "  →  " + sizeStr, bgcolor=f_phaseCol(phase), text_color=color.white)

    // Next phase trigger
    table.cell(dash, 0, 3, "Next→", bgcolor=color.new(color.gray, 30), text_color=color.white)
    table.cell(dash, 1, 3, "At $" + str.tostring(nextPhaseAt, "#") + " → " + nextSize, bgcolor=color.new(color.gray, 40), text_color=color.white)

    // Risk params
    table.cell(dash, 0, 4, "Risk/trade", bgcolor=color.new(color.gray, 30), text_color=color.white)
    table.cell(dash, 1, 4, "$" + str.tostring(riskUSD, "#") + " (" + str.tostring(stopPts, "#.#") + "pt stop)", text_color=color.white, bgcolor=color.new(color.black, 30))

    table.cell(dash, 0, 5, "Daily stop", bgcolor=color.new(color.gray, 30), text_color=color.white)
    table.cell(dash, 1, 5, "-$" + str.tostring(dailyMax, "#") + "  (warn: -$" + str.tostring(dailyMax/2, "#") + ")", bgcolor=color.new(color.maroon, 20), text_color=color.white)

    table.cell(dash, 0, 6, "Day cap", bgcolor=color.new(color.gray, 30), text_color=color.white)
    table.cell(dash, 1, 6, "+$" + str.tostring(consist, "#") + " (consistency)", text_color=color.white, bgcolor=color.new(color.black, 30))

    // Timeline
    table.cell(dash, 0, 7, "Week", bgcolor=color.new(color.gray, 30), text_color=color.white)
    table.cell(dash, 1, 7, str.tostring(weeksElapsed, "#.#") + " / " + str.tostring(weeksTgt) + "  (" + str.tostring(daysLeft) + " d left)", text_color=color.white, bgcolor=color.new(color.black, 30))

    table.cell(dash, 0, 8, "Need/day", bgcolor=color.new(color.gray, 30), text_color=color.white)
    needCol = reqPerDay > 500.0 ? color.new(color.red, 20) : reqPerDay > 250.0 ? color.new(color.orange, 20) : color.new(color.green, 20)
    table.cell(dash, 1, 8, "$" + str.tostring(reqPerDay, "#") + "/trading day", bgcolor=needCol, text_color=color.white)

    table.cell(dash, 0, 9, "Pace", bgcolor=color.new(color.gray, 30), text_color=color.white)
    table.cell(dash, 1, 9, str.tostring(pacePct, "#") + "% of linear plan", bgcolor=f_paceCol(pacePct), text_color=color.white)

    // Today
    table.cell(dash, 0, 10, "TODAY", bgcolor=color.new(color.purple, 10), text_color=color.white)
    todayCol = isTradeDay ? color.new(color.navy, 10) : color.new(color.gray, 30)
    table.cell(dash, 1, 10, todaySetup, bgcolor=todayCol, text_color=color.white)

    // Session
    table.cell(dash, 0, 11, "Session", bgcolor=color.new(color.gray, 30), text_color=color.white)
    table.cell(dash, 1, 11, sessState, bgcolor=sessColor, text_color=color.white)

    // Warnings — close pending
    if etMin >= 955 and etMin < 960 and isTradeDay
        table.cell(dash, 0, 12, "⚠", bgcolor=color.red, text_color=color.white)
        table.cell(dash, 1, 12, "FLAT ALL @ 15:55!", bgcolor=color.red, text_color=color.white)

    // Warning — Wed = skip
    if dowET == dayofweek.wednesday
        table.cell(dash, 0, 13, "✖", bgcolor=color.new(color.red, 30), text_color=color.white)
        table.cell(dash, 1, 13, "WEDNESDAY — NO TRADES", bgcolor=color.new(color.red, 30), text_color=color.white)

    // Warning — past 11:30 (open edge done)
    if etMin >= 695 and etMin < 955 and isTradeDay
        table.cell(dash, 0, 13, "ⓘ", bgcolor=color.new(color.orange, 40), text_color=color.white)
        table.cell(dash, 1, 13, "Past 11:30 — VWAP Trend only", bgcolor=color.new(color.orange, 40), text_color=color.white)

// =========================================================================
// SIGNAL DETECTION + ENTRY/SL/TP DRAWING
// =========================================================================

// --- SETUP 1: Mon-LONG / Fri-SHORT (first 5m RTH bar vs EMA12) --------
// Compute on 5m regardless of chart TF via request.security
f_firstRthBar() =>
    inRTH = not na(time(timeframe.period, "0930-1600", "America/New_York"))
    prevInRTH = nz(inRTH[1], false)
    firstBar = inRTH and not prevInRTH
    ema = ta.ema(close, emaLen)
    [firstBar, close, ema, low, high]

[isFirstRth_5m, close5m, ema5m, low5m, high5m] = request.security(syminfo.tickerid, "5", f_firstRthBar(), lookahead=barmerge.lookahead_off)

// Mon/Fri trigger
monLongFired = showMonFri and isFirstRth_5m and dowET == dayofweek.monday and close5m > ema5m
friShortFired = showMonFri and isFirstRth_5m and dowET == dayofweek.friday and close5m < ema5m

// Store latest trigger per day
var float trigPx = na
var float trigSL = na
var float trigTP = na
var string trigDir = na
var int trigBar = na
var int trigDayId = na
curDayId = year * 10000 + month * 100 + dayofmonth

if monLongFired and trigDayId != curDayId
    trigPx := close5m
    trigSL := low5m
    trigTP := close5m + tpPts
    trigDir := "LONG"
    trigBar := bar_index
    trigDayId := curDayId
if friShortFired and trigDayId != curDayId
    trigPx := close5m
    trigSL := high5m
    trigTP := close5m - tpPts
    trigDir := "SHORT"
    trigBar := bar_index
    trigDayId := curDayId

// Draw Mon/Fri setup lines + size/pnl labels
var line  monFriEntry = na
var line  monFriSL = na
var line  monFriTP = na
var label monFriLbl = na

if barstate.islast
    if not na(monFriEntry)
        line.delete(monFriEntry)
    if not na(monFriSL)
        line.delete(monFriSL)
    if not na(monFriTP)
        line.delete(monFriTP)
    if not na(monFriLbl)
        label.delete(monFriLbl)

    if showMonFri and not na(trigPx) and trigDayId == curDayId
        slDist = math.abs(trigPx - trigSL)
        tpDist = math.abs(trigTP - trigPx)
        riskD  = slDist * dollarPt
        rewardD = tpDist * dollarPt
        rr     = slDist > 0 ? tpDist / slDist : na
        dirCol = trigDir == "LONG" ? color.lime : color.red
        monFriEntry := line.new(trigBar, trigPx, bar_index + 30, trigPx, color=color.new(color.white, 0), width=2, extend=extend.right)
        monFriSL    := line.new(trigBar, trigSL, bar_index + 30, trigSL, color=color.new(color.red, 20), width=1, style=line.style_dashed, extend=extend.right)
        monFriTP    := line.new(trigBar, trigTP, bar_index + 30, trigTP, color=color.new(color.green, 20), width=1, style=line.style_dashed, extend=extend.right)
        lblTxt = trigDir + " @ " + str.tostring(trigPx, format.mintick) + "\n" + sizeStr + "  R:$" + str.tostring(riskD, "#") + "  T:$" + str.tostring(rewardD, "#") + "  RR " + str.tostring(rr, "#.#")
        monFriLbl   := label.new(bar_index + 5, trigPx, lblTxt, color=color.new(dirCol, 20), textcolor=color.white, style=label.style_label_left, size=size.small)

// --- SETUP 2: VWAP Trend v7 (session RTH VWAP + 20bps band) ----------
// Anchor the VWAP reset at 9:30 ET so it tracks the RTH session, not
// the symbol's ETH session (which could be 18:00 ET prior day).
rthFlag = not na(time(timeframe.period, "0930-1600", "America/New_York"))
rthStart = rthFlag and not nz(rthFlag[1], false)
vwapVal = ta.vwap(hlc3, rthStart)
// Only plot/use VWAP during RTH; outside session it's irrelevant
vwapShow = rthFlag ? vwapVal : na
upperBand = vwapShow * (1.0 + bandBps)
lowerBand = vwapShow * (1.0 - bandBps)

// EMA12 (5m) reference — the trigger EMA for Mon-LONG/Fri-SHORT
plot(showEMA ? ema5m : na, "EMA12 (5m)", color=color.new(color.yellow, 30), linewidth=2)
plot(showVWAP ? vwapShow : na, "VWAP (RTH)", color=color.new(color.aqua, 20), linewidth=1)
plot(showVWAP ? upperBand : na, "VWAP upper", color=color.new(color.orange, 60))
plot(showVWAP ? lowerBand : na, "VWAP lower", color=color.new(color.orange, 60))

// VWAP Trend fire: close breaks outside band after 9:31 ET, only if gates pass
// Simplified gates: just check we're in session, no gap-size calc here
// (full gap+trend gate requires 250-day daily history — assume you check manually)
// VWAP Trend is FALLBACK — only activates if primary Mon/Fri setup
// didn't fire today. On Tue/Thu it's always primary.
monFriFiredToday = trigDayId == curDayId and not na(trigPx)
vwapAllowed = isTradeDay and dowET != dayofweek.wednesday and not monFriFiredToday
vwapLongFire  = showVWAPsig and vwapAllowed and etMin >= 571 and etMin < 955 and rthFlag and ta.crossover(close, upperBand)
vwapShortFire = showVWAPsig and vwapAllowed and etMin >= 571 and etMin < 955 and rthFlag and ta.crossunder(close, lowerBand)

var float vwapTrigPx = na
var float vwapTrigSL = na
var string vwapTrigDir = na
var int vwapTrigBar = na
var int vwapTrigDayId = na

if vwapLongFire and vwapTrigDayId != curDayId
    vwapTrigPx := close
    vwapTrigSL := close - vwapSLpts
    vwapTrigDir := "LONG"
    vwapTrigBar := bar_index
    vwapTrigDayId := curDayId
if vwapShortFire and vwapTrigDayId != curDayId
    vwapTrigPx := close
    vwapTrigSL := close + vwapSLpts
    vwapTrigDir := "SHORT"
    vwapTrigBar := bar_index
    vwapTrigDayId := curDayId

var line  vwapEntry = na
var line  vwapSL    = na
var label vwapLbl   = na

if barstate.islast
    if not na(vwapEntry)
        line.delete(vwapEntry)
    if not na(vwapSL)
        line.delete(vwapSL)
    if not na(vwapLbl)
        label.delete(vwapLbl)

    if showVWAPsig and not na(vwapTrigPx) and vwapTrigDayId == curDayId
        slDistV = math.abs(vwapTrigPx - vwapTrigSL)
        riskDV  = slDistV * dollarPt
        dirColV = vwapTrigDir == "LONG" ? color.lime : color.red
        vwapEntry := line.new(vwapTrigBar, vwapTrigPx, bar_index + 20, vwapTrigPx, color=color.new(color.yellow, 0), width=2, extend=extend.right)
        vwapSL    := line.new(vwapTrigBar, vwapTrigSL, bar_index + 20, vwapTrigSL, color=color.new(color.red, 20), width=1, style=line.style_dashed, extend=extend.right)
        lblTxtV = "VWAP-" + vwapTrigDir + " @ " + str.tostring(vwapTrigPx, format.mintick) + "\n" + sizeStr + "  R:$" + str.tostring(riskDV, "#") + "  Exit: band flip or EOD"
        vwapLbl   := label.new(bar_index + 5, vwapTrigPx, lblTxtV, color=color.new(dirColV, 30), textcolor=color.white, style=label.style_label_left, size=size.small)
