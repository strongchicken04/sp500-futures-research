// @version=5
indicator("Lucid 16 — Vault Break / ORB switch", overlay=true, max_labels_count=500, max_lines_count=500)

// =========================================================================
// ONE INDICATOR, TWO STRATEGIES (owner 2026-11-16). The only input is the switch.
//   VAULT BREAK  (use a 30-MINUTE NQ / MNQ chart) - the eval strategy
//     Level = price at midnight CT + 0.30 x ATR15 (mean high-low of the last 15
//     sessions 00:00-17:00 CT); VWAP anchored at midnight CT. From the 10:00 CT
//     candle: a 30-min candle CLOSES above the level AND the VWAP -> LONG at that
//     close, TP 40 pt / SL 75 pt, flat 14:30 CT, first signal of the day only.
//   ORB = OVERNIGHT BIAS ORB  (use a 15-MINUTE NQ / MNQ chart) - the funded strategy
//     Overnight range 23:00-08:30 CT in thirds; the 08:30 CT open in the top third
//     -> long only, bottom third -> short only, middle -> no trade. OR = the
//     08:30-08:45 CT candle. A 15-min candle after 08:45 CT that CLOSES above the
//     OR high (long day) / below the OR low (short day) with ADX(14) >= 20 ->
//     entry at that close. SL = 0.30 x SMA15 of the daily ATR(14), TP = 3 x SL,
//     flat 14:30 CT, one trade a day.
// Backtests: strategy/quantconnect/inqc/vault_break_inqc.py, onorb_v3_inqc.py;
//   plan (brain/registry.md): eval Vault 6 MNQ, funded ORB 1-2 MNQ, full $1,000 payouts.
// Intrabar order: if TP and SL are both inside one bar, the SL is assumed first.
// v2 (owner 2026-11-16): status table removed; ADX of the current candle shown next to it.
// v3 (owner 2026-11-17): ORB - the third where NY opened lights up (top green, middle yellow, bottom red).
// v4 (owner 2026-11-18): ORB - the overnight range and thirds are drawn live from 23:00 CT; the
//   highlight only appears once the session opens (08:30 CT).
// v5 (owner 2026-11-23): third mode VWAP BAND ORB (use a 5-MINUTE chart) - VWAP from 08:30 CT (09:30 ET)
//   with +-20 bps bands, OR 08:30-08:45 CT; a 5-min close above the OR high AND VWAP + 20 bps -> LONG,
//   below the OR low AND VWAP - 20 bps -> SHORT, first signal of the day, TP = 0.625 x SL, SL = input %
//   of price (default 0.40% = the best in-sample SL), flat 14:55 CT. BACKTEST: NO EDGE (win rate = the
//   61.5% random-walk break-even; vwap_band_orb_inqc.py) - for viewing only.
// v6 (owner 2026-11-23): VWAP Band ORB band width is an input, default 50 bps (the best band in v2:
//   131 signals / yr, all eras positive, +$71 / trade at SL 0.40%, t 1.9 - still a weak edge).
// v7 (owner 2026-11-24): daily SMA line (default 300, works on any chart timeframe - e.g. weekly ETF charts)
//   with a label of the distance in %; new mode "SMA only (investing)" hides all trading signals.
//   Investing plan: hold while the DAILY close is above the SMA (slow_trend_lines_inqc.py: SMA300 slightly
//   better than SMA200 on SPY / ACWI / GLD / BTC, fewer exits).
// =========================================================================

mode = input.string("Vault Break", "Strategy", options = ["Vault Break", "ORB", "VWAP Band ORB", "SMA only (investing)"])
showSma = input.bool(true, "Show daily SMA (investing rule)")
smaLen = input.int(300, "Daily SMA length", minval = 2)
bandBps = input.float(50.0, "VWAP Band ORB: band (bps from VWAP)", step = 5.0)
slPct = input.float(0.40, "VWAP Band ORB: SL % of price (TP = 0.625 x SL)", step = 0.05)
isV = mode == "Vault Break"
isO = mode == "ORB"
isB = mode == "VWAP Band ORB"
isS = mode == "SMA only (investing)"

TZ = "America/Chicago"
tCT = hour(time, TZ) * 60 + minute(time, TZ)        // bar OPEN time, CT minutes
newDay = dayofmonth(time, TZ) != dayofmonth(time[1], TZ)
tfOk = isS ? false : isV ? timeframe.period == "30" : isO ? timeframe.period == "15" : timeframe.period == "5"

// ------------------------------------------------------------------ VAULT data
var float[] ranges = array.new_float()
var float sHi = na
var float sLo = na
var float mid = na
var float pv = 0.0
var float vv = 0.0
if newDay
    if not na(sHi)
        array.push(ranges, sHi - sLo)
        if array.size(ranges) > 15
            array.shift(ranges)
    sHi := high
    sLo := low
    mid := open
    pv := 0.0
    vv := 0.0
else if tCT < 17 * 60
    sHi := math.max(nz(sHi, high), high)
    sLo := math.min(nz(sLo, low), low)
pv += hlc3 * volume
vv += volume
vwapMid = vv > 0 ? pv / vv : close
atr15 = array.size(ranges) == 15 ? array.avg(ranges) : na
level = not na(mid) and not na(atr15) ? mid + 0.30 * atr15 : na

// ------------------------------------------------------------------ ORB data
[diP, diM, adx] = ta.dmi(14, 14)
atrMA = request.security(syminfo.tickerid, "D", ta.sma(ta.atr(14), 15)[1], lookahead = barmerge.lookahead_on)
var float onH = na
var float onL = na
var float rH = na          // overnight range frozen at 08:30 CT
var float rL = na
var float orH = na
var float orL = na
var int bias = 0
var int zone = na          // third of the NY open: 1 top, 0 middle, -1 bottom
if tCT == 23 * 60
    onH := high
    onL := low
    rH := na
    rL := na
    orH := na
    orL := na
    bias := 0
    zone := na
else if (tCT > 23 * 60 or tCT < 8 * 60 + 30) and not na(onH)
    onH := math.max(onH, high)
    onL := math.min(onL, low)
if tCT == 8 * 60 + 30 and not na(onH)
    rH := onH
    rL := onL
    q = rH > rL ? (open - rL) / (rH - rL) : 0.5
    bias := q >= 2.0 / 3.0 ? 1 : q <= 1.0 / 3.0 ? -1 : 0
    zone := bias
    orH := high
    orL := low

// ------------------------------------------------------------------ VWAP BAND ORB data
var float bpv = 0.0
var float bvv = 0.0
var float bOrH = na
var float bOrL = na
if tCT == 8 * 60 + 30
    bpv := 0.0
    bvv := 0.0
    bOrH := high
    bOrL := low
else if tCT > 8 * 60 + 30 and tCT < 8 * 60 + 45 and not na(bOrH)
    bOrH := math.max(bOrH, high)
    bOrL := math.min(bOrL, low)
bpv += hlc3 * volume
bvv += volume
bVwap = bvv > 0 ? bpv / bvv : close
bUp = bVwap * (1 + bandBps / 10000.0)
bDn = bVwap * (1 - bandBps / 10000.0)

// ------------------------------------------------------------------ trade state
var float ePx = na
var float tp = na
var float sl = na
var int dir = 0
var int eBar = na
var bool doneToday = false
var line lTp = na
var line lSl = na
var line lE = na
var int nTr = 0
var int nWin = 0
var float sumPts = 0.0

// a new trading day for the "one trade a day" rule
if (isV and newDay) or (isO and tCT == 23 * 60) or (isB and tCT == 8 * 60 + 30)
    doneToday := false

closeTrade(px, why) =>
    pts = (px - ePx) * dir
    label.new(bar_index, why == "SL" ? (dir == 1 ? low : high) : (dir == 1 ? high : low), why + "\n" + (pts >= 0 ? "+" : "") + str.tostring(pts, "#.##") + " pt",
              color = pts >= 0 ? color.new(color.green, 15) : color.new(color.red, 15), textcolor = color.white,
              style = (why == "SL") == (dir == 1) ? label.style_label_up : label.style_label_down, size = size.small)
    pts

// exits from the bar after the entry
if not na(ePx) and bar_index > eBar
    exitPx = float(na)
    why = ""
    if dir == 1
        if low <= sl
            exitPx := math.min(sl, open)
            why := "SL"
        else if high >= tp
            exitPx := math.max(tp, open)
            why := "TP"
    else
        if high >= sl
            exitPx := math.max(sl, open)
            why := "SL"
        else if low <= tp
            exitPx := math.min(tp, open)
            why := "TP"
    // the candle that closes at 14:30 CT (VWAP Band ORB: 14:55 CT): flat at its close
    if na(exitPx) and ((isV and tCT == 14 * 60) or (isO and tCT == 14 * 60 + 15) or (isB and tCT == 14 * 60 + 50))
        exitPx := close
        why := isB ? "14:55" : "14:30"
    if not na(exitPx)
        p = closeTrade(exitPx, why)
        nTr += 1
        nWin += p > 0 ? 1 : 0
        sumPts += p
        line.set_x2(lTp, bar_index)
        line.set_x2(lSl, bar_index)
        line.set_x2(lE, bar_index)
        ePx := na
        dir := 0

// entries on a confirmed candle of the right timeframe
goDir = 0
sld = float(na)
tpd = float(na)
if tfOk and na(ePx) and not doneToday and barstate.isconfirmed
    if isV
        if tCT >= 10 * 60 and tCT <= 13 * 60 + 30 and not na(level) and close > level and close > vwapMid
            goDir := 1
            sld := 75.0
            tpd := 40.0
    else if isB
        if tCT >= 8 * 60 + 45 and tCT <= 13 * 60 + 55 and not na(bOrH)
            if close > bOrH and close > bUp
                goDir := 1
            else if close < bOrL and close < bDn
                goDir := -1
            sld := close * slPct / 100.0
            tpd := 0.625 * sld
    else
        if tCT >= 8 * 60 + 45 and tCT <= 14 * 60 and bias != 0 and not na(orH) and not na(atrMA) and adx >= 20
            if bias == 1 and close > orH
                goDir := 1
            else if bias == -1 and close < orL
                goDir := -1
            sld := 0.30 * atrMA
            tpd := 3.0 * sld
if goDir != 0
    dir := goDir
    ePx := close
    tp := close + dir * tpd
    sl := close - dir * sld
    eBar := bar_index
    doneToday := true
    label.new(bar_index, dir == 1 ? low : high, (dir == 1 ? "LONG" : "SHORT") + "\nTP " + str.tostring(tp, format.mintick) + "\nSL " + str.tostring(sl, format.mintick),
              color = dir == 1 ? color.new(color.teal, 0) : color.new(color.purple, 0), textcolor = color.white,
              style = dir == 1 ? label.style_label_up : label.style_label_down, size = size.small)
    lTp := line.new(bar_index, tp, bar_index + 1, tp, color = color.new(color.green, 0), width = 2)
    lSl := line.new(bar_index, sl, bar_index + 1, sl, color = color.new(color.red, 0), width = 2)
    lE := line.new(bar_index, ePx, bar_index + 1, ePx, color = color.new(color.gray, 0), style = line.style_dotted)

// keep the open trade's lines running to the current bar
if not na(ePx)
    line.set_x2(lTp, bar_index)
    line.set_x2(lSl, bar_index)
    line.set_x2(lE, bar_index)

// ------------------------------------------------------------------ plots
inDay = tCT >= 8 * 60 + 30 and tCT < 14 * 60 + 30
plot(isV ? level : na, "Vault level", color = color.new(color.orange, 0), linewidth = 2, style = plot.style_linebr)
plot(isV ? vwapMid : na, "VWAP (midnight CT)", color = color.new(color.blue, 0), linewidth = 2, style = plot.style_linebr)
// overnight range + thirds: live while the range builds (23:00-08:30 CT), frozen 08:30-14:30 CT
building = tCT >= 23 * 60 or tCT < 8 * 60 + 30
float dH = not isO ? na : building ? onH : inDay ? rH : na
float dL = not isO ? na : building ? onL : inDay ? rL : na
plot(dH, "Overnight high", color = color.new(color.gray, 0), style = plot.style_linebr)
plot(dL, "Overnight low", color = color.new(color.gray, 0), style = plot.style_linebr)
plot(not na(dH) ? dL + (dH - dL) * 2.0 / 3.0 : na, "Top third", color = color.new(color.green, 40), style = plot.style_linebr)
plot(not na(dH) ? dL + (dH - dL) / 3.0 : na, "Bottom third", color = color.new(color.red, 40), style = plot.style_linebr)
plot(isO and inDay ? orH : na, "OR high", color = color.new(color.orange, 0), linewidth = 2, style = plot.style_linebr)
plot(isO and inDay ? orL : na, "OR low", color = color.new(color.orange, 0), linewidth = 2, style = plot.style_linebr)
bDay = tCT >= 8 * 60 + 30 and tCT < 15 * 60
plot(isB and bDay ? bVwap : na, "VWAP (08:30 CT)", color = color.new(color.blue, 0), linewidth = 2, style = plot.style_linebr)
plot(isB and bDay ? bUp : na, "VWAP + band", color = color.new(color.green, 20), style = plot.style_linebr)
plot(isB and bDay ? bDn : na, "VWAP - band", color = color.new(color.red, 20), style = plot.style_linebr)
plot(isB and bDay and tCT >= 8 * 60 + 45 ? bOrH : na, "OR 08:30-08:45 high", color = color.new(color.orange, 0), linewidth = 2, style = plot.style_linebr)
plot(isB and bDay and tCT >= 8 * 60 + 45 ? bOrL : na, "OR 08:30-08:45 low", color = color.new(color.orange, 0), linewidth = 2, style = plot.style_linebr)
plot(not na(ePx) ? tp : na, "Open trade TP", color = color.new(color.green, 0), style = plot.style_linebr)
plot(not na(ePx) ? sl : na, "Open trade SL", color = color.new(color.red, 0), style = plot.style_linebr)
// the third where NY opened lights up: top green, middle yellow, bottom red
up3 = rL + (rH - rL) * 2.0 / 3.0
lo3 = rL + (rH - rL) / 3.0
showZ = isO and inDay and not na(rH) and not na(zone)
pZt = plot(showZ ? (zone == 1 ? rH : zone == 0 ? up3 : lo3) : na, "NY third top", color = color.new(color.white, 100), style = plot.style_linebr, editable = false)
pZb = plot(showZ ? (zone == 1 ? up3 : zone == 0 ? lo3 : rL) : na, "NY third bottom", color = color.new(color.white, 100), style = plot.style_linebr, editable = false)
fill(pZt, pZb, color = zone == 1 ? color.new(color.green, 70) : zone == 0 ? color.new(color.yellow, 70) : color.new(color.red, 70), title = "NY open third")
bgcolor(isV and tCT >= 10 * 60 and tCT < 14 * 60 + 30 ? color.new(color.blue, 94) : na, title = "Vault window 10:00-14:30 CT")
bgcolor(isO and inDay ? (bias == 1 ? color.new(color.green, 94) : bias == -1 ? color.new(color.red, 94) : color.new(color.gray, 95)) : na, title = "ORB day bias")

// ------------------------------------------------------------------ ADX of the current candle
// a label next to the last candle (green when >= 20) + the value in the status line / data window
plot(isS ? na : adx, "ADX", color = adx >= 20 ? color.green : color.gray, display = display.status_line + display.data_window)
var label adxLbl = na
if barstate.islast and not isS
    label.delete(adxLbl)
    adxLbl := label.new(bar_index + 1, close, "ADX " + str.tostring(adx, "#.#"), style = label.style_label_left,
                          color = adx >= 20 ? color.new(color.green, 10) : color.new(color.gray, 10), textcolor = color.white, size = size.normal)

// ------------------------------------------------------------------ daily SMA (investing rule)
smaD = request.security(syminfo.tickerid, "D", ta.sma(close, smaLen))
plot(showSma ? smaD : na, "Daily SMA", color = color.new(color.fuchsia, 0), linewidth = 2)
var label smaLbl = na
if barstate.islast and showSma and not na(smaD)
    label.delete(smaLbl)
    dPct = (close / smaD - 1) * 100
    smaLbl := label.new(bar_index + 1, smaD, "SMA" + str.tostring(smaLen) + " " + (dPct >= 0 ? "+" : "") + str.tostring(dPct, "#.0") + " %",
                          style = label.style_label_left, color = dPct >= 0 ? color.new(color.green, 10) : color.new(color.red, 10),
                          textcolor = color.white, size = size.normal)
