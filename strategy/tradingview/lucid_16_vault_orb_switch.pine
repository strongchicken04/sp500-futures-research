// @version=5
indicator("Lucid 16 — Vault Break / ORB switch", overlay=true, max_labels_count=500, max_lines_count=500)

// =========================================================================
// ONE INDICATOR, TWO STRATEGIES (owner 2026-11-16). The only input is the switch.
//   VAULT BREAK  (use a 30-MINUTE NQ / MNQ chart) - the eval strategy
//     Level = price at midnight CT + 0.30 x ATR15 (mean high-low of the last 15
//     sessions 00:00-17:00 CT); VWAP anchored at midnight CT. From the 10:00 CT
//     candle: a 30-min candle CLOSES above the level AND the VWAP -> LONG at that
//     close, TP 40 pt / SL 75 pt, flat 14:30 CT, first signal of the day only.
//   ORB = OVERNIGHT BIAS ORB  (use a 15-MINUTE NQ / MNQ chart) - the funded strategy
//     Overnight range 23:00-08:30 CT in thirds; the 08:30 CT open in the top third
//     -> long only, bottom third -> short only, middle -> no trade. OR = the
//     08:30-08:45 CT candle. A 15-min candle after 08:45 CT that CLOSES above the
//     OR high (long day) / below the OR low (short day) with ADX(14) >= 20 ->
//     entry at that close. SL = 0.30 x SMA15 of the daily ATR(14), TP = 3 x SL,
//     flat 14:30 CT, one trade a day.
// Backtests: strategy/quantconnect/inqc/vault_break_inqc.py, onorb_v3_inqc.py;
//   plan (brain/registry.md): eval Vault 6 MNQ, funded ORB 1-2 MNQ, full $1,000 payouts.
// Intrabar order: if TP and SL are both inside one bar, the SL is assumed first.
// =========================================================================

mode = input.string("Vault Break", "Strategy", options = ["Vault Break", "ORB"])
isV = mode == "Vault Break"

TZ = "America/Chicago"
tCT = hour(time, TZ) * 60 + minute(time, TZ)        // bar OPEN time, CT minutes
newDay = dayofmonth(time, TZ) != dayofmonth(time[1], TZ)
tfOk = isV ? timeframe.period == "30" : timeframe.period == "15"

// ------------------------------------------------------------------ VAULT data
var float[] ranges = array.new_float()
var float sHi = na
var float sLo = na
var float mid = na
var float pv = 0.0
var float vv = 0.0
if newDay
    if not na(sHi)
        array.push(ranges, sHi - sLo)
        if array.size(ranges) > 15
            array.shift(ranges)
    sHi := high
    sLo := low
    mid := open
    pv := 0.0
    vv := 0.0
else if tCT < 17 * 60
    sHi := math.max(nz(sHi, high), high)
    sLo := math.min(nz(sLo, low), low)
pv += hlc3 * volume
vv += volume
vwapMid = vv > 0 ? pv / vv : close
atr15 = array.size(ranges) == 15 ? array.avg(ranges) : na
level = not na(mid) and not na(atr15) ? mid + 0.30 * atr15 : na

// ------------------------------------------------------------------ ORB data
[diP, diM, adx] = ta.dmi(14, 14)
atrMA = request.security(syminfo.tickerid, "D", ta.sma(ta.atr(14), 15)[1], lookahead = barmerge.lookahead_on)
var float onH = na
var float onL = na
var float rH = na          // overnight range frozen at 08:30 CT
var float rL = na
var float orH = na
var float orL = na
var int bias = 0
if tCT == 23 * 60
    onH := high
    onL := low
    rH := na
    rL := na
    orH := na
    orL := na
    bias := 0
else if (tCT > 23 * 60 or tCT < 8 * 60 + 30) and not na(onH)
    onH := math.max(onH, high)
    onL := math.min(onL, low)
if tCT == 8 * 60 + 30 and not na(onH)
    rH := onH
    rL := onL
    q = rH > rL ? (open - rL) / (rH - rL) : 0.5
    bias := q >= 2.0 / 3.0 ? 1 : q <= 1.0 / 3.0 ? -1 : 0
    orH := high
    orL := low

// ------------------------------------------------------------------ trade state
var float ePx = na
var float tp = na
var float sl = na
var int dir = 0
var int eBar = na
var bool doneToday = false
var line lTp = na
var line lSl = na
var line lE = na
var int nTr = 0
var int nWin = 0
var float sumPts = 0.0

// a new trading day for the "one trade a day" rule
if (isV and newDay) or (not isV and tCT == 23 * 60)
    doneToday := false

closeTrade(px, why) =>
    pts = (px - ePx) * dir
    label.new(bar_index, why == "SL" ? (dir == 1 ? low : high) : (dir == 1 ? high : low), why + "\n" + (pts >= 0 ? "+" : "") + str.tostring(pts, "#.##") + " pt",
              color = pts >= 0 ? color.new(color.green, 15) : color.new(color.red, 15), textcolor = color.white,
              style = (why == "SL") == (dir == 1) ? label.style_label_up : label.style_label_down, size = size.small)
    pts

// exits from the bar after the entry
if not na(ePx) and bar_index > eBar
    exitPx = float(na)
    why = ""
    if dir == 1
        if low <= sl
            exitPx := math.min(sl, open)
            why := "SL"
        else if high >= tp
            exitPx := math.max(tp, open)
            why := "TP"
    else
        if high >= sl
            exitPx := math.max(sl, open)
            why := "SL"
        else if low <= tp
            exitPx := math.min(tp, open)
            why := "TP"
    // the candle that closes at 14:30 CT: flat at its close
    if na(exitPx) and ((isV and tCT == 14 * 60) or (not isV and tCT == 14 * 60 + 15))
        exitPx := close
        why := "14:30"
    if not na(exitPx)
        p = closeTrade(exitPx, why)
        nTr += 1
        nWin += p > 0 ? 1 : 0
        sumPts += p
        line.set_x2(lTp, bar_index)
        line.set_x2(lSl, bar_index)
        line.set_x2(lE, bar_index)
        ePx := na
        dir := 0

// entries on a confirmed candle of the right timeframe
goDir = 0
sld = float(na)
tpd = float(na)
if tfOk and na(ePx) and not doneToday and barstate.isconfirmed
    if isV
        if tCT >= 10 * 60 and tCT <= 13 * 60 + 30 and not na(level) and close > level and close > vwapMid
            goDir := 1
            sld := 75.0
            tpd := 40.0
    else
        if tCT >= 8 * 60 + 45 and tCT <= 14 * 60 and bias != 0 and not na(orH) and not na(atrMA) and adx >= 20
            if bias == 1 and close > orH
                goDir := 1
            else if bias == -1 and close < orL
                goDir := -1
            sld := 0.30 * atrMA
            tpd := 3.0 * sld
if goDir != 0
    dir := goDir
    ePx := close
    tp := close + dir * tpd
    sl := close - dir * sld
    eBar := bar_index
    doneToday := true
    label.new(bar_index, dir == 1 ? low : high, (dir == 1 ? "LONG" : "SHORT") + "\nTP " + str.tostring(tp, format.mintick) + "\nSL " + str.tostring(sl, format.mintick),
              color = dir == 1 ? color.new(color.teal, 0) : color.new(color.purple, 0), textcolor = color.white,
              style = dir == 1 ? label.style_label_up : label.style_label_down, size = size.small)
    lTp := line.new(bar_index, tp, bar_index + 1, tp, color = color.new(color.green, 0), width = 2)
    lSl := line.new(bar_index, sl, bar_index + 1, sl, color = color.new(color.red, 0), width = 2)
    lE := line.new(bar_index, ePx, bar_index + 1, ePx, color = color.new(color.gray, 0), style = line.style_dotted)

// keep the open trade's lines running to the current bar
if not na(ePx)
    line.set_x2(lTp, bar_index)
    line.set_x2(lSl, bar_index)
    line.set_x2(lE, bar_index)

// ------------------------------------------------------------------ plots
inDay = tCT >= 8 * 60 + 30 and tCT < 14 * 60 + 30
plot(isV ? level : na, "Vault level", color = color.new(color.orange, 0), linewidth = 2, style = plot.style_linebr)
plot(isV ? vwapMid : na, "VWAP (midnight CT)", color = color.new(color.blue, 0), linewidth = 2, style = plot.style_linebr)
plot(not isV and inDay ? rH : na, "Overnight high", color = color.new(color.gray, 0), style = plot.style_linebr)
plot(not isV and inDay ? rL : na, "Overnight low", color = color.new(color.gray, 0), style = plot.style_linebr)
plot(not isV and inDay and not na(rH) ? rL + (rH - rL) * 2.0 / 3.0 : na, "Top third", color = color.new(color.green, 40), style = plot.style_linebr)
plot(not isV and inDay and not na(rH) ? rL + (rH - rL) / 3.0 : na, "Bottom third", color = color.new(color.red, 40), style = plot.style_linebr)
plot(not isV and inDay ? orH : na, "OR high", color = color.new(color.orange, 0), linewidth = 2, style = plot.style_linebr)
plot(not isV and inDay ? orL : na, "OR low", color = color.new(color.orange, 0), linewidth = 2, style = plot.style_linebr)
plot(not na(ePx) ? tp : na, "Open trade TP", color = color.new(color.green, 0), style = plot.style_linebr)
plot(not na(ePx) ? sl : na, "Open trade SL", color = color.new(color.red, 0), style = plot.style_linebr)
bgcolor(isV and tCT >= 10 * 60 and tCT < 14 * 60 + 30 ? color.new(color.blue, 94) : na, title = "Vault window 10:00-14:30 CT")
bgcolor(not isV and inDay ? (bias == 1 ? color.new(color.green, 94) : bias == -1 ? color.new(color.red, 94) : color.new(color.gray, 95)) : na, title = "ORB day bias")

// ------------------------------------------------------------------ table
var table tb = table.new(position.top_right, 1, 4, border_width = 1, bgcolor = color.new(color.black, 30))
if barstate.islast
    title = isV ? "LUCID 16 · VAULT BREAK" : "LUCID 16 · ORB"
    info = isV ? "level " + str.tostring(level, format.mintick) + " | VWAP " + str.tostring(vwapMid, format.mintick) + " | ATR15 " + str.tostring(atr15, "#.#")
               : "bias " + (bias == 1 ? "LONG only" : bias == -1 ? "SHORT only" : "none") + " | OR " + str.tostring(orL, format.mintick) + "-" + str.tostring(orH, format.mintick) + " | ADX " + str.tostring(adx, "#.#") + " | SL " + str.tostring(0.30 * atrMA, "#.#") + " pt"
    st = not tfOk ? (isV ? "use a 30-MINUTE chart" : "use a 15-MINUTE chart")
         : not na(ePx) ? (dir == 1 ? "LONG " : "SHORT ") + str.tostring(ePx, format.mintick) + " | TP " + str.tostring(tp, format.mintick) + " | SL " + str.tostring(sl, format.mintick)
         : doneToday ? "done for today"
         : isV ? "waiting for a 30m close above level + VWAP"
         : bias == 0 ? "no trade today (middle third) or waiting for 08:30 CT"
         : "waiting for a 15m close beyond the OR with ADX >= 20"
    table.cell(tb, 0, 0, title, text_color = color.white, bgcolor = isV ? color.new(color.orange, 30) : color.new(color.teal, 30))
    table.cell(tb, 0, 1, info, text_color = color.white)
    table.cell(tb, 0, 2, st, text_color = color.white, bgcolor = not na(ePx) ? color.new(color.teal, 20) : color.new(color.gray, 50))
    table.cell(tb, 0, 3, "history: " + str.tostring(nTr) + " trades, win " + (nTr > 0 ? str.tostring(nWin * 100.0 / nTr, "#") : "-") + "%, " + str.tostring(sumPts, "#") + " pt", text_color = color.white)
