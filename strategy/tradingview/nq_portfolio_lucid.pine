//@version=5
// =====================================================================
// NQ PORTFOLIO — VWAP TP100/SL75 + ON Fade + HAR-RV Breakout
// Live cockpit for the Lucid Flex 50k evaluation.
//
// Backtested NQ 2018-2025 (QuantConnect, real futures data, 1-min,
// close-based, 0.75 pts cost per trade):
//   VWAP TP100/SL75  n=940   avg +8.11 pts  z=+3.29
//   ON fade B=15     n=4004  avg +2.50 pts  z=+10.87  (best)
//   HAR-RV breakout  n=1581  avg +10.08 pts z=+3.10
//   Pairwise correlations all |rho| < 0.2 -> full diversification
//   Portfolio total +33584 pts, MDD -1529 pts, Return/MDD = 22:1
//
// REQUIRES A 1-MINUTE CHART on NQ/MNQ futures. Entry-window timing is
// mapped bar-for-bar to the backtest; other timeframes shift it.
// =====================================================================
indicator("NQ Portfolio — VWAP + ON Fade + HAR-RV", overlay=true,
     max_labels_count=100)

// ============================== INPUTS ==============================
gA = "Account / risk sizing"
instr        = input.string("MNQ", "Instrument", options = ["MNQ", "NQ"], group = gA)
riskPerTrade = input.float(200.0, "Risk per trade ($)",  minval = 10,  step = 10, group = gA)
maxDayRisk   = input.float(800.0, "Max daily risk ($)",  minval = 50,  step = 50, group = gA)
allowMinOne  = input.bool(false,  "Allow 1 contract even if over budget", group = gA)

gP = "Pass plan (Lucid Flex 50k)"
targetUSD   = input.float(3000.0, "Profit target ($)",   step = 100, group = gP)
profitSoFar = input.float(0.0,    "Profit so far ($)",   step = 50,  group = gP)
daysTarget  = input.int(7,        "Target days to pass", minval = 1, group = gP)
daysUsed    = input.int(0,        "Trading days used",   minval = 0, group = gP)

gS = "Strategies on/off"
useVWAP = input.bool(true, "1) VWAP band  TP100 / SL75", group = gS)
useON   = input.bool(true, "2) ON fade  ONH / ONL / ONM", group = gS)
useHAR  = input.bool(true, "3) HAR-RV breakout",          group = gS)

gV = "VWAP settings"
bandBps   = input.float(20.0,  "Band (bps)",              step = 2.5, group = gV)
vwapTPp   = input.float(100.0, "TP (pts)",                step = 5,   group = gV)
vwapSLp   = input.float(75.0,  "SL (pts)",                step = 5,   group = gV)
gapPctl   = input.float(25.0,  "Gap gate: rank >= (pctl)",  step = 5, group = gV)
trendPctl = input.float(60.0,  "Trend gate: rank <= (pctl)", step = 5, group = gV)

gO = "ON fade settings"
onB        = input.float(15.0, "Bracket B (pts, TP = SL)", step = 1, group = gO)
onMinRange = input.float(65.0, "Min ON range filter (pts)", step = 5, group = gO)
onUseH     = input.bool(true,  "Fade ONH (short)", group = gO)
onUseL     = input.bool(true,  "Fade ONL (long)",  group = gO)
onUseM     = input.bool(true,  "Fade ONM (toward RTH open)", group = gO)

gH = "HAR-RV settings"
harK      = input.float(0.65, "k multiplier",     minval = 0.1, step = 0.05, group = gH)
harTPm    = input.float(2.0,  "TP (x emove)",     minval = 0.1, step = 0.1,  group = gH)
harSLm    = input.float(1.0,  "SL (x emove)",     minval = 0.1, step = 0.1,  group = gH)

gD = "Display"
proxPts      = input.float(10.0, "Approach-alert distance (pts)", minval = 1, step = 1, group = gD)
showLevels   = input.bool(true,  "Level lines",            group = gD)
showLabels   = input.bool(true,  "Level labels (right edge)", group = gD)
showBrackets = input.bool(true,  "Active-trade brackets",  group = gD)
showTable    = input.bool(true,  "Info table",             group = gD)
tblPosIn     = input.string("top_right", "Table position",
     options = ["top_right", "top_left", "bottom_right", "bottom_left", "middle_right"], group = gD)

// ============================ CONSTANTS =============================
TZ   = "America/New_York"
SESS = "0930-1600"
ptVal = instr == "NQ" ? 20.0 : 2.0

inSess  = not na(time(timeframe.period, SESS, TZ))
newSess = inSess and not inSess[1]

// QC bar-end minute. On a 1-min chart `time` is the bar OPEN, so the
// backtest's "mend" (bar close minute) is minute-of-day + 1.
minOfDay = hour(time, TZ) * 60 + minute(time, TZ)
qcMend   = minOfDay + 1

tfOK = timeframe.in_seconds() == 60

// RTH windows, matched to the backtest exactly:
//   VWAP entries  : mend 572..959   (09:31..15:58 bar opens)
//   ON / HAR entry: mend 571..960   (09:30..15:59 bar opens)
//   EOD flat      : mend 960        (15:59 bar)
inRTH        = inSess
canEnterVwap = inSess and qcMend >= 572 and qcMend <= 959
isEOD        = inSess and qcMend == 960

// ========================= POSITION SIZING ==========================
var float dayRiskUsed = 0.0

// reset the daily risk budget at the very start of each session, BEFORE
// any strategy can trigger (the 09:30 bar can already open ON/HAR trades)
if newSess
    dayRiskUsed := 0.0

// contracts for a given stop distance, respecting per-trade and daily budget
f_size(stopPts) =>
    ok     = not na(stopPts) and stopPts > 0
    perCt  = ok ? stopPts * ptVal : 1.0
    remain = math.max(0.0, maxDayRisk - dayRiskUsed)
    budget = math.min(riskPerTrade, remain)
    raw    = int(math.floor(budget / perCt))
    ok ? (raw < 1 and allowMinOne and remain >= perCt ? 1 : raw) : 0

f_riskOf(ct, stopPts) => na(stopPts) ? 0.0 : ct * stopPts * ptVal

// =========================== VWAP STRATEGY ==========================
// previous / current RTH session OHLC (used by the percentile gates)
var float dOpen = na
var float dHigh = na
var float dLow  = na
var float dClose = na
var float pOpen = na
var float pHigh = na
var float pLow  = na
var float pClose = na

var array<float> trendHist = array.new_float(0)
var array<float> gapHist   = array.new_float(0)

// percentile rank of v inside arr (past-only); na until 60 samples
f_rank(arr, v) =>
    n = array.size(arr)
    cnt = 0
    if n >= 60 and not na(v)
        for i = 0 to n - 1
            if array.get(arr, i) <= v
                cnt += 1
    n >= 60 and not na(v) ? 100.0 * cnt / n : na

var bool  gapOK   = true
var bool  trendOK = true
var float cpv = 0.0
var float cv  = 0.0

if newSess
    // roll yesterday's RTH OHLC
    pOpen  := dOpen
    pHigh  := dHigh
    pLow   := dLow
    pClose := dClose
    dOpen  := open
    dHigh  := high
    dLow   := low
    dClose := close
    cpv := 0.0
    cv  := 0.0
    gapOK   := true
    trendOK := true
    if not na(pClose)
        ytr = pHigh > pLow ? math.abs(pClose - pOpen) / (pHigh - pLow) : na
        r1  = f_rank(trendHist, ytr)
        trendOK := na(r1) ? true : (r1 <= trendPctl)
        if not na(ytr)
            array.push(trendHist, ytr)
            if array.size(trendHist) > 250
                array.shift(trendHist)
        gp = pClose > 0 ? math.abs(dOpen / pClose - 1.0) : na
        r2 = f_rank(gapHist, gp)
        gapOK := na(r2) ? true : (r2 >= gapPctl)
        if not na(gp)
            array.push(gapHist, gp)
            if array.size(gapHist) > 250
                array.shift(gapHist)
else if inSess
    dHigh  := math.max(dHigh, high)
    dLow   := math.min(dLow, low)
    dClose := close

if inSess
    cpv += ((high + low + close) / 3.0) * volume
    cv  += volume

vwapV = inSess and cv > 0 ? cpv / cv : na
bFrac = bandBps / 10000.0
vUp   = na(vwapV) ? na : vwapV * (1.0 + bFrac)
vDn   = na(vwapV) ? na : vwapV * (1.0 - bFrac)

vwapGatesOK = gapOK and trendOK

var int    vPos    = 0
var bool   vTraded = false
var float  vEntry  = na
var float  vTPl    = na
var float  vSLl    = na
var int    vCt     = 0
var string vRes    = ""

if newSess
    vPos    := 0
    vTraded := false
    vEntry  := na
    vTPl    := na
    vSLl    := na
    vCt     := 0
    vRes    := ""

vJustEntered = false
vJustExited  = false

if useVWAP and inSess and tfOK
    // 1) manage open position first (mirrors the backtest ordering)
    if vPos != 0
        hitTP = vPos == 1 ? high >= vTPl : low  <= vTPl
        hitSL = vPos == 1 ? low  <= vSLl : high >= vSLl
        if hitTP and hitSL
            vRes := "SL"
            vPos := 0
            vJustExited := true
        else if hitSL
            vRes := "SL"
            vPos := 0
            vJustExited := true
        else if hitTP
            vRes := "TP"
            vPos := 0
            vJustExited := true
        else if isEOD
            vRes := "EOD"
            vPos := 0
            vJustExited := true
    // 2) entry
    if vPos == 0 and not vTraded and vwapGatesOK and canEnterVwap and not na(vUp)
        if close > vUp
            vPos    := 1
            vEntry  := close
            vTPl    := close + vwapTPp
            vSLl    := close - vwapSLp
            vTraded := true
            vCt     := f_size(vwapSLp)
            dayRiskUsed += f_riskOf(vCt, vwapSLp)
            vJustEntered := true
        else if close < vDn
            vPos    := -1
            vEntry  := close
            vTPl    := close - vwapTPp
            vSLl    := close + vwapSLp
            vTraded := true
            vCt     := f_size(vwapSLp)
            dayRiskUsed += f_riskOf(vCt, vwapSLp)
            vJustEntered := true

// ========================= ON FADE STRATEGY =========================
// ON window = 18:00 ET prev day -> 09:30 ET today (mend >= 1080 or <= 570)
inON = qcMend >= 1080 or qcMend <= 570

var float onAccH = na
var float onAccL = na
if inON
    if na(onAccH)
        onAccH := high
        onAccL := low
    else
        onAccH := math.max(onAccH, high)
        onAccL := math.min(onAccL, low)

var float ONH = na
var float ONL = na
var float ONM = na
var float onRange = na
var int   mDir = 0
var float rthOpen = na

var int   hSt = 0
var int   lSt = 0
var int   mSt = 0
var float hEn = na
var float hTP = na
var float hSL = na
var float lEn = na
var float lTP = na
var float lSL = na
var float mEn = na
var float mTP = na
var float mSL = na
var int   hCt = 0
var int   lCt = 0
var int   mCt = 0

if newSess
    ONH     := onAccH
    ONL     := onAccL
    ONM     := na(onAccH) or na(onAccL) ? na : (onAccH + onAccL) / 2.0
    onRange := na(onAccH) or na(onAccL) ? na : onAccH - onAccL
    rthOpen := open
    onAccH  := na
    onAccL  := na
    mDir    := na(ONM) ? 0 : (rthOpen > ONM ? 1 : rthOpen < ONM ? -1 : 0)
    hSt := 0
    lSt := 0
    mSt := 0
    hCt := 0
    lCt := 0
    mCt := 0
    hEn := na
    lEn := na
    mEn := na

onRangeOK = not na(onRange) and onRange >= onMinRange

hJustEntered = false
lJustEntered = false
mJustEntered = false
hJustExited  = false
lJustExited  = false
mJustExited  = false

if useON and inRTH and tfOK and onRangeOK and not na(ONH)
    // ---- ONH : fade short ----
    if onUseH
        if hSt == 0 and high >= ONH
            hSt := 1
            hEn := ONH
            hTP := ONH - onB
            hSL := ONH + onB
            hCt := f_size(onB)
            dayRiskUsed += f_riskOf(hCt, onB)
            hJustEntered := true
        if hSt == 1
            tp = low  <= hTP
            sl = high >= hSL
            if tp and sl
                hSt := 3
                hJustExited := true
            else if tp
                hSt := 2
                hJustExited := true
            else if sl
                hSt := 3
                hJustExited := true
            else if isEOD
                hSt := 4
                hJustExited := true
    // ---- ONL : fade long ----
    if onUseL
        if lSt == 0 and low <= ONL
            lSt := 1
            lEn := ONL
            lTP := ONL + onB
            lSL := ONL - onB
            lCt := f_size(onB)
            dayRiskUsed += f_riskOf(lCt, onB)
            lJustEntered := true
        if lSt == 1
            tp = high >= lTP
            sl = low  <= lSL
            if tp and sl
                lSt := 3
                lJustExited := true
            else if tp
                lSt := 2
                lJustExited := true
            else if sl
                lSt := 3
                lJustExited := true
            else if isEOD
                lSt := 4
                lJustExited := true
    // ---- ONM : fade toward RTH open ----
    if onUseM and mDir != 0
        if mSt == 0 and high >= ONM and low <= ONM
            mSt := 1
            mEn := ONM
            mTP := ONM + mDir * onB
            mSL := ONM - mDir * onB
            mCt := f_size(onB)
            dayRiskUsed += f_riskOf(mCt, onB)
            mJustEntered := true
        if mSt == 1
            tp = mDir == 1 ? high >= mTP : low  <= mTP
            sl = mDir == 1 ? low  <= mSL : high >= mSL
            if tp and sl
                mSt := 3
                mJustExited := true
            else if tp
                mSt := 2
                mJustExited := true
            else if sl
                mSt := 3
                mJustExited := true
            else if isEOD
                mSt := 4
                mJustExited := true

// ========================= HAR-RV STRATEGY ==========================
// Parkinson daily variance from the daily chart (deep history, works on
// any intraday timeframe). Daily bar is full-session, so RV runs a bit
// hot vs the RTH-only backtest -> default k = 0.65 compensates.
f_rvAt(i) =>
    [h, l] = request.security(syminfo.tickerid, "D", [high[i], low[i]], barmerge.gaps_off, barmerge.lookahead_off)
    h > l and not na(h) and not na(l) ? (math.log(h / l) * math.log(h / l)) / (4.0 * math.log(2.0)) : 0.0

rv01 = f_rvAt(1)
rv02 = f_rvAt(2)
rv03 = f_rvAt(3)
rv04 = f_rvAt(4)
rv05 = f_rvAt(5)
rv06 = f_rvAt(6)
rv07 = f_rvAt(7)
rv08 = f_rvAt(8)
rv09 = f_rvAt(9)
rv10 = f_rvAt(10)
rv11 = f_rvAt(11)
rv12 = f_rvAt(12)
rv13 = f_rvAt(13)
rv14 = f_rvAt(14)
rv15 = f_rvAt(15)
rv16 = f_rvAt(16)
rv17 = f_rvAt(17)
rv18 = f_rvAt(18)
rv19 = f_rvAt(19)
rv20 = f_rvAt(20)
rv21 = f_rvAt(21)
rv22 = f_rvAt(22)

rvD = rv01
rvW = (rv01 + rv02 + rv03 + rv04 + rv05) / 5.0
rvM = (rv01 + rv02 + rv03 + rv04 + rv05 + rv06 + rv07 + rv08 + rv09 + rv10 +
       rv11 + rv12 + rv13 + rv14 + rv15 + rv16 + rv17 + rv18 + rv19 + rv20 + rv21 + rv22) / 22.0

// full 22-day history present? (oldest sample non-zero). Without this the
// average is diluted by zeros, emove comes out too small and the levels
// would fire spurious breakouts on a short chart history.
harReady = rv22 > 0

var float emove = na
var float hUp   = na
var float hDn   = na
var int   rSt   = 0
var int   rDir  = 0
var float rEn   = na
var float rTP   = na
var float rSL   = na
var int   rCt   = 0

if newSess
    predVar   = 0.36 * rvD + 0.28 * rvW + 0.28 * rvM
    predSigma = math.sqrt(math.max(predVar, 0.0))
    emove := open * predSigma
    hUp   := open + harK * emove
    hDn   := open - harK * emove
    rSt   := 0
    rDir  := 0
    rEn   := na
    rTP   := na
    rSL   := na
    rCt   := 0

harStopPts = na(emove) ? na : harSLm * emove

rJustEntered = false
rJustExited  = false

if useHAR and inRTH and tfOK and harReady and not na(hUp) and emove > 0
    if rSt == 0
        if close >= hUp
            rSt  := 1
            rDir := 1
            rEn  := close
            rTP  := close + harTPm * emove
            rSL  := close - harSLm * emove
            rCt  := f_size(harStopPts)
            dayRiskUsed += f_riskOf(rCt, harStopPts)
            rJustEntered := true
        else if close <= hDn
            rSt  := 1
            rDir := -1
            rEn  := close
            rTP  := close - harTPm * emove
            rSL  := close + harSLm * emove
            rCt  := f_size(harStopPts)
            dayRiskUsed += f_riskOf(rCt, harStopPts)
            rJustEntered := true
    if rSt == 1
        tp = rDir == 1 ? high >= rTP : low  <= rTP
        sl = rDir == 1 ? low  <= rSL : high >= rSL
        if tp and sl
            rSt := 3
            rJustExited := true
        else if tp
            rSt := 2
            rJustExited := true
        else if sl
            rSt := 3
            rJustExited := true
        else if isEOD
            rSt := 4
            rJustExited := true

// ====================== PRE-TRADE SIZE PREVIEW ======================
vCtPrev = f_size(vwapSLp)
oCtPrev = f_size(onB)
rCtPrev = na(harStopPts) ? 0 : f_size(harStopPts)

// ============================== PLOTS ===============================
pV  = plot(showLevels and useVWAP and inSess ? vwapV : na, "VWAP",        color = color.new(color.orange, 20), linewidth = 1, style = plot.style_linebr)
pVu = plot(showLevels and useVWAP and inSess ? vUp   : na, "VWAP +band",  color = color.new(color.orange, 55), linewidth = 1, style = plot.style_linebr)
pVd = plot(showLevels and useVWAP and inSess ? vDn   : na, "VWAP -band",  color = color.new(color.orange, 55), linewidth = 1, style = plot.style_linebr)
fill(pVu, pVd, color = color.new(color.orange, 95))

plot(showLevels and useON and inSess ? ONH : na, "ONH",      color = color.new(color.purple, 0),  linewidth = 2, style = plot.style_linebr)
plot(showLevels and useON and inSess ? ONL : na, "ONL",      color = color.new(color.purple, 0),  linewidth = 2, style = plot.style_linebr)
plot(showLevels and useON and inSess ? ONM : na, "ON mid",   color = color.new(color.purple, 45), linewidth = 1, style = plot.style_linebr)

plot(showLevels and useHAR and harReady and inSess ? hUp : na, "HAR up",  color = color.new(color.teal, 10), linewidth = 2, style = plot.style_linebr)
plot(showLevels and useHAR and harReady and inSess ? hDn : na, "HAR dn",  color = color.new(color.teal, 10), linewidth = 2, style = plot.style_linebr)

// ======================= ACTIVE-TRADE BRACKETS ======================
// Drawn as plots rather than line objects: nothing to create, extend or
// delete, so there is no drawing-object lifecycle that can leak or drop
// a bracket. Each set shows only while that specific trade is open.
vAct = showBrackets and vPos != 0
hAct = showBrackets and hSt == 1
lAct = showBrackets and lSt == 1
mAct = showBrackets and mSt == 1
rAct = showBrackets and rSt == 1

CE = color.new(color.blue,  0)
CT = color.new(color.green, 0)
CS = color.new(color.red,   0)

plot(vAct ? vEntry : na, "VWAP entry",  color = CE, linewidth = 2, style = plot.style_linebr)
plot(vAct ? vTPl   : na, "VWAP TP",     color = CT, linewidth = 1, style = plot.style_linebr)
plot(vAct ? vSLl   : na, "VWAP SL",     color = CS, linewidth = 1, style = plot.style_linebr)

plot(hAct ? hEn : na, "ON-H entry", color = CE, linewidth = 2, style = plot.style_linebr)
plot(hAct ? hTP : na, "ON-H TP",    color = CT, linewidth = 1, style = plot.style_linebr)
plot(hAct ? hSL : na, "ON-H SL",    color = CS, linewidth = 1, style = plot.style_linebr)

plot(lAct ? lEn : na, "ON-L entry", color = CE, linewidth = 2, style = plot.style_linebr)
plot(lAct ? lTP : na, "ON-L TP",    color = CT, linewidth = 1, style = plot.style_linebr)
plot(lAct ? lSL : na, "ON-L SL",    color = CS, linewidth = 1, style = plot.style_linebr)

plot(mAct ? mEn : na, "ON-M entry", color = CE, linewidth = 2, style = plot.style_linebr)
plot(mAct ? mTP : na, "ON-M TP",    color = CT, linewidth = 1, style = plot.style_linebr)
plot(mAct ? mSL : na, "ON-M SL",    color = CS, linewidth = 1, style = plot.style_linebr)

plot(rAct ? rEn : na, "HAR entry",  color = CE, linewidth = 2, style = plot.style_linebr)
plot(rAct ? rTP : na, "HAR TP",     color = CT, linewidth = 1, style = plot.style_linebr)
plot(rAct ? rSL : na, "HAR SL",     color = CS, linewidth = 1, style = plot.style_linebr)


// ============================== SHAPES ==============================
plotshape(vJustEntered and vPos ==  1, "VWAP long",  shape.triangleup,   location.belowbar, color.new(color.orange, 0), size = size.tiny,  text = "VW")
plotshape(vJustEntered and vPos == -1, "VWAP short", shape.triangledown, location.abovebar, color.new(color.orange, 0), size = size.tiny,  text = "VW")
plotshape(lJustEntered,                "ONL long",   shape.triangleup,   location.belowbar, color.new(color.purple, 0), size = size.tiny,  text = "ONL")
plotshape(hJustEntered,                "ONH short",  shape.triangledown, location.abovebar, color.new(color.purple, 0), size = size.tiny,  text = "ONH")
plotshape(mJustEntered and mDir ==  1, "ONM long",   shape.triangleup,   location.belowbar, color.new(color.fuchsia, 0), size = size.tiny, text = "ONM")
plotshape(mJustEntered and mDir == -1, "ONM short",  shape.triangledown, location.abovebar, color.new(color.fuchsia, 0), size = size.tiny, text = "ONM")
plotshape(rJustEntered and rDir ==  1, "HAR long",   shape.triangleup,   location.belowbar, color.new(color.teal, 0),   size = size.tiny,  text = "HAR")
plotshape(rJustEntered and rDir == -1, "HAR short",  shape.triangledown, location.abovebar, color.new(color.teal, 0),   size = size.tiny,  text = "HAR")

anyExitTP = (vJustExited and vRes == "TP") or (hJustExited and hSt == 2) or (lJustExited and lSt == 2) or (mJustExited and mSt == 2) or (rJustExited and rSt == 2)
anyExitSL = (vJustExited and vRes == "SL") or (hJustExited and hSt == 3) or (lJustExited and lSt == 3) or (mJustExited and mSt == 3) or (rJustExited and rSt == 3)
anyExitEOD = (vJustExited and vRes == "EOD") or (hJustExited and hSt == 4) or (lJustExited and lSt == 4) or (mJustExited and mSt == 4) or (rJustExited and rSt == 4)

plotshape(anyExitTP,  "TP",  shape.diamond, location.abovebar, color.new(color.green, 0), size = size.tiny, text = "TP")
plotshape(anyExitSL,  "SL",  shape.xcross,  location.belowbar, color.new(color.red,   0), size = size.tiny, text = "SL")
plotshape(anyExitEOD, "EOD", shape.xcross,  location.abovebar, color.new(color.gray,  0), size = size.tiny, text = "EOD")

// ========================= APPROACH ALERTS ==========================
var bool nearV = false
var bool nearH = false
var bool nearL = false
var bool nearM = false
var bool nearR = false
if newSess
    nearV := false
    nearH := false
    nearL := false
    nearM := false
    nearR := false

vNearNow = useVWAP and inSess and tfOK and vPos == 0 and not vTraded and vwapGatesOK and canEnterVwap and not na(vUp) and (math.abs(close - vUp) <= proxPts or math.abs(close - vDn) <= proxPts)
hNearNow = useON and onUseH and inRTH and tfOK and onRangeOK and hSt == 0 and not na(ONH) and math.abs(close - ONH) <= proxPts
lNearNow = useON and onUseL and inRTH and tfOK and onRangeOK and lSt == 0 and not na(ONL) and math.abs(close - ONL) <= proxPts
mNearNow = useON and onUseM and inRTH and tfOK and onRangeOK and mSt == 0 and mDir != 0 and not na(ONM) and math.abs(close - ONM) <= proxPts
rNearNow = useHAR and inRTH and tfOK and harReady and rSt == 0 and not na(hUp) and (math.abs(close - hUp) <= proxPts or math.abs(close - hDn) <= proxPts)

vFireNear = vNearNow and not nearV
hFireNear = hNearNow and not nearH
lFireNear = lNearNow and not nearL
mFireNear = mNearNow and not nearM
rFireNear = rNearNow and not nearR

if vFireNear
    nearV := true
if hFireNear
    nearH := true
if lFireNear
    nearL := true
if mFireNear
    nearM := true
if rFireNear
    nearR := true

plotshape(vFireNear or hFireNear or lFireNear or mFireNear or rFireNear, "Approaching",
     shape.circle, location.belowbar, color.new(color.yellow, 20), size = size.tiny)

// ============================== ALERTS ==============================
f_money(x) => "$" + str.tostring(na(x) ? 0.0 : x, "#")

if vFireNear
    alert("NEAR  VWAP band  |  " + str.tostring(vCtPrev) + " " + instr +
      "  |  SL " + str.tostring(vwapSLp, "#") + " pts  risk " + f_money(f_riskOf(vCtPrev, vwapSLp)) +
      "  |  up " + str.tostring(vUp, "#.##") + "  dn " + str.tostring(vDn, "#.##"), alert.freq_once_per_bar_close)
if hFireNear
    alert("NEAR  ONH short @ " + str.tostring(ONH, "#.##") + "  |  " + str.tostring(oCtPrev) + " " + instr +
      "  |  TP " + str.tostring(ONH - onB, "#.##") + "  SL " + str.tostring(ONH + onB, "#.##") +
      "  risk " + f_money(f_riskOf(oCtPrev, onB)), alert.freq_once_per_bar_close)
if lFireNear
    alert("NEAR  ONL long @ " + str.tostring(ONL, "#.##") + "  |  " + str.tostring(oCtPrev) + " " + instr +
      "  |  TP " + str.tostring(ONL + onB, "#.##") + "  SL " + str.tostring(ONL - onB, "#.##") +
      "  risk " + f_money(f_riskOf(oCtPrev, onB)), alert.freq_once_per_bar_close)
if mFireNear
    alert("NEAR  ONM " + (mDir == 1 ? "long" : "short") + " @ " + str.tostring(ONM, "#.##") +
      "  |  " + str.tostring(oCtPrev) + " " + instr +
      "  |  TP " + str.tostring(ONM + mDir * onB, "#.##") + "  SL " + str.tostring(ONM - mDir * onB, "#.##") +
      "  risk " + f_money(f_riskOf(oCtPrev, onB)), alert.freq_once_per_bar_close)
if rFireNear
    alert("NEAR  HAR-RV breakout  |  " + str.tostring(rCtPrev) + " " + instr +
      "  |  SL " + str.tostring(harStopPts, "#") + " pts  risk " + f_money(f_riskOf(rCtPrev, harStopPts)) +
      "  |  up " + str.tostring(hUp, "#.##") + "  dn " + str.tostring(hDn, "#.##"), alert.freq_once_per_bar_close)

if vJustEntered
    alert("ENTRY  VWAP " + (vPos == 1 ? "LONG" : "SHORT") + " @ " + str.tostring(vEntry, "#.##") +
      "  |  " + str.tostring(vCt) + " " + instr +
      "  |  TP " + str.tostring(vTPl, "#.##") + "  SL " + str.tostring(vSLl, "#.##") +
      "  |  risk " + f_money(f_riskOf(vCt, vwapSLp)), alert.freq_once_per_bar_close)
if hJustEntered
    alert("ENTRY  ONH SHORT @ " + str.tostring(hEn, "#.##") + "  |  " + str.tostring(hCt) + " " + instr +
      "  |  TP " + str.tostring(hTP, "#.##") + "  SL " + str.tostring(hSL, "#.##") +
      "  |  risk " + f_money(f_riskOf(hCt, onB)), alert.freq_once_per_bar_close)
if lJustEntered
    alert("ENTRY  ONL LONG @ " + str.tostring(lEn, "#.##") + "  |  " + str.tostring(lCt) + " " + instr +
      "  |  TP " + str.tostring(lTP, "#.##") + "  SL " + str.tostring(lSL, "#.##") +
      "  |  risk " + f_money(f_riskOf(lCt, onB)), alert.freq_once_per_bar_close)
if mJustEntered
    alert("ENTRY  ONM " + (mDir == 1 ? "LONG" : "SHORT") + " @ " + str.tostring(mEn, "#.##") +
      "  |  " + str.tostring(mCt) + " " + instr +
      "  |  TP " + str.tostring(mTP, "#.##") + "  SL " + str.tostring(mSL, "#.##") +
      "  |  risk " + f_money(f_riskOf(mCt, onB)), alert.freq_once_per_bar_close)
if rJustEntered
    alert("ENTRY  HAR-RV " + (rDir == 1 ? "LONG" : "SHORT") + " @ " + str.tostring(rEn, "#.##") +
      "  |  " + str.tostring(rCt) + " " + instr +
      "  |  TP " + str.tostring(rTP, "#.##") + "  SL " + str.tostring(rSL, "#.##") +
      "  |  risk " + f_money(f_riskOf(rCt, harStopPts)), alert.freq_once_per_bar_close)

if anyExitTP
    alert("EXIT  TP hit", alert.freq_once_per_bar_close)
if anyExitSL
    alert("EXIT  SL hit", alert.freq_once_per_bar_close)
if anyExitEOD
    alert("EXIT  EOD flat 15:59 ET", alert.freq_once_per_bar_close)

// ============================ INFO TABLE ============================
tPos = tblPosIn == "top_left" ? position.top_left : tblPosIn == "bottom_right" ? position.bottom_right : tblPosIn == "bottom_left" ? position.bottom_left : tblPosIn == "middle_right" ? position.middle_right : position.top_right

var table T = table.new(tPos, 5, 9, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 40))

CH  = color.new(color.gray, 85)
CW  = color.new(color.gray, 70)
CN  = color.new(color.yellow, 60)
CL  = color.new(color.green, 65)
CSh = color.new(color.red, 65)
CD  = color.new(color.blue, 75)
TXT = color.white

f_stStr(st, dirn) =>
    st == 0 ? "WAIT" : st == 1 ? (dirn == 1 ? "LONG" : "SHORT") : st == 2 ? "TP" : st == 3 ? "SL" : "EOD"

f_stCol(st, dirn, isNear) =>
    st == 0 ? (isNear ? CN : CW) : st == 1 ? (dirn == 1 ? CL : CSh) : CD

if showTable and barstate.islast
    table.clear(T, 0, 0, 4, 8)
    // header
    table.cell(T, 0, 0, "NQ PORTFOLIO", bgcolor = CH, text_color = TXT, text_size = size.small)
    table.cell(T, 1, 0, instr + "  $" + str.tostring(ptVal, "#") + "/pt", bgcolor = CH, text_color = TXT, text_size = size.small)
    table.cell(T, 2, 0, "risk " + f_money(riskPerTrade) + "/tr", bgcolor = CH, text_color = TXT, text_size = size.small)
    table.cell(T, 3, 0, "day " + f_money(dayRiskUsed) + "/" + f_money(maxDayRisk), bgcolor = CH, text_color = TXT, text_size = size.small)
    table.cell(T, 4, 0, tfOK ? "1m OK" : "WRONG TF!", bgcolor = tfOK ? CH : color.new(color.red, 20), text_color = TXT, text_size = size.small)
    // column headers
    table.cell(T, 0, 1, "strategy", bgcolor = CH, text_color = TXT, text_size = size.tiny)
    table.cell(T, 1, 1, "status",   bgcolor = CH, text_color = TXT, text_size = size.tiny)
    table.cell(T, 2, 1, "level",    bgcolor = CH, text_color = TXT, text_size = size.tiny)
    table.cell(T, 3, 1, "size",     bgcolor = CH, text_color = TXT, text_size = size.tiny)
    table.cell(T, 4, 1, "risk $",   bgcolor = CH, text_color = TXT, text_size = size.tiny)

    // ---- VWAP row ----
    vStat = not useVWAP ? "OFF" : not vwapGatesOK ? "GATED" : vPos != 0 ? (vPos == 1 ? "LONG" : "SHORT") : vTraded ? vRes : (vNearNow ? "NEAR" : "WAIT")
    vBg   = not useVWAP ? CW : not vwapGatesOK ? CW : vPos == 1 ? CL : vPos == -1 ? CSh : vTraded ? CD : (vNearNow ? CN : CW)
    vLvl  = vPos != 0 or vTraded ? str.tostring(vEntry, "#.##") : na(vUp) ? "-" : str.tostring(vUp, "#.##") + " / " + str.tostring(vDn, "#.##")
    vShowCt = vPos != 0 or vTraded ? vCt : vCtPrev
    table.cell(T, 0, 2, "VWAP 100/75", bgcolor = CW, text_color = TXT, text_size = size.tiny)
    table.cell(T, 1, 2, vStat, bgcolor = vBg, text_color = TXT, text_size = size.tiny)
    table.cell(T, 2, 2, vLvl,  bgcolor = CW, text_color = TXT, text_size = size.tiny)
    table.cell(T, 3, 2, str.tostring(vShowCt), bgcolor = CW, text_color = TXT, text_size = size.tiny)
    table.cell(T, 4, 2, f_money(f_riskOf(vShowCt, vwapSLp)), bgcolor = CW, text_color = TXT, text_size = size.tiny)

    // ---- ONH row ----
    hStat = not useON or not onUseH ? "OFF" : not onRangeOK ? "GATED" : f_stStr(hSt, -1)
    hBg   = not useON or not onUseH ? CW : not onRangeOK ? CW : f_stCol(hSt, -1, hNearNow)
    hShowCt = hSt == 0 ? oCtPrev : hCt
    table.cell(T, 0, 3, "ON-H short", bgcolor = CW, text_color = TXT, text_size = size.tiny)
    table.cell(T, 1, 3, hSt == 0 and hNearNow and onRangeOK and useON and onUseH ? "NEAR" : hStat, bgcolor = hBg, text_color = TXT, text_size = size.tiny)
    table.cell(T, 2, 3, na(ONH) ? "-" : str.tostring(ONH, "#.##"), bgcolor = CW, text_color = TXT, text_size = size.tiny)
    table.cell(T, 3, 3, str.tostring(hShowCt), bgcolor = CW, text_color = TXT, text_size = size.tiny)
    table.cell(T, 4, 3, f_money(f_riskOf(hShowCt, onB)), bgcolor = CW, text_color = TXT, text_size = size.tiny)

    // ---- ONL row ----
    lStat = not useON or not onUseL ? "OFF" : not onRangeOK ? "GATED" : f_stStr(lSt, 1)
    lBg   = not useON or not onUseL ? CW : not onRangeOK ? CW : f_stCol(lSt, 1, lNearNow)
    lShowCt = lSt == 0 ? oCtPrev : lCt
    table.cell(T, 0, 4, "ON-L long", bgcolor = CW, text_color = TXT, text_size = size.tiny)
    table.cell(T, 1, 4, lSt == 0 and lNearNow and onRangeOK and useON and onUseL ? "NEAR" : lStat, bgcolor = lBg, text_color = TXT, text_size = size.tiny)
    table.cell(T, 2, 4, na(ONL) ? "-" : str.tostring(ONL, "#.##"), bgcolor = CW, text_color = TXT, text_size = size.tiny)
    table.cell(T, 3, 4, str.tostring(lShowCt), bgcolor = CW, text_color = TXT, text_size = size.tiny)
    table.cell(T, 4, 4, f_money(f_riskOf(lShowCt, onB)), bgcolor = CW, text_color = TXT, text_size = size.tiny)

    // ---- ONM row ----
    mStat = not useON or not onUseM ? "OFF" : not onRangeOK ? "GATED" : mDir == 0 ? "SKIP" : f_stStr(mSt, mDir)
    mBg   = not useON or not onUseM ? CW : not onRangeOK ? CW : f_stCol(mSt, mDir, mNearNow)
    mShowCt = mSt == 0 ? oCtPrev : mCt
    table.cell(T, 0, 5, "ON-M " + (mDir == 1 ? "long" : mDir == -1 ? "short" : "-"), bgcolor = CW, text_color = TXT, text_size = size.tiny)
    table.cell(T, 1, 5, mSt == 0 and mNearNow and onRangeOK and useON and onUseM ? "NEAR" : mStat, bgcolor = mBg, text_color = TXT, text_size = size.tiny)
    table.cell(T, 2, 5, na(ONM) ? "-" : str.tostring(ONM, "#.##"), bgcolor = CW, text_color = TXT, text_size = size.tiny)
    table.cell(T, 3, 5, str.tostring(mShowCt), bgcolor = CW, text_color = TXT, text_size = size.tiny)
    table.cell(T, 4, 5, f_money(f_riskOf(mShowCt, onB)), bgcolor = CW, text_color = TXT, text_size = size.tiny)

    // ---- HAR-RV row ----
    rStat = not useHAR ? "OFF" : not harReady or na(emove) ? "WARMUP" : f_stStr(rSt, rDir)
    rBg   = not useHAR ? CW : not harReady or na(emove) ? CW : f_stCol(rSt, rDir, rNearNow)
    rShowCt = rSt == 0 ? rCtPrev : rCt
    rRisk = na(harStopPts) ? 0.0 : f_riskOf(rShowCt, harStopPts)
    table.cell(T, 0, 6, "HAR-RV brk", bgcolor = CW, text_color = TXT, text_size = size.tiny)
    table.cell(T, 1, 6, rSt == 0 and rNearNow and useHAR ? "NEAR" : rStat, bgcolor = rBg, text_color = TXT, text_size = size.tiny)
    table.cell(T, 2, 6, na(hUp) ? "-" : str.tostring(hUp, "#.##") + " / " + str.tostring(hDn, "#.##"), bgcolor = CW, text_color = TXT, text_size = size.tiny)
    table.cell(T, 3, 6, str.tostring(rShowCt), bgcolor = CW, text_color = TXT, text_size = size.tiny)
    table.cell(T, 4, 6, f_money(rRisk) + (rRisk > riskPerTrade ? " !" : ""), bgcolor = rRisk > riskPerTrade ? color.new(color.red, 60) : CW, text_color = TXT, text_size = size.tiny)

    // ---- context row ----
    table.cell(T, 0, 7, "ON range", bgcolor = CH, text_color = TXT, text_size = size.tiny)
    table.cell(T, 1, 7, na(onRange) ? "-" : str.tostring(onRange, "#") + (onRangeOK ? " ok" : " <min"), bgcolor = onRangeOK ? CH : color.new(color.red, 60), text_color = TXT, text_size = size.tiny)
    table.cell(T, 2, 7, "emove " + (na(emove) ? "-" : str.tostring(emove, "#")), bgcolor = CH, text_color = TXT, text_size = size.tiny)
    table.cell(T, 3, 7, "gap " + (gapOK ? "ok" : "no"), bgcolor = gapOK ? CH : color.new(color.red, 60), text_color = TXT, text_size = size.tiny)
    table.cell(T, 4, 7, "trend " + (trendOK ? "ok" : "no"), bgcolor = trendOK ? CH : color.new(color.red, 60), text_color = TXT, text_size = size.tiny)

    // ---- pass plan row ----
    remainUSD  = math.max(0.0, targetUSD - profitSoFar)
    daysLeft   = math.max(1, daysTarget - daysUsed)
    needPerDay = remainUSD / daysLeft
    table.cell(T, 0, 8, "PASS PLAN", bgcolor = CH, text_color = TXT, text_size = size.tiny)
    table.cell(T, 1, 8, "left " + f_money(remainUSD), bgcolor = CH, text_color = TXT, text_size = size.tiny)
    table.cell(T, 2, 8, str.tostring(daysLeft) + " days", bgcolor = CH, text_color = TXT, text_size = size.tiny)
    table.cell(T, 3, 8, "need " + f_money(needPerDay) + "/d", bgcolor = CH, text_color = TXT, text_size = size.tiny)
    // remaining *planned* risk budget for today (not realized P/L — the
    // indicator cannot see the account, so it never claims to know DD left)
    riskLeft = math.max(0.0, maxDayRisk - dayRiskUsed)
    table.cell(T, 4, 8, "risk left " + f_money(riskLeft), bgcolor = riskLeft <= 0 ? color.new(color.red, 40) : CH, text_color = TXT, text_size = size.tiny)

// =========================== LEVEL LABELS ===========================
var label labONH = na
var label labONL = na
var label labONM = na
var label labHU  = na
var label labHD  = na

if showLabels and barstate.islast and inSess
    label.delete(labONH)
    label.delete(labONL)
    label.delete(labONM)
    label.delete(labHU)
    label.delete(labHD)
    if useON and not na(ONH)
        labONH := label.new(bar_index + 2, ONH, "ONH", style = label.style_label_left, color = color.new(color.purple, 70), textcolor = TXT, size = size.tiny)
        labONL := label.new(bar_index + 2, ONL, "ONL", style = label.style_label_left, color = color.new(color.purple, 70), textcolor = TXT, size = size.tiny)
        if onUseM
            labONM := label.new(bar_index + 2, ONM, "ONM", style = label.style_label_left, color = color.new(color.fuchsia, 70), textcolor = TXT, size = size.tiny)
    if useHAR and harReady and not na(hUp)
        labHU := label.new(bar_index + 2, hUp, "HAR+", style = label.style_label_left, color = color.new(color.teal, 70), textcolor = TXT, size = size.tiny)
        labHD := label.new(bar_index + 2, hDn, "HAR-", style = label.style_label_left, color = color.new(color.teal, 70), textcolor = TXT, size = size.tiny)

// =========================== TF WARNING =============================
var label warnLab = na
if barstate.islast
    label.delete(warnLab)
    if not tfOK
        warnLab := label.new(bar_index, high, "SWITCH TO 1-MINUTE CHART\nsignals are disabled",
             style = label.style_label_down, color = color.new(color.red, 10), textcolor = color.white, size = size.large)

// ======================= STATIC ALERTCONDITIONS =====================
alertcondition(vJustEntered, "VWAP entry",   "NQ portfolio: VWAP entry")
alertcondition(hJustEntered, "ONH entry",    "NQ portfolio: ONH fade short")
alertcondition(lJustEntered, "ONL entry",    "NQ portfolio: ONL fade long")
alertcondition(mJustEntered, "ONM entry",    "NQ portfolio: ONM fade")
alertcondition(rJustEntered, "HAR-RV entry", "NQ portfolio: HAR-RV breakout")
alertcondition(vFireNear or hFireNear or lFireNear or mFireNear or rFireNear, "Any approach", "NQ portfolio: price approaching a trigger level")
