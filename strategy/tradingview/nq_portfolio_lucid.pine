//@version=5
// =====================================================================
// NQ PORTFOLIO — VWAP TP100/SL75 + ON Fade + HAR-RV Breakout
// Live cockpit for the Lucid Flex 50k evaluation.  1-MINUTE CHART ONLY.
//
// Backtested NQ 2018-2025 (QuantConnect, real futures, close-based,
// 0.75 pts cost):  VWAP z=+3.29 | ON fade z=+10.87 | HAR-RV z=+3.10
// Pairwise correlations all |rho| < 0.2.
// =====================================================================
indicator("NQ Portfolio — VWAP + ON Fade + HAR-RV", overlay = true,
     max_lines_count = 500, max_labels_count = 500)

// ============================== INPUTS ==============================
gA = "Account / risk sizing"
instr        = input.string("MNQ", "Instrument", options = ["MNQ", "NQ"], group = gA)
riskPerTrade = input.float(200.0, "Risk per trade ($)", minval = 10, step = 10, group = gA)
maxDayRisk   = input.float(800.0, "Max daily risk ($)", minval = 50, step = 50, group = gA)
allowMinOne  = input.bool(false,  "Allow 1 contract even if over budget", group = gA)

gS = "Strategies"
useVWAP = input.bool(true, "1) VWAP band TP100 / SL75", group = gS)
useON   = input.bool(true, "2) ON fade ONH / ONL / ONM", group = gS)
useHAR  = input.bool(true, "3) HAR-RV breakout", group = gS)

gV = "VWAP settings"
bandBps   = input.float(20.0,  "Band (bps)", step = 2.5, group = gV)
vwapTPp   = input.float(100.0, "TP (pts)",   step = 5,   group = gV)
vwapSLp   = input.float(75.0,  "SL (pts)",   step = 5,   group = gV)
gapPctl   = input.float(25.0,  "Gap gate: rank >=",   step = 5, group = gV)
trendPctl = input.float(60.0,  "Trend gate: rank <=", step = 5, group = gV)

gO = "ON fade settings"
onB        = input.float(15.0, "Bracket B (pts, TP = SL)", step = 1, group = gO)
onMinRange = input.float(65.0, "Min ON range (pts)", step = 5, group = gO)
onUseH     = input.bool(true,  "Fade ONH (short)", group = gO)
onUseL     = input.bool(true,  "Fade ONL (long)",  group = gO)
onUseM     = input.bool(true,  "Fade ONM (toward RTH open)", group = gO)

gH = "HAR-RV settings"
harK   = input.float(0.65, "k multiplier", minval = 0.1, step = 0.05, group = gH)
harTPm = input.float(2.0,  "TP (x emove)", minval = 0.1, step = 0.1,  group = gH)
harSLm = input.float(1.0,  "SL (x emove)", minval = 0.1, step = 0.1,  group = gH)

gD = "Display"
minimalMode = input.bool(false, "MINIMAL — banner + table + brackets only", group = gD)
proxPts     = input.float(15.0, "Warning distance floor (pts)", minval = 1, step = 1, group = gD)
proxAtrMult = input.float(2.0,  "...or N x recent 1-min range (bigger wins)", minval = 0.0, step = 0.25, group = gD)
brkMinBars  = input.int(25,     "Minimum bracket length (bars)", minval = 3, group = gD)
bannerBars  = input.int(15,     "Banner visible for N bars", minval = 1, maxval = 240, group = gD)
bannerPosIn = input.string("top_center", "Banner position",
     options = ["top_center", "bottom_center", "middle_center"], group = gD)
tblPosIn    = input.string("top_right", "Table position",
     options = ["top_right", "top_left", "bottom_right", "bottom_left", "middle_right"], group = gD)
showLevels  = input.bool(true, "Level lines (VWAP band, ON, HAR)", group = gD)
showBrk     = input.bool(true, "Trade brackets (entry / TP / SL)", group = gD)
showTable   = input.bool(true, "Status table", group = gD)

// MINIMAL only strips decoration. Banner, table and brackets survive.
showLevelsEff = showLevels and not minimalMode
flashEff      = not minimalMode

// ============================ CONSTANTS =============================
TZ    = "America/New_York"
SESS  = "0930-1600"
ptVal = instr == "NQ" ? 20.0 : 2.0

inSess  = not na(time(timeframe.period, SESS, TZ))
newSess = inSess and not inSess[1]

// On a 1-min chart `time` is the bar OPEN, so the backtest's bar-close
// minute ("mend") is minute-of-day + 1.
minOfDay = hour(time, TZ) * 60 + minute(time, TZ)
qcMend   = minOfDay + 1
tfOK     = timeframe.in_seconds() == 60

canEnterVwap = inSess and qcMend >= 572 and qcMend <= 959
isEOD        = inSess and qcMend == 960

// Warning distance: at least the floor, but scaled to how far price
// actually travels in a minute, so the heads-up really is ~1 bar early.
atr1     = ta.atr(14)
proxDist = math.max(proxPts, na(atr1) ? 0.0 : atr1 * proxAtrMult)

// ========================= POSITION SIZING ==========================
var float dayRiskUsed = 0.0
if newSess
    dayRiskUsed := 0.0

f_size(stopPts) =>
    ok     = not na(stopPts) and stopPts > 0
    perCt  = ok ? stopPts * ptVal : 1.0
    remain = math.max(0.0, maxDayRisk - dayRiskUsed)
    budget = math.min(riskPerTrade, remain)
    raw    = int(math.floor(budget / perCt))
    ok ? (raw < 1 and allowMinOne and remain >= perCt ? 1 : raw) : 0

f_riskOf(ct, stopPts) => na(stopPts) ? 0.0 : ct * stopPts * ptVal
f_money(x) => "$" + str.tostring(na(x) ? 0.0 : x, "#")
f_px(x)    => na(x) ? "-" : str.tostring(x, "#.##")

// =========================== VWAP STRATEGY ==========================
var float dOpen  = na
var float dHigh  = na
var float dLow   = na
var float dClose = na
var float pOpen  = na
var float pHigh  = na
var float pLow   = na
var float pClose = na

var array<float> trendHist = array.new_float(0)
var array<float> gapHist   = array.new_float(0)

f_rank(arr, v) =>
    n = array.size(arr)
    cnt = 0
    if n >= 60 and not na(v)
        for i = 0 to n - 1
            if array.get(arr, i) <= v
                cnt += 1
    n >= 60 and not na(v) ? 100.0 * cnt / n : na

var bool  gapOK   = true
var bool  trendOK = true
var float cpv = 0.0
var float cv  = 0.0

if newSess
    pOpen  := dOpen
    pHigh  := dHigh
    pLow   := dLow
    pClose := dClose
    dOpen  := open
    dHigh  := high
    dLow   := low
    dClose := close
    cpv := 0.0
    cv  := 0.0
    gapOK   := true
    trendOK := true
    if not na(pClose)
        ytr = pHigh > pLow ? math.abs(pClose - pOpen) / (pHigh - pLow) : na
        r1  = f_rank(trendHist, ytr)
        trendOK := na(r1) ? true : (r1 <= trendPctl)
        if not na(ytr)
            array.push(trendHist, ytr)
            if array.size(trendHist) > 250
                array.shift(trendHist)
        gp = pClose > 0 ? math.abs(dOpen / pClose - 1.0) : na
        r2 = f_rank(gapHist, gp)
        gapOK := na(r2) ? true : (r2 >= gapPctl)
        if not na(gp)
            array.push(gapHist, gp)
            if array.size(gapHist) > 250
                array.shift(gapHist)
else if inSess
    dHigh  := math.max(dHigh, high)
    dLow   := math.min(dLow, low)
    dClose := close

if inSess
    cpv += ((high + low + close) / 3.0) * volume
    cv  += volume

vwapV = inSess and cv > 0 ? cpv / cv : na
bFrac = bandBps / 10000.0
vUp   = na(vwapV) ? na : vwapV * (1.0 + bFrac)
vDn   = na(vwapV) ? na : vwapV * (1.0 - bFrac)
vGate = gapOK and trendOK

var int    vPos    = 0
var bool   vTraded = false
var float  vEntry  = na
var float  vTPl    = na
var float  vSLl    = na
var int    vCt     = 0
var string vRes    = ""
var float  pnlV    = 0.0

if newSess
    vPos    := 0
    vTraded := false
    vEntry  := na
    vTPl    := na
    vSLl    := na
    vCt     := 0
    vRes    := ""
    pnlV    := 0.0

vJustEntered = false

if useVWAP and inSess and tfOK
    if vPos != 0
        dirn  = vPos
        hitTP = dirn == 1 ? high >= vTPl : low  <= vTPl
        hitSL = dirn == 1 ? low  <= vSLl : high >= vSLl
        if hitSL
            pnlV += -vwapSLp * vCt * ptVal
            vRes := "SL"
            vPos := 0
        else if hitTP
            pnlV += vwapTPp * vCt * ptVal
            vRes := "TP"
            vPos := 0
        else if isEOD
            pnlV += dirn * (close - vEntry) * vCt * ptVal
            vRes := "EOD"
            vPos := 0
    if vPos == 0 and not vTraded and vGate and canEnterVwap and not na(vUp)
        if close > vUp
            vPos    := 1
            vEntry  := close
            vTPl    := close + vwapTPp
            vSLl    := close - vwapSLp
            vTraded := true
            vCt     := f_size(vwapSLp)
            dayRiskUsed += f_riskOf(vCt, vwapSLp)
            vJustEntered := true
        else if close < vDn
            vPos    := -1
            vEntry  := close
            vTPl    := close - vwapTPp
            vSLl    := close + vwapSLp
            vTraded := true
            vCt     := f_size(vwapSLp)
            dayRiskUsed += f_riskOf(vCt, vwapSLp)
            vJustEntered := true

// ========================= ON FADE STRATEGY =========================
inON = qcMend >= 1080 or qcMend <= 570

var float onAccH = na
var float onAccL = na
if inON
    if na(onAccH)
        onAccH := high
        onAccL := low
    else
        onAccH := math.max(onAccH, high)
        onAccL := math.min(onAccL, low)

var float ONH = na
var float ONL = na
var float ONM = na
var float onRange = na
var int   mDir = 0
var int   hSt = 0
var int   lSt = 0
var int   mSt = 0
var float hEn = na
var float hTP = na
var float hSL = na
var float lEn = na
var float lTP = na
var float lSL = na
var float mEn = na
var float mTP = na
var float mSL = na
var int   hCt = 0
var int   lCt = 0
var int   mCt = 0
var float pnlH = 0.0
var float pnlL = 0.0
var float pnlM = 0.0

if newSess
    ONH     := onAccH
    ONL     := onAccL
    ONM     := na(onAccH) or na(onAccL) ? na : (onAccH + onAccL) / 2.0
    onRange := na(onAccH) or na(onAccL) ? na : onAccH - onAccL
    rthOpen = open
    onAccH  := na
    onAccL  := na
    mDir    := na(ONM) ? 0 : (rthOpen > ONM ? 1 : rthOpen < ONM ? -1 : 0)
    hSt := 0
    lSt := 0
    mSt := 0
    hCt := 0
    lCt := 0
    mCt := 0
    hEn := na
    hTP := na
    hSL := na
    lEn := na
    lTP := na
    lSL := na
    mEn := na
    mTP := na
    mSL := na
    pnlH := 0.0
    pnlL := 0.0
    pnlM := 0.0

onRangeOK = not na(onRange) and onRange >= onMinRange

hJustEntered = false
lJustEntered = false
mJustEntered = false

if useON and inSess and tfOK and onRangeOK and not na(ONH)
    if onUseH
        if hSt == 0 and high >= ONH
            hSt := 1
            hEn := ONH
            hTP := ONH - onB
            hSL := ONH + onB
            hCt := f_size(onB)
            dayRiskUsed += f_riskOf(hCt, onB)
            hJustEntered := true
        if hSt == 1
            tp = low  <= hTP
            sl = high >= hSL
            if sl
                pnlH += -onB * hCt * ptVal
                hSt := 3
            else if tp
                pnlH += onB * hCt * ptVal
                hSt := 2
            else if isEOD
                pnlH += (hEn - close) * hCt * ptVal
                hSt := 4
    if onUseL
        if lSt == 0 and low <= ONL
            lSt := 1
            lEn := ONL
            lTP := ONL + onB
            lSL := ONL - onB
            lCt := f_size(onB)
            dayRiskUsed += f_riskOf(lCt, onB)
            lJustEntered := true
        if lSt == 1
            tp = high >= lTP
            sl = low  <= lSL
            if sl
                pnlL += -onB * lCt * ptVal
                lSt := 3
            else if tp
                pnlL += onB * lCt * ptVal
                lSt := 2
            else if isEOD
                pnlL += (close - lEn) * lCt * ptVal
                lSt := 4
    if onUseM and mDir != 0
        if mSt == 0 and high >= ONM and low <= ONM
            mSt := 1
            mEn := ONM
            mTP := ONM + mDir * onB
            mSL := ONM - mDir * onB
            mCt := f_size(onB)
            dayRiskUsed += f_riskOf(mCt, onB)
            mJustEntered := true
        if mSt == 1
            tp = mDir == 1 ? high >= mTP : low  <= mTP
            sl = mDir == 1 ? low  <= mSL : high >= mSL
            if sl
                pnlM += -onB * mCt * ptVal
                mSt := 3
            else if tp
                pnlM += onB * mCt * ptVal
                mSt := 2
            else if isEOD
                pnlM += mDir * (close - mEn) * mCt * ptVal
                mSt := 4

// ========================= HAR-RV STRATEGY ==========================
f_rvAt(i) =>
    [h, l] = request.security(syminfo.tickerid, "D", [high[i], low[i]], barmerge.gaps_off, barmerge.lookahead_off)
    h > l and not na(h) and not na(l) ? (math.log(h / l) * math.log(h / l)) / (4.0 * math.log(2.0)) : 0.0

rv01 = f_rvAt(1)
rv02 = f_rvAt(2)
rv03 = f_rvAt(3)
rv04 = f_rvAt(4)
rv05 = f_rvAt(5)
rv06 = f_rvAt(6)
rv07 = f_rvAt(7)
rv08 = f_rvAt(8)
rv09 = f_rvAt(9)
rv10 = f_rvAt(10)
rv11 = f_rvAt(11)
rv12 = f_rvAt(12)
rv13 = f_rvAt(13)
rv14 = f_rvAt(14)
rv15 = f_rvAt(15)
rv16 = f_rvAt(16)
rv17 = f_rvAt(17)
rv18 = f_rvAt(18)
rv19 = f_rvAt(19)
rv20 = f_rvAt(20)
rv21 = f_rvAt(21)
rv22 = f_rvAt(22)

rvD = rv01
rvW = (rv01 + rv02 + rv03 + rv04 + rv05) / 5.0
rvM = (rv01 + rv02 + rv03 + rv04 + rv05 + rv06 + rv07 + rv08 + rv09 + rv10 +
       rv11 + rv12 + rv13 + rv14 + rv15 + rv16 + rv17 + rv18 + rv19 + rv20 + rv21 + rv22) / 22.0

// oldest sample non-zero => the full 22-day history really is present
harReady = rv22 > 0

var float emove = na
var float hUp = na
var float hDn = na
var int   rSt = 0
var int   rDir = 0
var float rEn = na
var float rTP = na
var float rSL = na
var int   rCt = 0
var float pnlR = 0.0

if newSess
    predVar   = 0.36 * rvD + 0.28 * rvW + 0.28 * rvM
    predSigma = math.sqrt(math.max(predVar, 0.0))
    emove := open * predSigma
    hUp   := open + harK * emove
    hDn   := open - harK * emove
    rSt   := 0
    rDir  := 0
    rEn   := na
    rTP   := na
    rSL   := na
    rCt   := 0
    pnlR  := 0.0

harStop = na(emove) ? na : harSLm * emove
rJustEntered = false

if useHAR and inSess and tfOK and harReady and not na(hUp) and emove > 0
    if rSt == 0
        if close >= hUp
            rSt  := 1
            rDir := 1
            rEn  := close
            rTP  := close + harTPm * emove
            rSL  := close - harSLm * emove
            rCt  := f_size(harStop)
            dayRiskUsed += f_riskOf(rCt, harStop)
            rJustEntered := true
        else if close <= hDn
            rSt  := 1
            rDir := -1
            rEn  := close
            rTP  := close - harTPm * emove
            rSL  := close + harSLm * emove
            rCt  := f_size(harStop)
            dayRiskUsed += f_riskOf(rCt, harStop)
            rJustEntered := true
    if rSt == 1
        tp = rDir == 1 ? high >= rTP : low  <= rTP
        sl = rDir == 1 ? low  <= rSL : high >= rSL
        if sl
            pnlR += -harSLm * emove * rCt * ptVal
            rSt := 3
        else if tp
            pnlR += harTPm * emove * rCt * ptVal
            rSt := 2
        else if isEOD
            pnlR += rDir * (close - rEn) * rCt * ptVal
            rSt := 4

// ====================== PRE-TRADE SIZE PREVIEW ======================
vCtPrev = f_size(vwapSLp)
oCtPrev = f_size(onB)
rCtPrev = na(harStop) ? 0 : f_size(harStop)

// ============================ LEVEL PLOTS ===========================
pVu = plot(showLevelsEff and useVWAP and inSess ? vUp : na, "VWAP +band", color = color.new(color.orange, 55), style = plot.style_linebr)
pVd = plot(showLevelsEff and useVWAP and inSess ? vDn : na, "VWAP -band", color = color.new(color.orange, 55), style = plot.style_linebr)
fill(pVu, pVd, color = color.new(color.orange, 95))
plot(showLevelsEff and useON and inSess ? ONH : na, "ONH",    color = color.new(color.purple, 0),  linewidth = 2, style = plot.style_linebr)
plot(showLevelsEff and useON and inSess ? ONL : na, "ONL",    color = color.new(color.purple, 0),  linewidth = 2, style = plot.style_linebr)
plot(showLevelsEff and useON and inSess ? ONM : na, "ON mid", color = color.new(color.purple, 45), style = plot.style_linebr)
plot(showLevelsEff and useHAR and harReady and inSess ? hUp : na, "HAR up", color = color.new(color.teal, 10), linewidth = 2, style = plot.style_linebr)
plot(showLevelsEff and useHAR and harReady and inSess ? hDn : na, "HAR dn", color = color.new(color.teal, 10), linewidth = 2, style = plot.style_linebr)

// ====================== PERSISTENT TRADE BRACKETS ===================
// Line objects, never deleted, so EVERY past trade keeps its entry / TP
// / SL on the chart. Each bracket is at least brkMinBars long, so a
// trade that opens and closes inside one minute is still visible.
CE = color.new(color.blue,  0)
CT = color.new(color.green, 0)
CS = color.new(color.red,   0)

var line vE = na
var line vT = na
var line vS = na
var int  vB = 0
var line hE = na
var line hT = na
var line hS = na
var int  hB = 0
var line lE = na
var line lT = na
var line lS = na
var int  lB = 0
var line mE = na
var line mT = na
var line mS = na
var int  mB = 0
var line rE = na
var line rT = na
var line rS = na
var int  rB = 0

if showBrk and vJustEntered
    vB := bar_index
    vE := line.new(vB, vEntry, vB + brkMinBars, vEntry, color = CE, width = 2)
    vT := line.new(vB, vTPl,   vB + brkMinBars, vTPl,   color = CT, width = 1)
    vS := line.new(vB, vSLl,   vB + brkMinBars, vSLl,   color = CS, width = 1)
    label.new(vB, vPos == 1 ? low : high, "VWAP " + (vPos == 1 ? "L " : "S ") + str.tostring(vCt) + " " + instr,
         style = vPos == 1 ? label.style_label_up : label.style_label_down,
         color = vPos == 1 ? color.new(color.green, 20) : color.new(color.red, 20),
         textcolor = color.white, size = size.small)
if showBrk and vPos != 0 and not na(vE)
    line.set_x2(vE, math.max(bar_index, vB + brkMinBars))
    line.set_x2(vT, math.max(bar_index, vB + brkMinBars))
    line.set_x2(vS, math.max(bar_index, vB + brkMinBars))

if showBrk and hJustEntered
    hB := bar_index
    hE := line.new(hB, hEn, hB + brkMinBars, hEn, color = CE, width = 2)
    hT := line.new(hB, hTP, hB + brkMinBars, hTP, color = CT, width = 1)
    hS := line.new(hB, hSL, hB + brkMinBars, hSL, color = CS, width = 1)
    label.new(hB, high, "ON-H S " + str.tostring(hCt) + " " + instr, style = label.style_label_down,
         color = color.new(color.red, 20), textcolor = color.white, size = size.small)
if showBrk and hSt == 1 and not na(hE)
    line.set_x2(hE, math.max(bar_index, hB + brkMinBars))
    line.set_x2(hT, math.max(bar_index, hB + brkMinBars))
    line.set_x2(hS, math.max(bar_index, hB + brkMinBars))

if showBrk and lJustEntered
    lB := bar_index
    lE := line.new(lB, lEn, lB + brkMinBars, lEn, color = CE, width = 2)
    lT := line.new(lB, lTP, lB + brkMinBars, lTP, color = CT, width = 1)
    lS := line.new(lB, lSL, lB + brkMinBars, lSL, color = CS, width = 1)
    label.new(lB, low, "ON-L L " + str.tostring(lCt) + " " + instr, style = label.style_label_up,
         color = color.new(color.green, 20), textcolor = color.white, size = size.small)
if showBrk and lSt == 1 and not na(lE)
    line.set_x2(lE, math.max(bar_index, lB + brkMinBars))
    line.set_x2(lT, math.max(bar_index, lB + brkMinBars))
    line.set_x2(lS, math.max(bar_index, lB + brkMinBars))

if showBrk and mJustEntered
    mB := bar_index
    mE := line.new(mB, mEn, mB + brkMinBars, mEn, color = CE, width = 2)
    mT := line.new(mB, mTP, mB + brkMinBars, mTP, color = CT, width = 1)
    mS := line.new(mB, mSL, mB + brkMinBars, mSL, color = CS, width = 1)
    label.new(mB, mDir == 1 ? low : high, "ON-M " + (mDir == 1 ? "L " : "S ") + str.tostring(mCt) + " " + instr,
         style = mDir == 1 ? label.style_label_up : label.style_label_down,
         color = mDir == 1 ? color.new(color.green, 20) : color.new(color.red, 20),
         textcolor = color.white, size = size.small)
if showBrk and mSt == 1 and not na(mE)
    line.set_x2(mE, math.max(bar_index, mB + brkMinBars))
    line.set_x2(mT, math.max(bar_index, mB + brkMinBars))
    line.set_x2(mS, math.max(bar_index, mB + brkMinBars))

if showBrk and rJustEntered
    rB := bar_index
    rE := line.new(rB, rEn, rB + brkMinBars, rEn, color = CE, width = 2)
    rT := line.new(rB, rTP, rB + brkMinBars, rTP, color = CT, width = 1)
    rS := line.new(rB, rSL, rB + brkMinBars, rSL, color = CS, width = 1)
    label.new(rB, rDir == 1 ? low : high, "HAR " + (rDir == 1 ? "L " : "S ") + str.tostring(rCt) + " " + instr,
         style = rDir == 1 ? label.style_label_up : label.style_label_down,
         color = rDir == 1 ? color.new(color.green, 20) : color.new(color.red, 20),
         textcolor = color.white, size = size.small)
if showBrk and rSt == 1 and not na(rE)
    line.set_x2(rE, math.max(bar_index, rB + brkMinBars))
    line.set_x2(rT, math.max(bar_index, rB + brkMinBars))
    line.set_x2(rS, math.max(bar_index, rB + brkMinBars))

// ========================== APPROACH WATCH ==========================
var bool nearV = false
var bool nearH = false
var bool nearL = false
var bool nearM = false
var bool nearR = false
if newSess
    nearV := false
    nearH := false
    nearL := false
    nearM := false
    nearR := false

vNear = useVWAP and inSess and tfOK and vPos == 0 and not vTraded and vGate and canEnterVwap and not na(vUp) and (math.abs(close - vUp) <= proxDist or math.abs(close - vDn) <= proxDist)
hNear = useON and onUseH and inSess and tfOK and onRangeOK and hSt == 0 and not na(ONH) and math.abs(close - ONH) <= proxDist
lNear = useON and onUseL and inSess and tfOK and onRangeOK and lSt == 0 and not na(ONL) and math.abs(close - ONL) <= proxDist
mNear = useON and onUseM and inSess and tfOK and onRangeOK and mSt == 0 and mDir != 0 and not na(ONM) and math.abs(close - ONM) <= proxDist
rNear = useHAR and inSess and tfOK and harReady and rSt == 0 and not na(hUp) and (math.abs(close - hUp) <= proxDist or math.abs(close - hDn) <= proxDist)

vFire = vNear and not nearV
hFire = hNear and not nearH
lFire = lNear and not nearL
mFire = mNear and not nearM
rFire = rNear and not nearR
if vFire
    nearV := true
if hFire
    nearH := true
if lFire
    nearL := true
if mFire
    nearM := true
if rFire
    nearR := true

// ============================== BANNER ==============================
f_join(a, b) => a == "" ? b : a + "\n" + b

nEnt   = 0
nLong  = 0
nShort = 0
eHead  = ""
eBody  = ""

if vJustEntered
    nEnt += 1
    nLong  := nLong  + (vPos ==  1 ? 1 : 0)
    nShort := nShort + (vPos == -1 ? 1 : 0)
    eHead := f_join(eHead, "ENTER  VWAP " + (vPos == 1 ? "LONG" : "SHORT") + "   ->   " + str.tostring(vCt) + " " + instr)
    eBody := f_join(eBody, "entry " + f_px(vEntry) + "    TP " + f_px(vTPl) + "    SL " + f_px(vSLl) + "    risk " + f_money(f_riskOf(vCt, vwapSLp)))
if hJustEntered
    nEnt += 1
    nShort += 1
    eHead := f_join(eHead, "ENTER  ON-H SHORT   ->   " + str.tostring(hCt) + " " + instr)
    eBody := f_join(eBody, "entry " + f_px(hEn) + "    TP " + f_px(hTP) + "    SL " + f_px(hSL) + "    risk " + f_money(f_riskOf(hCt, onB)))
if lJustEntered
    nEnt += 1
    nLong += 1
    eHead := f_join(eHead, "ENTER  ON-L LONG   ->   " + str.tostring(lCt) + " " + instr)
    eBody := f_join(eBody, "entry " + f_px(lEn) + "    TP " + f_px(lTP) + "    SL " + f_px(lSL) + "    risk " + f_money(f_riskOf(lCt, onB)))
if mJustEntered
    nEnt += 1
    nLong  := nLong  + (mDir ==  1 ? 1 : 0)
    nShort := nShort + (mDir == -1 ? 1 : 0)
    eHead := f_join(eHead, "ENTER  ON-M " + (mDir == 1 ? "LONG" : "SHORT") + "   ->   " + str.tostring(mCt) + " " + instr)
    eBody := f_join(eBody, "entry " + f_px(mEn) + "    TP " + f_px(mTP) + "    SL " + f_px(mSL) + "    risk " + f_money(f_riskOf(mCt, onB)))
if rJustEntered
    nEnt += 1
    nLong  := nLong  + (rDir ==  1 ? 1 : 0)
    nShort := nShort + (rDir == -1 ? 1 : 0)
    eHead := f_join(eHead, "ENTER  HAR-RV " + (rDir == 1 ? "LONG" : "SHORT") + "   ->   " + str.tostring(rCt) + " " + instr)
    eBody := f_join(eBody, "entry " + f_px(rEn) + "    TP " + f_px(rTP) + "    SL " + f_px(rSL) + "    risk " + f_money(f_riskOf(rCt, harStop)))

anyNear = vFire or hFire or lFire or mFire or rFire
if nEnt == 0
    if vFire
        eHead := f_join(eHead, "GET READY  VWAP band   ->   " + str.tostring(vCtPrev) + " " + instr)
        eBody := f_join(eBody, "trigger " + f_px(vUp) + " / " + f_px(vDn) + "    TP +/-" + str.tostring(vwapTPp, "#") + "    SL +/-" + str.tostring(vwapSLp, "#") + "    risk " + f_money(f_riskOf(vCtPrev, vwapSLp)))
    if hFire
        eHead := f_join(eHead, "GET READY  ON-H SHORT   ->   " + str.tostring(oCtPrev) + " " + instr)
        eBody := f_join(eBody, "entry " + f_px(ONH) + "    TP " + f_px(ONH - onB) + "    SL " + f_px(ONH + onB) + "    risk " + f_money(f_riskOf(oCtPrev, onB)))
    if lFire
        eHead := f_join(eHead, "GET READY  ON-L LONG   ->   " + str.tostring(oCtPrev) + " " + instr)
        eBody := f_join(eBody, "entry " + f_px(ONL) + "    TP " + f_px(ONL + onB) + "    SL " + f_px(ONL - onB) + "    risk " + f_money(f_riskOf(oCtPrev, onB)))
    if mFire
        eHead := f_join(eHead, "GET READY  ON-M " + (mDir == 1 ? "LONG" : "SHORT") + "   ->   " + str.tostring(oCtPrev) + " " + instr)
        eBody := f_join(eBody, "entry " + f_px(ONM) + "    TP " + f_px(ONM + mDir * onB) + "    SL " + f_px(ONM - mDir * onB) + "    risk " + f_money(f_riskOf(oCtPrev, onB)))
    if rFire
        eHead := f_join(eHead, "GET READY  HAR-RV breakout   ->   " + str.tostring(rCtPrev) + " " + instr)
        eBody := f_join(eBody, "trigger " + f_px(hUp) + " / " + f_px(hDn) + "    TP +/-" + str.tostring(harTPm * emove, "#") + "    SL +/-" + str.tostring(harStop, "#") + "    risk " + f_money(f_riskOf(rCtPrev, harStop)))

var string bHead = ""
var string bBody = ""
var color  bCol  = color.new(color.gray, 0)
var int    bTill = 0
if eHead != ""
    bHead := eHead
    bBody := eBody
    bCol  := nEnt == 0 ? color.new(color.orange, 0) : nShort == 0 ? color.new(color.green, 0) : nLong == 0 ? color.new(color.red, 0) : color.new(color.blue, 0)
    bTill := bar_index + bannerBars

liveTxt = ""
if vPos != 0
    liveTxt := f_join(liveTxt, "VWAP " + (vPos == 1 ? "L " : "S ") + str.tostring(vCt) + " " + instr + "  TP " + f_px(vTPl) + "  SL " + f_px(vSLl))
if hSt == 1
    liveTxt := f_join(liveTxt, "ON-H S " + str.tostring(hCt) + " " + instr + "  TP " + f_px(hTP) + "  SL " + f_px(hSL))
if lSt == 1
    liveTxt := f_join(liveTxt, "ON-L L " + str.tostring(lCt) + " " + instr + "  TP " + f_px(lTP) + "  SL " + f_px(lSL))
if mSt == 1
    liveTxt := f_join(liveTxt, "ON-M " + (mDir == 1 ? "L " : "S ") + str.tostring(mCt) + " " + instr + "  TP " + f_px(mTP) + "  SL " + f_px(mSL))
if rSt == 1
    liveTxt := f_join(liveTxt, "HAR " + (rDir == 1 ? "L " : "S ") + str.tostring(rCt) + " " + instr + "  TP " + f_px(rTP) + "  SL " + f_px(rSL))

bPos = bannerPosIn == "bottom_center" ? position.bottom_center : bannerPosIn == "middle_center" ? position.middle_center : position.top_center
var table BAN = table.new(bPos, 1, 3, border_width = 2, frame_width = 2, frame_color = color.new(color.white, 40))

if barstate.islast
    table.clear(BAN, 0, 0, 0, 2)
    if bHead != "" and bar_index <= bTill
        table.cell(BAN, 0, 0, bHead, bgcolor = bCol, text_color = color.white, text_size = size.large)
        table.cell(BAN, 0, 1, bBody, bgcolor = color.new(bCol, 65), text_color = color.white, text_size = size.normal)
    if liveTxt != ""
        table.cell(BAN, 0, 2, "LIVE   " + liveTxt, bgcolor = color.new(color.blue, 55), text_color = color.white, text_size = size.small)

bgcolor(not flashEff ? na : nEnt > 0 ? color.new(color.blue, 82) : anyNear ? color.new(color.yellow, 90) : na)

// ============================ STATUS TABLE ==========================
// Deliberately minimal: what each leg is doing, and what it made today.
tPos = tblPosIn == "top_left" ? position.top_left : tblPosIn == "bottom_right" ? position.bottom_right : tblPosIn == "bottom_left" ? position.bottom_left : tblPosIn == "middle_right" ? position.middle_right : position.top_right
var table T = table.new(tPos, 3, 7, border_width = 1, frame_width = 1, frame_color = color.new(color.gray, 40))

CH = color.new(color.gray, 85)
CW = color.new(color.gray, 70)
CN = color.new(color.yellow, 55)
CG = color.new(color.green, 60)
CR = color.new(color.red, 60)
CB = color.new(color.blue, 70)
TX = color.white

f_st(st, dirn, isNear) =>
    st == 0 ? (isNear ? "NEAR" : "wait") : st == 1 ? (dirn == 1 ? "LONG" : "SHORT") : st == 2 ? "TP" : st == 3 ? "SL" : "EOD"

f_stC(st, dirn, isNear) =>
    st == 0 ? (isNear ? CN : CW) : st == 1 ? (dirn == 1 ? CG : CR) : CB

f_pnl(x) => (x >= 0 ? "+" : "") + f_money(x)

if showTable and barstate.islast
    table.clear(T, 0, 0, 2, 6)
    dayPnl = pnlV + pnlH + pnlL + pnlM + pnlR
    table.cell(T, 0, 0, tfOK ? "PORTFOLIO" : "WRONG TF!", bgcolor = tfOK ? CH : color.new(color.red, 20), text_color = TX, text_size = size.small)
    table.cell(T, 1, 0, "status", bgcolor = CH, text_color = TX, text_size = size.small)
    table.cell(T, 2, 0, "day P/L", bgcolor = CH, text_color = TX, text_size = size.small)

    vS2 = not useVWAP ? "off" : not vGate ? "gated" : vPos != 0 ? (vPos == 1 ? "LONG" : "SHORT") : vTraded ? vRes : (vNear ? "NEAR" : "wait")
    vC2 = not useVWAP or not vGate ? CW : vPos == 1 ? CG : vPos == -1 ? CR : vTraded ? CB : (vNear ? CN : CW)
    table.cell(T, 0, 1, "VWAP", bgcolor = CW, text_color = TX, text_size = size.small)
    table.cell(T, 1, 1, vS2, bgcolor = vC2, text_color = TX, text_size = size.small)
    table.cell(T, 2, 1, f_pnl(pnlV), bgcolor = pnlV >= 0 ? CG : CR, text_color = TX, text_size = size.small)

    hS2 = not useON or not onUseH ? "off" : not onRangeOK ? "gated" : f_st(hSt, -1, hNear)
    table.cell(T, 0, 2, "ON-H", bgcolor = CW, text_color = TX, text_size = size.small)
    table.cell(T, 1, 2, hS2, bgcolor = not useON or not onUseH or not onRangeOK ? CW : f_stC(hSt, -1, hNear), text_color = TX, text_size = size.small)
    table.cell(T, 2, 2, f_pnl(pnlH), bgcolor = pnlH >= 0 ? CG : CR, text_color = TX, text_size = size.small)

    lS2 = not useON or not onUseL ? "off" : not onRangeOK ? "gated" : f_st(lSt, 1, lNear)
    table.cell(T, 0, 3, "ON-L", bgcolor = CW, text_color = TX, text_size = size.small)
    table.cell(T, 1, 3, lS2, bgcolor = not useON or not onUseL or not onRangeOK ? CW : f_stC(lSt, 1, lNear), text_color = TX, text_size = size.small)
    table.cell(T, 2, 3, f_pnl(pnlL), bgcolor = pnlL >= 0 ? CG : CR, text_color = TX, text_size = size.small)

    mS2 = not useON or not onUseM ? "off" : not onRangeOK ? "gated" : mDir == 0 ? "skip" : f_st(mSt, mDir, mNear)
    table.cell(T, 0, 4, "ON-M", bgcolor = CW, text_color = TX, text_size = size.small)
    table.cell(T, 1, 4, mS2, bgcolor = not useON or not onUseM or not onRangeOK ? CW : f_stC(mSt, mDir, mNear), text_color = TX, text_size = size.small)
    table.cell(T, 2, 4, f_pnl(pnlM), bgcolor = pnlM >= 0 ? CG : CR, text_color = TX, text_size = size.small)

    rS2 = not useHAR ? "off" : not harReady ? "warmup" : f_st(rSt, rDir, rNear)
    table.cell(T, 0, 5, "HAR-RV", bgcolor = CW, text_color = TX, text_size = size.small)
    table.cell(T, 1, 5, rS2, bgcolor = not useHAR or not harReady ? CW : f_stC(rSt, rDir, rNear), text_color = TX, text_size = size.small)
    table.cell(T, 2, 5, f_pnl(pnlR), bgcolor = pnlR >= 0 ? CG : CR, text_color = TX, text_size = size.small)

    table.cell(T, 0, 6, "TOTAL", bgcolor = CH, text_color = TX, text_size = size.normal)
    table.cell(T, 1, 6, "risk " + f_money(dayRiskUsed), bgcolor = CH, text_color = TX, text_size = size.small)
    table.cell(T, 2, 6, f_pnl(dayPnl), bgcolor = dayPnl >= 0 ? color.new(color.green, 40) : color.new(color.red, 40), text_color = TX, text_size = size.normal)

// =========================== TF WARNING =============================
var label warnLab = na
if barstate.islast
    label.delete(warnLab)
    if not tfOK
        warnLab := label.new(bar_index, high, "SWITCH TO 1-MINUTE CHART\nsignals are disabled",
             style = label.style_label_down, color = color.new(color.red, 10), textcolor = color.white, size = size.large)
