// @version=5
indicator("TradeAxis DOL (approx)", overlay=true, max_lines_count=200, max_boxes_count=200, max_labels_count=100)

// =========================================================================
// Approximation of TradeAxis DOL — commercial indicator.
// We cannot see the source. This replicates the 4-pillar scoring recipe:
//   Score = Proximity + Freshness + Confluence + Density  (0..100)
// Level types scored: Buy-Side Liquidity (swing highs), Sell-Side Liquidity
//   (swing lows), bullish FVG, bearish FVG.
// Highest-scored above price = primary BSL target (zone drawn in blue).
// Highest-scored below price = primary SSL target (zone drawn in orange).
//
// FILTER: default threshold 75 — only this bucket showed a measurable edge
// on NQ 2018-2025 QC backtest (+33pp hit-rate above matched-dist base rate,
// z=+5.9). The table shows current scores regardless of threshold so you
// can see "watch" (65-74) and "trade" (75+) regimes.
// =========================================================================

// --- INPUTS ------------------------------------------------------------
mode     = input.string("Day", "Trading Mode", options=["Swing","Day","Scalp"])
atrLen   = input.int(14, "ATR length", minval=2)
maxAtr   = input.float(4.0, "Max ATR distance (eject)", step=0.5)
halfLife = input.int(50,  "Freshness half-life (bars)", minval=5)
pivotLen = input.int(5,   "Pivot length (swing H/L)", minval=2)
// Level detection TF: targets come from this TF regardless of chart TF.
// Flip chart 1m/3m/5m — the target stays the same. Default per mode:
//   Swing="60", Day="15", Scalp="5". Override here if you want something else.
levelTFin = input.string("auto", "Level detection TF", options=["auto","1","3","5","15","30","60","240","D"])
// Score threshold: 75+ is the only bucket with proven edge on NQ 2018-2025
// (QC backtest: +33pp hit-rate PF=2.64). Below 75 is still drawn but dimmer.
// By default: show something always, let brightness tier the quality.
minPoT    = input.float(0.0, "Minimum PoT% (0 = always show the top one)", step=5)
tradePoT  = input.float(75.0, "Trade-grade PoT (bright glow above this)", step=5)
zonePct   = input.float(0.05, "Zone half-width (* ATR)", step=0.02)
trajLen   = input.int(30, "Trajectory length (bars back for funnel base)", minval=5)
showGhost = input.bool(false, "Show Ghost trail (prior swept levels)")
showBias  = input.bool(false, "Show MTF Bias table")
tblPos    = input.string("top_right", "Bias table position", options=["top_right","top_left","bottom_right","bottom_left"])

// pick TF strings per mode
htfTF = mode == "Swing" ? "D" : mode == "Day" ? "240" : "60"
mtfTF = mode == "Swing" ? "240" : mode == "Day" ? "60"  : "15"
ltfTF = mode == "Swing" ? "60"  : mode == "Day" ? "15"  : "5"
// If user left it on "auto", pick a sensible level-detection TF per mode:
//   Swing uses 1H, Day uses 15m, Scalp uses 5m.
autoTF   = mode == "Swing" ? "60" : mode == "Day" ? "15" : "5"
levelTF  = levelTFin == "auto" ? autoTF : levelTFin

atr = ta.atr(atrLen)

// --- HTF BIAS (candle-body breaks via nested call on security) --------
f_bias() =>
    ph = ta.pivothigh(high, 5, 5)
    pl = ta.pivotlow(low, 5, 5)
    var float lastPH = na
    var float lastPL = na
    if not na(ph)
        lastPH := ph
    if not na(pl)
        lastPL := pl
    var int b = 0
    if not na(lastPH) and close > lastPH
        b := 1
    if not na(lastPL) and close < lastPL
        b := -1
    b

[htfBias] = request.security(syminfo.tickerid, htfTF, [f_bias()], lookahead=barmerge.lookahead_off)
[mtfBias] = request.security(syminfo.tickerid, mtfTF, [f_bias()], lookahead=barmerge.lookahead_off)
[ltfBias] = request.security(syminfo.tickerid, ltfTF, [f_bias()], lookahead=barmerge.lookahead_off)

// --- PDH / PDL (confluence anchors) -----------------------------------
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)
pdc = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)
pdEq = (pdh + pdl) / 2

// --- LEVEL POOL (arrays of candidate liquidity levels) ----------------
// Each level: price, birthBar, kind, swept(0/1), tfWeight (chart-bars per
// 1 "native" bar on the source TF — chart=1, HTF=levelTF_min/chartMin).
var array<float> lvl_px   = array.new<float>()
var array<int>   lvl_bar  = array.new<int>()
var array<int>   lvl_kind = array.new<int>()
var array<int>   lvl_swp  = array.new<int>()
var array<float> lvl_tfw  = array.new<float>()

f_add(px, kind, tfw) =>
    array.push(lvl_px, px)
    array.push(lvl_bar, bar_index)
    array.push(lvl_kind, kind)
    array.push(lvl_swp, 0)
    array.push(lvl_tfw, tfw)

// TF ratio: how many chart bars = 1 bar on levelTF
f_tfMin(tf) =>
    tf == "D" ? 1440.0 : tf == "W" ? 10080.0 : tf == "M" ? 43200.0 : nz(str.tonumber(tf), 1.0)
chartMin = timeframe.multiplier * (timeframe.isminutes ? 1.0 : timeframe.isdaily ? 1440.0 : timeframe.isweekly ? 10080.0 : 60.0)
levelMin = f_tfMin(levelTF)
htfWeight = math.max(levelMin / math.max(chartMin, 1.0), 1.0)

// --- DETECTION: chart TF (always) + levelTF (if different) -----------
chPH = ta.pivothigh(high, pivotLen, pivotLen)
chPL = ta.pivotlow(low,  pivotLen, pivotLen)
if barstate.isconfirmed and not na(chPH)
    f_add(chPH, 1, 1.0)
if barstate.isconfirmed and not na(chPL)
    f_add(chPL, 2, 1.0)
if barstate.isconfirmed and low > high[2]
    f_add((low + high[2]) / 2, 3, 1.0)
if barstate.isconfirmed and high < low[2]
    f_add((high + low[2]) / 2, 4, 1.0)

f_detectAll() =>
    _ph = ta.pivothigh(high, pivotLen, pivotLen)
    _pl = ta.pivotlow(low,  pivotLen, pivotLen)
    _bu = low > high[2]  ? (low + high[2]) / 2 : na
    _be = high < low[2]  ? (high + low[2]) / 2 : na
    [_ph, _pl, _bu, _be]

useHTF = levelTF != timeframe.period
[detPH, detPL, detBuFVG, detBeFVG] = request.security(syminfo.tickerid, levelTF, f_detectAll(), lookahead=barmerge.lookahead_off)

if useHTF and barstate.isconfirmed and not na(detPH) and (na(detPH[1]) or detPH != detPH[1])
    f_add(detPH, 1, htfWeight)
if useHTF and barstate.isconfirmed and not na(detPL) and (na(detPL[1]) or detPL != detPL[1])
    f_add(detPL, 2, htfWeight)
if useHTF and barstate.isconfirmed and not na(detBuFVG) and (na(detBuFVG[1]) or detBuFVG != detBuFVG[1])
    f_add(detBuFVG, 3, htfWeight)
if useHTF and barstate.isconfirmed and not na(detBeFVG) and (na(detBeFVG[1]) or detBeFVG != detBeFVG[1])
    f_add(detBeFVG, 4, htfWeight)

// --- SWEEP DETECTION (mark as ghost) ----------------------------------
// Sweep detection — a level is "hit" the moment price enters its ZONE,
// not when it reaches the exact pivot price. Zone edge = px -/+ zonePct*ATR.
// Runs on every tick during live bar so the display flips immediately.
zoneHalf = zonePct * atr
if barstate.isconfirmed or barstate.islast
    n = array.size(lvl_px)
    i = 0
    while i < n
        px   = array.get(lvl_px, i)
        kind = array.get(lvl_kind, i)
        swp  = array.get(lvl_swp, i)
        if swp == 0
            // upside targets: swept when high enters zone (reaches px - half)
            swept = false
            if (kind == 1 or kind == 3) and high >= px - zoneHalf
                swept := true
            // downside targets: swept when low enters zone (reaches px + half)
            if (kind == 2 or kind == 4) and low  <= px + zoneHalf
                swept := true
            if swept
                array.set(lvl_swp, i, 1)
        i += 1

// --- SCORING ----------------------------------------------------------
// returns score 0..100. tfw = TF weight (chart bars per native bar of
// source TF). Chart=1, HTF>1. Freshness age is divided by tfw so a 15m
// level ages 1 "bar" per 15 chart bars, not 1 per chart tick.
// Rebalanced scoring to favor the "biggest liquidity magnet" over the
// nearest pivot. Proximity plateaus within 1.5 ATR (indicator doesn't
// discriminate between "very close" and "close enough to be actionable")
// then decays linearly to 0 at maxAtr. Density + confluence get more
// weight — those are the signatures of real liquidity, not distance.
f_score(px, birthBar, kind, tfw) =>
    dAtr = math.abs(close - px) / math.max(atr, syminfo.mintick)
    // Proximity: 0..20, plateau to 1.5 ATR, decay after
    prox = dAtr >= maxAtr ? 0.0 : dAtr <= 1.5 ? 20.0 : (1.0 - (dAtr - 1.5) / math.max(maxAtr - 1.5, 0.01)) * 20.0
    // Freshness: 0..25 (TF-weighted age)
    age = (bar_index - birthBar) / math.max(tfw, 1.0)
    fresh = math.pow(0.5, age / math.max(halfLife, 1)) * 25.0
    // Confluence: 0..30 — PDH/PDL stronger, HTF bonus +10, bias +5
    tol = 0.2 * math.max(atr, syminfo.mintick)
    conf = 0.0
    if math.abs(px - pdh) <= tol
        conf += 12
    if math.abs(px - pdl) <= tol
        conf += 12
    if math.abs(px - pdc) <= tol
        conf += 6
    if math.abs(px - pdEq) <= tol
        conf += 5
    aligned = (htfBias == 1 and (kind == 1 or kind == 3) and px > close) or (htfBias == -1 and (kind == 2 or kind == 4) and px < close)
    if aligned
        conf += 5
    // HTF structural bonus: pivots from a higher TF carry more weight
    if tfw > 1.0
        conf += 10
    conf := math.min(conf, 30)
    // Density: 0..25 — equal highs/lows cluster near px over last 30 bars
    tolD = 0.15 * math.max(atr, syminfo.mintick)
    dens = 0.0
    for j = 0 to 29
        if math.abs(high[j] - px) <= tolD or math.abs(low[j] - px) <= tolD
            dens += 2.5
    dens := math.min(dens, 25)
    prox + fresh + conf + dens

// --- FIND PRIMARY TARGETS --------------------------------------------
var float topBSL_px = na
var float topBSL_sc = na
var float topSSL_px = na
var float topSSL_sc = na

// Run on EVERY tick during the live bar (barstate.islast) + every confirmed
// bar — so PoT updates live as price moves and the winner can flip when
// another level overtakes.
if barstate.isconfirmed or barstate.islast
    best_above_px = float(na)
    best_above_sc = -1.0
    best_below_px = float(na)
    best_below_sc = -1.0
    n = array.size(lvl_px)
    i = 0
    while i < n
        if array.get(lvl_swp, i) == 0
            px   = array.get(lvl_px, i)
            birth= array.get(lvl_bar, i)
            kind = array.get(lvl_kind, i)
            tfw  = array.get(lvl_tfw, i)
            sc = f_score(px, birth, kind, tfw)
            // ATR distance eject
            dAtr = math.abs(close - px) / math.max(atr, syminfo.mintick)
            if dAtr <= maxAtr
                // Only BSL (1) or bullFVG (3) qualify as upside target if above price
                if px > close and (kind == 1 or kind == 3)
                    if sc > best_above_sc
                        best_above_sc := sc
                        best_above_px := px
                if px < close and (kind == 2 or kind == 4)
                    if sc > best_below_sc
                        best_below_sc := sc
                        best_below_px := px
        i += 1
    topBSL_px := best_above_px
    topBSL_sc := best_above_sc
    topSSL_px := best_below_px
    topSSL_sc := best_below_sc

// --- POT% -------------------------------------------------------------
// PoT = clamp( score, 0..95 ). The commercial original uses tick-by-tick
// unclosed data — approximation uses confirmed-bar score.
potBSL = na(topBSL_sc) ? na : math.min(topBSL_sc, 95.0)
potSSL = na(topSSL_sc) ? na : math.min(topSSL_sc, 95.0)

// --- DRAW SINGLE PRIMARY TARGET (matches commercial design) -----------
// Pick the WINNING side — highest-scored of BSL vs SSL, drawn as a thin
// bright zone with a dashed diagonal trajectory from current price up/down
// to the target, plus a floating label "Target: KIND  PoT: XX.X%".

f_kindTag(k) =>
    k == 1 ? "BSL" : k == 2 ? "SSL" : k == 3 ? "BUFVG" : k == 4 ? "BEFVG" : "?"

// --- RENDER (match commercial design) ---------------------------------
// Zone = bright white laser-bar with purple glow halo (3 layered boxes).
// Trajectory = dotted funnel: two lines from zone edges back to current
// price point, forming a cone of possibility.
// Label = dark pill at left edge of zone with "Target: KIND\nPoT: XX.X%".
var box   zoneCore  = na
var box   zoneGlow1 = na
var box   zoneGlow2 = na
var label zoneLbl   = na
var line  trajTop   = na
var line  trajBot   = na

if barstate.islast
    if not na(zoneCore)
        box.delete(zoneCore)
    if not na(zoneGlow1)
        box.delete(zoneGlow1)
    if not na(zoneGlow2)
        box.delete(zoneGlow2)
    if not na(zoneLbl)
        label.delete(zoneLbl)
    if not na(trajTop)
        line.delete(trajTop)
    if not na(trajBot)
        line.delete(trajBot)

    winAbove = (not na(potBSL)) and ((na(potSSL)) or potBSL >= potSSL)
    winPx = winAbove ? topBSL_px : topSSL_px
    winPot = winAbove ? potBSL : potSSL

    winKind = 0
    if not na(winPx)
        nL = array.size(lvl_px)
        iL = nL - 1
        while iL >= 0 and winKind == 0
            if array.get(lvl_swp, iL) == 0 and array.get(lvl_px, iL) == winPx
                winKind := array.get(lvl_kind, iL)
            iL -= 1

    if not na(winPx) and not na(winPot) and winPot >= minPoT
        half = zonePct * atr
        isTrade = winPot >= tradePoT
        leftBar  = bar_index - trajLen
        rightBar = bar_index + 25

        // 3 layered boxes: outer halo -> mid glow -> bright white core
        haloCol  = color.new(#B98BFF, isTrade ? 82 : 90)   // soft outer
        midCol   = color.new(#9B6DFF, isTrade ? 60 : 78)   // mid lavender
        coreCol  = color.new(color.white, isTrade ? 0 : 25)
        borderC  = color.new(color.white, isTrade ? 0 : 50)

        zoneGlow2 := box.new(leftBar, winPx + half*5, rightBar, winPx - half*5, bgcolor=haloCol, border_color=na, extend=extend.right)
        zoneGlow1 := box.new(leftBar, winPx + half*2, rightBar, winPx - half*2, bgcolor=midCol,  border_color=na, extend=extend.right)
        zoneCore  := box.new(leftBar, winPx + half*0.4, rightBar, winPx - half*0.4, bgcolor=coreCol, border_color=borderC, border_width=1, extend=extend.right)

        // funnel trajectory — two dotted lines from current price up/down to zone edges
        funnelCol = color.new(color.white, isTrade ? 45 : 70)
        trajTop := line.new(bar_index, close, leftBar, winPx + half, color=funnelCol, style=line.style_dotted, width=1)
        trajBot := line.new(bar_index, close, leftBar, winPx - half, color=funnelCol, style=line.style_dotted, width=1)

        // dark rounded label at the LEFT edge of zone
        txt = "Target: " + f_kindTag(winKind) + "\nPoT: " + str.tostring(winPot, "#.#") + "%"
        zoneLbl := label.new(leftBar - 2, winPx, txt, color=color.new(#1A1A1A, 5), textcolor=color.white, style=label.style_label_right, size=size.small, textalign=text.align_left)

// --- GHOST TRAIL ------------------------------------------------------
// draw last-N swept levels as faded lines (approximation)
if showGhost and barstate.islast
    n = array.size(lvl_px)
    draw = 0
    i = n - 1
    while i >= 0 and draw < 12
        if array.get(lvl_swp, i) == 1
            px = array.get(lvl_px, i)
            birth = array.get(lvl_bar, i)
            kind = array.get(lvl_kind, i)
            col = (kind == 1 or kind == 3) ? color.new(color.aqua, 70) : color.new(color.orange, 70)
            line.new(birth, px, bar_index, px, color=col, style=line.style_dotted)
            draw += 1
        i -= 1

// --- MTF BIAS TABLE ---------------------------------------------------
f_biasStr(b) => b == 1 ? "BULL" : b == -1 ? "BEAR" : "NEUT"
f_biasCol(b) => b == 1 ? color.new(color.green, 20) : b == -1 ? color.new(color.red, 20) : color.new(color.gray, 50)

// Current primary scores (always shown, even when below minPoT) so you
// know the indicator is working even on quiet bars.
// treat -1 sentinel (no live level this side) as NA so table shows "--"
f_scoreCell(sc) =>
    (na(sc) or sc < 0) ? "--" : sc >= 75 ? "** " + str.tostring(sc, "#.#") + " **" : sc >= 60 ? str.tostring(sc, "#.#") + " watch" : str.tostring(sc, "#.#")
f_scoreCol(sc) =>
    (na(sc) or sc < 0) ? color.new(color.gray, 50) : sc >= 75 ? color.new(color.green, 20) : sc >= 60 ? color.new(color.olive, 30) : color.new(color.gray, 40)

tblPosition = tblPos == "top_left" ? position.top_left : tblPos == "bottom_right" ? position.bottom_right : tblPos == "bottom_left" ? position.bottom_left : position.top_right
var table tbl = table.new(tblPosition, 2, 7, border_width=1)
if showBias and barstate.islast
    table.cell(tbl, 0, 0, "TF", bgcolor=color.new(color.navy, 20), text_color=color.white)
    table.cell(tbl, 1, 0, "Bias", bgcolor=color.new(color.navy, 20), text_color=color.white)
    table.cell(tbl, 0, 1, "HTF " + htfTF, bgcolor=color.new(color.black, 30), text_color=color.white)
    table.cell(tbl, 1, 1, f_biasStr(htfBias), bgcolor=f_biasCol(htfBias), text_color=color.white)
    table.cell(tbl, 0, 2, "MTF " + mtfTF, bgcolor=color.new(color.black, 30), text_color=color.white)
    table.cell(tbl, 1, 2, f_biasStr(mtfBias), bgcolor=f_biasCol(mtfBias), text_color=color.white)
    table.cell(tbl, 0, 3, "LTF " + ltfTF, bgcolor=color.new(color.black, 30), text_color=color.white)
    table.cell(tbl, 1, 3, f_biasStr(ltfBias), bgcolor=f_biasCol(ltfBias), text_color=color.white)
    table.cell(tbl, 0, 4, "Levels", bgcolor=color.new(color.purple, 30), text_color=color.white)
    table.cell(tbl, 1, 4, "TF " + levelTF, bgcolor=color.new(color.purple, 50), text_color=color.white)
    table.cell(tbl, 0, 5, "BSL sc", bgcolor=color.new(color.aqua, 60), text_color=color.white)
    table.cell(tbl, 1, 5, f_scoreCell(topBSL_sc), bgcolor=f_scoreCol(topBSL_sc), text_color=color.white)
    table.cell(tbl, 0, 6, "SSL sc", bgcolor=color.new(color.orange, 60), text_color=color.white)
    table.cell(tbl, 1, 6, f_scoreCell(topSSL_sc), bgcolor=f_scoreCol(topSSL_sc), text_color=color.white)
