// @version=5
// =====================================================================
// DO NOT TRADE (2026-10-18). The backtest behind this indicator skipped
// the 09:30 entry bar when checking the stop. Counting it, 82% of entries
// stop out inside the first five minutes and expectancy is zero
// (2022-2025: -1.46 pt per trade). Kept only for reference.
// =====================================================================
indicator("Lucid 4/4 Overnight Gap Reversal", overlay=true, max_labels_count=500, max_lines_count=500)

// Long the RTH open after a weak overnight gap, flat at 15:55.
// Della Corte & Kosowski, overnight-to-intraday reversal.
//
// Verified on QuantConnect minute data 2018-2025 (475 trades). The edge did
// survive the period the local daily panel could not reach: +2.38 pt per
// trade over 2018-2020 against +8.91 over 2021-2025.
//
// It is a lottery ticket, so expect it to feel bad. Roughly 85% of entries
// stop out for a small loss and the remaining 15% run to the close, several
// of them for over +300. Do not widen the stop after a losing streak: the
// winners run to the close regardless of stop width, so the stop only sets
// what the many losers cost. A sweep of every stop definition confirms it --
// 0.05% of price passes at 82.2%, one ATR at 59.6%.
//
// The stop is a percentage rather than a point count on purpose. The old
// fixed 15 points was fitted where NQ traded near 5,000, making it 0.30% of
// price; at 22,000 the same number is 0.07%. Expressed in percent it stops
// drifting as the index rises. At 30,000 this works out near 15 points.
//
// The hard 15-point stop is what makes it usable on a trailing-drawdown
// account. Stopping at one full gap width instead lifts the worst trade to
// -283 pt and pushes the portfolio bust rate from 19% to 33%; capping it
// keeps the same edge with the left tail cut off.
//
// Long leg only. The short-after-strong-gap leg earns about a quarter as
// much (+0.52 vs +2.21 per trade) and overlaps the long-only ORB book.

gapThr  = input.float(0.25, "Min gap below prior close (%)") / 100.0
stopPct = input.float(0.05, "Hard stop (% of price)") / 100.0
volCeil = input.float(0.30, "Max 20d realised vol (skip day above this)")

// See lucid_1 for the rationale behind the volatility gate.
rvol20 = request.security(syminfo.tickerid, "D", ta.stdev(close / close[1] - 1.0, 20) * math.sqrt(252), lookahead=barmerge.lookahead_off)
volOK = na(rvol20) or rvol20 < volCeil

hET = hour(time, "America/New_York")
mET = minute(time, "America/New_York")
etMin = hET * 60 + mET
dow = dayofweek(time, "America/New_York")
skip = dow == dayofweek.wednesday
rth = not na(time(timeframe.period, "0930-1600", "America/New_York"))
rthS = rth and not nz(rth[1], false)

// Prior session's RTH close, captured as the session rolls over.
var float prevClose = na
var float runClose = na
if rth
    runClose := close
if rthS and not na(runClose[1])
    prevClose := runClose[1]

var float cE = na
var float cS = na
var int cBar = na
var line cEl = na
var line cSl = na
var bool cDn = false
cDay = year * 10000 + month * 100 + dayofmonth
dChg = ta.change(cDay) != 0
if dChg
    cDn := false

plotEnt = na(cE) ? na : cE
plotSL = na(cE) ? na : cS

// The gap is only readable on the first RTH bar of the session.
if rthS and volOK and not cDn and not skip and not na(prevClose) and barstate.isconfirmed
    gap = (open - prevClose) / prevClose
    if gap <= -gapThr
        sz = math.min(math.abs(open - prevClose), open * stopPct)
        cE := open
        cS := open - sz
        cBar := bar_index
        cEl := line.new(bar_index, cE, bar_index + 5, cE, color=color.yellow, width=3, extend=extend.right)
        cSl := line.new(bar_index, cS, bar_index + 5, cS, color=color.red, width=3, extend=extend.right)
        label.new(bar_index, low, "GAP LONG\n" + str.tostring(gap * 100, "#.##") + "%", color=color.aqua, textcolor=color.black, style=label.style_label_up, size=size.normal)

if not na(cE)
    rsn = ""
    px = 0.0
    if low <= cS
        rsn := "SL"
        px := cS
    else if etMin >= 955 or dChg
        rsn := "EOD"
        px := close
    if rsn != ""
        pnl = px - cE
        endBar = math.max(bar_index, cBar + 5)
        line.set_x2(cEl, endBar)
        line.set_x2(cSl, endBar)
        line.set_extend(cEl, extend.none)
        line.set_extend(cSl, extend.none)
        clr = pnl >= 0 ? color.green : color.red
        label.new(bar_index, px, "GAP " + rsn + " " + str.tostring(pnl, "+#.#"), color=clr, textcolor=color.white, style=label.style_label_down, size=size.small)
        cE := na
        cDn := true

plot(plotEnt, "entry mark", color=color.new(color.yellow, 0), linewidth=2, style=plot.style_cross)
plot(plotSL, "SL mark", color=color.new(color.red, 0), linewidth=2, style=plot.style_cross)
plot(rth ? prevClose : na, "prior RTH close", color=color.new(color.gray, 40), style=plot.style_linebr)
