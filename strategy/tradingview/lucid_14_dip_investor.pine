// @version=5
indicator("Lucid 14 — Dip investor (long-term, buy big drops)", overlay=true, max_labels_count=500)

// =========================================================================
// LONG-TERM INVESTING, NOT A PROP RULE (owner idea 2026-11-05 from a video).
// DAILY OR WEEKLY CHART (QQQ / SPY / NQ1! / ES1!). Positions are held for months.
// v2 2026-11-05: weekly chart like the owner's video - the high lookback is one
// year in either timeframe (252 days / 52 weeks); the SMAs are chart bars
// (weekly chart: 50-week and 200-week SMA, as in the video).
//   purple = 1-year high (the "target" line), yellow = SMA50, red = SMA200
//   BUY 1/3 at -10%, BUY 2/3 at -20%, BUY 3/3 at -30% below the 252-day high
//   TARGET = the close regains the 252-day high of the moment of the first buy
//   -> sell the dip tranches (a core position, if you hold one, stays).
//   Optional -20% stop from the first buy (off by default).
// Backtest QQQ / SPY 1999-2026, adjusted daily closes (strategy/quantconnect/
// inqc/dip_invest_inqc.py, results/dip_invest_inqc_raw.txt):
//   every drawdown episode eventually regained the high (QQQ 2000 only after
//   15 years, -78% on the way); one buy at -20%, out at the high: QQQ 5 trades
//   +27..+34%, SPY 4 trades +26..+37%; as a stand-alone model it earns LESS
//   than buy-and-hold (CAGR 4-5% vs 8.1-8.4%: mostly in cash during rallies).
//   Best use: a cash reserve spent on drops next to a core holding - 70% core
//   + 30% dip reserve: QQQ 7.4% vs 6.8% (same reserve kept in cash), SPY 7.5%
//   vs 7.1%, but deeper drawdowns (QQQ -81% vs -59%).
// =========================================================================

lvl1 = input.float(10.0, "Tranche 1 at drawdown (%)") / 100.0
lvl2 = input.float(20.0, "Tranche 2 at drawdown (%)") / 100.0
lvl3 = input.float(30.0, "Tranche 3 at drawdown (%)") / 100.0
lookD = input.int(252, "High lookback on a daily chart (days)")
lookW = input.int(52, "High lookback on a weekly chart (weeks)")
len1 = input.int(50, "Yellow SMA length (chart bars)")
len2 = input.int(200, "Red SMA length (chart bars)")
lookback = timeframe.isweekly ? lookW : lookD
useStop = input.bool(false, "Use a stop from the first buy")
stopPct = input.float(20.0, "Stop (%)") / 100.0
showMA = input.bool(true, "Show SMA50 / SMA200")

hiN = ta.highest(close, lookback)
sma50 = ta.sma(close, len1)
sma200 = ta.sma(close, len2)
dd = close / hiN - 1.0

var float tgt = na
var int nb = 0
var float firstBuy = na
var bool waitHigh = false

if waitHigh and close >= hiN
    waitHigh := false

startEp = na(tgt) and not waitHigh and dd <= -lvl1
if startEp
    tgt := hiN
    nb := 0

if not na(tgt)
    if nb == 0 and close <= tgt * (1 - lvl1)
        nb := 1
        firstBuy := close
        label.new(bar_index, low, "BUY 1/3", color=color.new(color.green, 0), textcolor=color.white, style=label.style_label_up, size=size.small)
    if nb == 1 and close <= tgt * (1 - lvl2)
        nb := 2
        label.new(bar_index, low, "BUY 2/3", color=color.new(color.green, 0), textcolor=color.white, style=label.style_label_up, size=size.small)
    if nb == 2 and close <= tgt * (1 - lvl3)
        nb := 3
        label.new(bar_index, low, "BUY 3/3", color=color.new(color.green, 0), textcolor=color.white, style=label.style_label_up, size=size.small)
    if close >= tgt
        label.new(bar_index, high, "TARGET\nsell dip buys", color=color.new(color.purple, 0), textcolor=color.white, style=label.style_label_down, size=size.small)
        tgt := na
        nb := 0
        firstBuy := na
    else if useStop and not na(firstBuy) and close <= firstBuy * (1 - stopPct)
        label.new(bar_index, high, "STOP", color=color.new(color.red, 0), textcolor=color.white, style=label.style_label_down, size=size.small)
        tgt := na
        nb := 0
        firstBuy := na
        waitHigh := true

pHi = plot(hiN, "1-year high", color=color.new(color.purple, 0), linewidth=2, style=plot.style_stepline)
p50 = plot(showMA ? sma50 : na, "Yellow SMA", color=color.new(color.yellow, 0), linewidth=2)
p200 = plot(showMA ? sma200 : na, "Red SMA", color=color.new(color.red, 0), linewidth=2)
fill(p50, p200, color=color.new(color.green, 90))
plot(not na(tgt) ? tgt : na, "Episode target", color=color.new(color.purple, 40), style=plot.style_linebr, linewidth=1)
plot(not na(tgt) and nb < 3 ? tgt * (1 - (nb == 0 ? lvl1 : nb == 1 ? lvl2 : lvl3)) : na, "Next buy level", color=color.new(color.green, 30), style=plot.style_linebr)

var table tb = table.new(position.top_right, 1, 3, border_width=1, bgcolor=color.new(color.black, 30))
if barstate.islast
    st = not (timeframe.isdaily or timeframe.isweekly) ? "use a DAILY or WEEKLY chart" : not na(tgt) ? "episode open: " + str.tostring(nb) + "/3 bought, target " + str.tostring(tgt, format.mintick) : waitHigh ? "stopped - waiting for a new high" : "no episode (drawdown < " + str.tostring(lvl1 * 100, "#") + "%)"
    table.cell(tb, 0, 0, "LUCID 14 · DIP INVESTOR (long-term)", text_color=color.white, bgcolor=color.new(color.purple, 40))
    table.cell(tb, 0, 1, "drawdown from the 1-year high: " + str.tostring(dd * 100, "#.0") + "% | red SMA " + (sma200 > sma200[timeframe.isweekly ? 4 : 20] ? "rising" : "falling"), text_color=color.white)
    table.cell(tb, 0, 2, st, text_color=color.white, bgcolor=not na(tgt) ? color.new(color.green, 30) : color.new(color.gray, 50))
