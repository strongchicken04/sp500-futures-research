// @version=5
indicator("MA Ribbon SHIFT + FVG + Key Area", overlay=true, max_lines_count=500, max_boxes_count=500, max_labels_count=500)

// -----------------------------------------------------------------------------
// Ribbon MA + SHIFT label + FVG (3-svickovy Fair Value Gap) + magnet "key area".
// Pine v5, bez UDT (safer). Boxy FVG jsou VYRAZNE (transparency 40), aby byly
// videt i na svetlem chart pozadi.
// -----------------------------------------------------------------------------

// ==================== INPUTS ====================
grpR = "Ribbon"
useR    = input.bool(true, "Show ribbon",           group=grpR)
lenFast = input.int(20,  "EMA fast", minval=2, group=grpR)
lenMid  = input.int(34,  "EMA mid",  minval=3, group=grpR)
lenSlow = input.int(50,  "EMA slow", minval=5, group=grpR)
atrLen  = input.int(14,  "ATR length", minval=1, group=grpR)
atrMult = input.float(0.20, "Min |fast-slow| as ×ATR to confirm regime", minval=0.0, step=0.05, group=grpR)

grpS = "SHIFT label"
useShift = input.bool(true,  "Show SHIFT labels", group=grpS)
holdBars = input.int(5, "Min bars between SHIFTs", minval=0, group=grpS)

grpF = "FVG"
useFVG      = input.bool(true, "Show FVG (current TF)", group=grpF)
showFilled  = input.bool(true, "Keep filled FVGs on chart (history)", group=grpF)
minFvgH     = input.float(0.5, "Min FVG height (pts)", minval=0.0, step=0.25, group=grpF)
fvgOpac     = input.int(30,  "Active FVG opacity",  minval=0, maxval=100, group=grpF)
fvgOpacHist = input.int(80,  "Filled FVG opacity (history)", minval=0, maxval=100, group=grpF)
fvgLive     = input.int(20,  "Max width of ACTIVE FVG (bars)", minval=3, group=grpF)
fvgMaxN     = input.int(200, "Max FVG boxes kept on chart", minval=20, maxval=500, group=grpF)

grpK = "Key area (magnet)"
useKey  = input.bool(true, "Highlight nearest unfilled FVG as key area", group=grpK)
keyMin  = input.float(3.0, "Min key-area height (pts)", minval=0.0, step=0.5, group=grpK)

grpC = "Colors"
cUp   = input.color(color.new(color.green,  75), "Ribbon UP",      group=grpC)
cDn   = input.color(color.new(color.red,    75), "Ribbon DN",      group=grpC)
cNeu  = input.color(color.new(color.yellow, 78), "Ribbon NEUTRAL", group=grpC)
cBull = input.color(color.aqua, "Bull FVG",  group=grpC)
cBear = input.color(color.red,  "Bear FVG",  group=grpC)

// ==================== RIBBON ====================
emaF = ta.ema(close, lenFast)
emaM = ta.ema(close, lenMid)
emaS = ta.ema(close, lenSlow)

atrv = ta.atr(atrLen)
sepMin = atrMult * atrv

alignUp = emaF > emaM and emaM > emaS and (emaF - emaS) > sepMin
alignDn = emaF < emaM and emaM < emaS and (emaS - emaF) > sepMin

regime = alignUp ? 1 : alignDn ? -1 : 0

pF = plot(useR ? emaF : na, "EMA fast", color=color.new(color.gray, 40))
pM = plot(useR ? emaM : na, "EMA mid",  color=color.new(color.gray, 20))
pS = plot(useR ? emaS : na, "EMA slow", color=color.new(color.gray, 0))

ribbonCol = regime == 1 ? cUp : regime == -1 ? cDn : cNeu
fill(pF, pM, color = useR ? ribbonCol : na, title="ribbon fill top")
fill(pM, pS, color = useR ? ribbonCol : na, title="ribbon fill bot")

// ==================== SHIFT label ====================
var int lastRegime = 0
var int lastShiftBar = -100000
newShift = regime != 0 and regime != lastRegime and (bar_index - lastShiftBar) >= holdBars

shiftUp = newShift and regime == 1  and lastRegime != 1
shiftDn = newShift and regime == -1 and lastRegime != -1

if newShift
    lastRegime := regime
    lastShiftBar := bar_index

if useShift and shiftUp
    label.new(bar_index, low, "SHIFT", style=label.style_label_up, color=color.new(color.green, 0), textcolor=color.white, size=size.small, yloc=yloc.belowbar)
if useShift and shiftDn
    label.new(bar_index, high, "SHIFT", style=label.style_label_down, color=color.new(color.red, 0), textcolor=color.white, size=size.small, yloc=yloc.abovebar)

// ==================== FVG ====================
var array<box>   fvgBox    = array.new<box>()
var array<float> fvgTop    = array.new<float>()
var array<float> fvgBot    = array.new<float>()
var array<bool>  fvgIsBull = array.new<bool>()
var array<int>   fvgBorn   = array.new<int>()
var array<bool>  fvgFilled = array.new<bool>()

// detekce nove FVG
if useFVG and bar_index >= 2
    bullGap = high[2] < low
    if bullGap
        gTop = low
        gBot = high[2]
        if (gTop - gBot) >= minFvgH
            bx = box.new(left=bar_index - 2, top=gTop, right=bar_index, bottom=gBot, bgcolor=color.new(cBull, fvgOpac), border_color=color.new(cBull, math.max(0, fvgOpac - 20)), border_width=1)
            array.push(fvgBox, bx)
            array.push(fvgTop, gTop)
            array.push(fvgBot, gBot)
            array.push(fvgIsBull, true)
            array.push(fvgBorn, bar_index)
            array.push(fvgFilled, false)

    bearGap = low[2] > high
    if bearGap
        gTop = low[2]
        gBot = high
        if (gTop - gBot) >= minFvgH
            bx = box.new(left=bar_index - 2, top=gTop, right=bar_index, bottom=gBot, bgcolor=color.new(cBear, fvgOpac), border_color=color.new(cBear, math.max(0, fvgOpac - 20)), border_width=1)
            array.push(fvgBox, bx)
            array.push(fvgTop, gTop)
            array.push(fvgBot, gBot)
            array.push(fvgIsBull, false)
            array.push(fvgBorn, bar_index)
            array.push(fvgFilled, false)

// update kazdou baru: aktivni FVG rostou vpravo, po vyplneni zmrazit a ztmavit
if array.size(fvgBox) > 0
    i = 0
    while i < array.size(fvgBox)
        top_i  = array.get(fvgTop, i)
        bot_i  = array.get(fvgBot, i)
        bull_i = array.get(fvgIsBull, i)
        born_i = array.get(fvgBorn, i)
        was_filled = array.get(fvgFilled, i)
        bx = array.get(fvgBox, i)

        if not was_filled
            // check zaplneni na aktualnim baru
            filled_now = bull_i ? (low <= bot_i) : (high >= top_i)
            if filled_now
                // zmrazit pravou hranu na aktualni baru + ztmavit
                box.set_right(bx, bar_index)
                col = bull_i ? cBull : cBear
                box.set_bgcolor(bx, color.new(col, fvgOpacHist))
                box.set_border_color(bx, color.new(col, math.max(0, fvgOpacHist - 20)))
                array.set(fvgFilled, i, true)
                if not showFilled
                    box.delete(bx)
                    array.remove(fvgBox, i)
                    array.remove(fvgTop, i)
                    array.remove(fvgBot, i)
                    array.remove(fvgIsBull, i)
                    array.remove(fvgBorn, i)
                    array.remove(fvgFilled, i)
                    continue
            else
                // aktivni, jeste ne moc siroky -> prodluz vpravo
                if (bar_index - born_i) <= fvgLive
                    box.set_right(bx, bar_index)
                // jinak: zmrazit sirku ale nechat aktivni barvu
        i += 1

// omezeni max poctu — smaz nejstarsi
while array.size(fvgBox) > fvgMaxN
    box.delete(array.get(fvgBox, 0))
    array.remove(fvgBox, 0)
    array.remove(fvgTop, 0)
    array.remove(fvgBot, 0)
    array.remove(fvgIsBull, 0)
    array.remove(fvgBorn, 0)
    array.remove(fvgFilled, 0)

// ==================== KEY AREA (magnet) ====================
var box   keyBox   = na
var label keyLabel = na

if useKey and barstate.islast
    if not na(keyBox)
        box.delete(keyBox)
        keyBox := na
    if not na(keyLabel)
        label.delete(keyLabel)
        keyLabel := na

    var float bestTop = na
    var float bestBot = na
    bestDist = 1e18
    bestTop := na
    bestBot := na

    if array.size(fvgBox) > 0
        for i = 0 to array.size(fvgBox) - 1
            if array.get(fvgFilled, i)
                continue
            top_i = array.get(fvgTop, i)
            bot_i = array.get(fvgBot, i)
            h = top_i - bot_i
            if h >= keyMin
                mid = (top_i + bot_i) / 2.0
                d = math.abs(close - mid)
                if d < bestDist
                    bestDist := d
                    bestTop := top_i
                    bestBot := bot_i

    if not na(bestTop)
        keyBox := box.new(left=bar_index - 40, top=bestTop, right=bar_index + 40, bottom=bestBot, border_color=color.new(color.white, 0), border_width=2, bgcolor=color.new(color.gray, 65))
        keyLabel := label.new(bar_index + 5, (bestTop + bestBot) / 2.0, "🧲 key area", style=label.style_none, textcolor=color.new(color.red, 0), size=size.normal)

// ==================== INFO TABLE ====================
var table t = table.new(position.top_right, 2, 5, border_width=1)
if barstate.islast
    table.cell(t, 0, 0, "Ribbon SHIFT", bgcolor=color.new(color.black, 80), text_color=color.white)
    table.cell(t, 1, 0, "value",        bgcolor=color.new(color.black, 80), text_color=color.white)
    table.cell(t, 0, 1, "regime")
    table.cell(t, 1, 1, regime == 1 ? "UP" : regime == -1 ? "DN" : "NEUTRAL",
               text_color = regime == 1 ? color.green : regime == -1 ? color.red : color.yellow)
    int nActive = 0
    int nFilled = 0
    if array.size(fvgBox) > 0
        for i = 0 to array.size(fvgBox) - 1
            if array.get(fvgFilled, i)
                nFilled += 1
            else
                nActive += 1
    table.cell(t, 0, 2, "FVG active/filled")
    table.cell(t, 1, 2, str.tostring(nActive) + " / " + str.tostring(nFilled))
    table.cell(t, 0, 3, "ATR" + str.tostring(atrLen))
    table.cell(t, 1, 3, str.tostring(atrv, "#.##"))
    table.cell(t, 0, 4, "min FVG h")
    table.cell(t, 1, 4, str.tostring(minFvgH, "#.##"))
