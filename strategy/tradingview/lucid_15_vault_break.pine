// @version=5
indicator("Lucid 15 — Vault Break (midnight CT level + VWAP)", overlay=true, max_labels_count=500, max_lines_count=500)

// =========================================================================
// VAULT BREAK (owner rules 2026-11-11). USE A 30-MINUTE NQ / MNQ CHART.
//   Level = price at midnight CT + 0.30 x ATR15
//           (ATR15 = mean high-low of the last 15 sessions, 00:00-17:00 CT)
//   VWAP  = anchored at midnight CT
//   From the 10:00 CT candle: a 30-min candle CLOSES above the level AND the
//   VWAP -> LONG at that close, TP 40 pt / SL 75 pt ($800 / $1,500 per NQ),
//   flat at 14:30 CT. Long only. Last entry candle closes 14:00 CT.
// Backtest NQ 2010-2026 (strategy/quantconnect/inqc/vault_break_inqc.py):
//   +$53 per NQ trade net (t 3.3), positive in all four eras; plain long at
//   10:00 CT only +$18 -> the level + VWAP filter is the edge.
// Lucid Flex 25K evaluation (vault_25k_inqc.py, last 6 years): best = the
//   FIRST signal of the day only (max trades / day = 1, the default here):
//   60% pass per attempt, ~20 trading days, ~$101 fees. Size: owner's choice.
// Intrabar order on 30-min bars: if TP and SL are both inside one bar the SL
//   is assumed first (conservative).
// =========================================================================

k        = input.float(0.30, "Level = midnight + k x ATR15", step=0.05)
atrLen   = input.int(15, "ATR sessions")
tpPts    = input.float(40.0, "Take profit (points)")
slPts    = input.float(75.0, "Stop loss (points)")
maxTr    = input.int(1, "Max trades per day (owner rule 3, eval plan 1)", minval=1, maxval=3)
showHist = input.bool(true, "Show historical trades")
showMid  = input.bool(false, "Show the midnight price")

TZ = "America/Chicago"
hCT = hour(time, TZ)
mCT = minute(time, TZ)
tCT = hCT * 60 + mCT                       // bar OPEN time, CT minutes
newDay = dayofmonth(time, TZ) != dayofmonth(time[1], TZ)
is30 = timeframe.period == "30"

// ---- session range history (00:00-17:00 CT) for ATR15
var float[] ranges = array.new_float()
var float sHi = na
var float sLo = na
var float mid = na
var float pv = 0.0
var float vv = 0.0
var int nToday = 0

if newDay
    if not na(sHi)
        array.push(ranges, sHi - sLo)
        if array.size(ranges) > atrLen
            array.shift(ranges)
    sHi := high
    sLo := low
    mid := open
    pv := 0.0
    vv := 0.0
    nToday := 0
else if tCT < 17 * 60
    sHi := math.max(nz(sHi, high), high)
    sLo := math.min(nz(sLo, low), low)

pv += hlc3 * volume
vv += volume
vwapMid = vv > 0 ? pv / vv : close
atr15 = array.size(ranges) == atrLen ? array.avg(ranges) : na
level = not na(mid) and not na(atr15) ? mid + k * atr15 : na

// ---- trade state
var float ePx = na
var float tp = na
var float sl = na
var int eBar = na
var line lTp = na
var line lSl = na
var line lE = na
var int nTr = 0
var int nWin = 0
var float sumPts = 0.0

closeTrade(px, why) =>
    pts = px - ePx
    if showHist
        label.new(bar_index, why == "SL" ? low : high, why + "\n" + (pts >= 0 ? "+" : "") + str.tostring(pts, "#.##") + " pt",
                  color = pts >= 0 ? color.new(color.green, 15) : color.new(color.red, 15), textcolor = color.white,
                  style = why == "SL" ? label.style_label_up : label.style_label_down, size = size.small)
    pts

// exits (from the bar after the entry)
if not na(ePx) and bar_index > eBar
    exitPx = float(na)
    why = ""
    if low <= sl
        exitPx := math.min(sl, open)
        why := "SL"
    else if high >= tp
        exitPx := math.max(tp, open)
        why := "TP"
    else if tCT == 14 * 60                 // the 14:00-14:30 CT candle: flat at its close
        exitPx := close
        why := "14:30"
    if not na(exitPx)
        p = closeTrade(exitPx, why)
        nTr += 1
        nWin += p > 0 ? 1 : 0
        sumPts += p
        if showHist
            line.set_x2(lTp, bar_index)
            line.set_x2(lSl, bar_index)
            line.set_x2(lE, bar_index)
        ePx := na

// entry on a confirmed 30-min candle opening 10:00 .. 13:30 CT
canEnter = is30 and na(ePx) and nToday < maxTr and tCT >= 10 * 60 and tCT <= 13 * 60 + 30
if canEnter and barstate.isconfirmed and not na(level) and close > level and close > vwapMid
    ePx := close
    tp := close + tpPts
    sl := close - slPts
    eBar := bar_index
    nToday += 1
    if showHist
        label.new(bar_index, low, "LONG\nTP " + str.tostring(tp, format.mintick) + "\nSL " + str.tostring(sl, format.mintick),
                  color = color.new(color.teal, 0), textcolor = color.white, style = label.style_label_up, size = size.small)
        lTp := line.new(bar_index, tp, bar_index + 1, tp, color = color.new(color.green, 0), width = 2)
        lSl := line.new(bar_index, sl, bar_index + 1, sl, color = color.new(color.red, 0), width = 2)
        lE := line.new(bar_index, ePx, bar_index + 1, ePx, color = color.new(color.gray, 0), style = line.style_dotted)

// keep the open trade's TP / SL lines running to the current bar
if not na(ePx) and showHist
    line.set_x2(lTp, bar_index)
    line.set_x2(lSl, bar_index)
    line.set_x2(lE, bar_index)

plot(level, "Vault level", color = color.new(color.orange, 0), linewidth = 2, style = plot.style_linebr)
plot(vwapMid, "VWAP (midnight CT)", color = color.new(color.blue, 0), linewidth = 2)
plot(showMid ? mid : na, "Midnight price", color = color.new(color.gray, 30), style = plot.style_linebr)
plot(not na(ePx) ? tp : na, "Open trade TP", color = color.new(color.green, 0), style = plot.style_linebr)
plot(not na(ePx) ? sl : na, "Open trade SL", color = color.new(color.red, 0), style = plot.style_linebr)
bgcolor(tCT >= 10 * 60 and tCT < 14 * 60 + 30 ? color.new(color.blue, 94) : na, title = "Trading window 10:00-14:30 CT")

var table tb = table.new(position.top_right, 1, 4, border_width = 1, bgcolor = color.new(color.black, 30))
if barstate.islast
    st = not is30 ? "use a 30-MINUTE chart" : not na(ePx) ? "LONG " + str.tostring(ePx, format.mintick) + " | TP " + str.tostring(tp, format.mintick) + " | SL " + str.tostring(sl, format.mintick) : nToday >= maxTr ? "done for today" : "waiting for a 30m close above level + VWAP"
    table.cell(tb, 0, 0, "LUCID 15 · VAULT BREAK", text_color = color.white, bgcolor = color.new(color.orange, 30))
    table.cell(tb, 0, 1, "level " + str.tostring(level, format.mintick) + " | VWAP " + str.tostring(vwapMid, format.mintick) + " | ATR15 " + str.tostring(atr15, "#.#"), text_color = color.white)
    table.cell(tb, 0, 2, st, text_color = color.white, bgcolor = not na(ePx) ? color.new(color.teal, 20) : color.new(color.gray, 50))
    table.cell(tb, 0, 3, "history: " + str.tostring(nTr) + " trades, win " + (nTr > 0 ? str.tostring(nWin * 100.0 / nTr, "#") : "-") + "%, " + str.tostring(sumPts, "#") + " pt", text_color = color.white)
