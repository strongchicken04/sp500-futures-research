// @version=5
indicator("Orochi Toolkit", overlay=true,
          max_lines_count=200, max_labels_count=200)

// =============================================================
//   Orochi Toolkit = Data Dump + Gameplan Renderer v jednom.
//   Sloucene do 1 souboru kvuli TV limitu max 1 saved custom script.
//   1) DUMP: VWAPs, VAs, ON range, prior day -> Pine Logs + tabulka
//   2) RENDER: gameplan text z inputu -> nakresli levely s tooltipy
//   Kazda cast se da vypnout master switchem.
// =============================================================

// ===== MASTER SWITCHES =====
showDump     = input.bool(true,  "▶ Show Data Dump",         group="Modules")
showRender   = input.bool(true,  "▶ Show Gameplan Renderer", group="Modules")

// ===== DUMP INPUTS =====
showLabels = input.bool(true,  "Show levels on chart", group="Dump display")
showTable  = input.bool(true,  "Show data table",      group="Dump display")
tblPos     = input.string("bottom_right", "Table position", options=["top_left","top_right","middle_right","bottom_left","bottom_right"], group="Dump display")
atrLen     = input.int(14, "ATR length", minval=1, group="Dump compute")
onStartHr  = input.int(18, "ON start hour ET", minval=0, maxval=23, group="Overnight")
onEndHr    = input.int(9,  "ON end hour ET",   minval=0, maxval=23, group="Overnight")
onEndMin   = input.int(30, "ON end minute ET", minval=0, maxval=59, group="Overnight")

// ===== RENDER INPUTS =====
gpTxt        = input.text_area("BIAS|Paste gameplan from Orochi Gameplan app\nLVL|0|BOTH|EXAMPLE|Example level|SL:|TP:", "Gameplan text", group="Gameplan renderer")
showTooltips = input.bool(true, "Show tooltips on labels", group="Gameplan renderer")
lineWidth    = input.int(1, "Line width", minval=1, maxval=4, group="Gameplan renderer")
labelSize    = input.string("normal", "Label size", options=["tiny","small","normal","large"], group="Gameplan renderer")
extendRight  = input.int(30, "Bars to extend line right", minval=5, group="Gameplan renderer")

colLong  = input.color(color.new(color.green, 20), "LONG color",  group="Gameplan colors")
colShort = input.color(color.new(color.red,   20), "SHORT color", group="Gameplan colors")
colBoth  = input.color(color.new(color.gray,  20), "BOTH color",  group="Gameplan colors")
colBias  = input.color(color.new(color.yellow, 0), "BIAS color",  group="Gameplan colors")

// ===== DUMP HELPERS =====
tp = hlc3

_anchoredVwap(bool anchor) =>
    var float num = 0.
    var float den = 0.
    var float sumSq = 0.
    if anchor
        num := 0.
        den := 0.
        sumSq := 0.
    num += tp * volume
    den += volume
    vwap_ = den > 0 ? num / den : na
    dev = tp - vwap_
    sumSq += dev * dev * volume
    var_ = den > 0 ? sumSq / den : na
    sd_ = math.sqrt(math.max(var_, 0))
    [vwap_, sd_]

_priorVwapKeeper(bool anchor) =>
    var float num = 0.
    var float den = 0.
    var float prev_final = na
    if anchor
        prev_final := den > 0 ? num / den : prev_final
        num := 0.
        den := 0.
    num += tp * volume
    den += volume
    prev_final

new_day   = ta.change(dayofweek) != 0
new_week  = ta.change(weekofyear) != 0
new_month = ta.change(month) != 0

[dvw, dsd] = _anchoredVwap(new_day)
dva_h = dvw + dsd
dva_l = dvw - dsd
dva_h2 = dvw + 2 * dsd
dva_l2 = dvw - 2 * dsd
[wvw, wsd] = _anchoredVwap(new_week)
wva_h = wvw + wsd
wva_l = wvw - wsd
[mvw, msd] = _anchoredVwap(new_month)
mva_h = mvw + msd
mva_l = mvw - msd

pdVwapFinal = _priorVwapKeeper(new_day)

pdOpen  = request.security(syminfo.tickerid, "D", open[1],  lookahead=barmerge.lookahead_off)
pdHigh  = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_off)
pdLow   = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_off)
pdClose = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_off)
pwHigh = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_off)
pwLow  = request.security(syminfo.tickerid, "W", low[1],  lookahead=barmerge.lookahead_off)

et_h = hour(time, "America/New_York")
et_m = minute(time, "America/New_York")
in_on = (et_h >= onStartHr) or (et_h < onEndHr) or (et_h == onEndHr and et_m < onEndMin)

var float onH = na
var float onL = na
var float onH_prev = na
var float onL_prev = na
var float onM_prev = na
rth_start = (et_h == onEndHr and et_m == onEndMin)
if rth_start
    onH_prev := onH
    onL_prev := onL
    onM_prev := (onH + onL) / 2.0
    onH := na
    onL := na
if in_on
    onH := na(onH) ? high : math.max(onH, high)
    onL := na(onL) ? low  : math.min(onL, low)

atrv = ta.atr(atrLen)

var float pdSD = na
var float pdSD_running = 0.
if new_day
    pdSD := pdSD_running != 0 ? pdSD_running : pdSD
    pdSD_running := 0.
pdSD_running := dsd
pdVA_H = pdVwapFinal + pdSD
pdVA_L = pdVwapFinal - pdSD

// ===== DUMP LEVELS ON CHART =====
plot(showDump and showLabels ? dvw : na,   "DVWAP",   color=color.new(color.orange, 0), linewidth=2)
plot(showDump and showLabels ? dva_h : na, "D +1σ",   color=color.new(color.orange, 50))
plot(showDump and showLabels ? dva_l : na, "D -1σ",   color=color.new(color.orange, 50))
plot(showDump and showLabels ? dva_h2 : na, "D +2σ",  color=color.new(color.orange, 75), style=plot.style_stepline)
plot(showDump and showLabels ? dva_l2 : na, "D -2σ",  color=color.new(color.orange, 75), style=plot.style_stepline)
plot(showDump and showLabels ? wvw : na,   "WVWAP",   color=color.new(color.aqua, 0), linewidth=2)
plot(showDump and showLabels ? wva_h : na, "W +1σ",   color=color.new(color.aqua, 50))
plot(showDump and showLabels ? wva_l : na, "W -1σ",   color=color.new(color.aqua, 50))
plot(showDump and showLabels ? mvw : na,   "MVWAP",   color=color.new(color.purple, 0), linewidth=1)
plot(showDump and showLabels ? pdHigh : na,  "PDH",  color=color.new(color.gray, 30), style=plot.style_stepline)
plot(showDump and showLabels ? pdLow  : na,  "PDL",  color=color.new(color.gray, 30), style=plot.style_stepline)
plot(showDump and showLabels ? pdClose : na, "PDC",  color=color.new(color.gray, 50), style=plot.style_stepline)
plot(showDump and showLabels ? pdVwapFinal : na, "PD-VWAP (~POC)", color=color.new(color.yellow, 0), style=plot.style_stepline)
plot(showDump and showLabels ? onH_prev : na, "ONH", color=color.new(color.red,  30), style=plot.style_stepline)
plot(showDump and showLabels ? onL_prev : na, "ONL", color=color.new(color.lime, 30), style=plot.style_stepline)
plot(showDump and showLabels ? onM_prev : na, "ONM", color=color.new(color.white,50), style=plot.style_stepline)

// ===== DUMP TABLE =====
_addrow(table tt, int rr, string k, string v) =>
    table.cell(tt, 0, rr, k, bgcolor=color.new(color.black, 80), text_color=color.white, text_size=size.small)
    table.cell(tt, 1, rr, v, bgcolor=color.new(color.gray,  80), text_color=color.white, text_size=size.small)
    rr + 1

tblPosVal = tblPos == "top_left" ? position.top_left : tblPos == "top_right" ? position.top_right : tblPos == "middle_right" ? position.middle_right : tblPos == "bottom_left" ? position.bottom_left : position.bottom_right
var table t = table.new(tblPosVal, 2, 22, border_width=1)
if showDump and showTable and barstate.islast
    r = 0
    r := _addrow(t, r, "SYM", syminfo.ticker + " @ " + str.tostring(close, "#.##"))
    r := _addrow(t, r, "ATR" + str.tostring(atrLen), str.tostring(atrv, "#.##"))
    r := _addrow(t, r, "D-VWAP", str.tostring(dvw, "#.##"))
    r := _addrow(t, r, "D +1σ / -1σ", str.tostring(dva_h, "#.##") + " / " + str.tostring(dva_l, "#.##"))
    r := _addrow(t, r, "D +2σ / -2σ", str.tostring(dva_h2, "#.##") + " / " + str.tostring(dva_l2, "#.##"))
    r := _addrow(t, r, "W-VWAP", str.tostring(wvw, "#.##"))
    r := _addrow(t, r, "W +1σ / -1σ", str.tostring(wva_h, "#.##") + " / " + str.tostring(wva_l, "#.##"))
    r := _addrow(t, r, "M-VWAP", str.tostring(mvw, "#.##"))
    r := _addrow(t, r, "M +1σ / -1σ", str.tostring(mva_h, "#.##") + " / " + str.tostring(mva_l, "#.##"))
    r := _addrow(t, r, "PD-VWAP (POC~)", str.tostring(pdVwapFinal, "#.##"))
    r := _addrow(t, r, "PD-VA H / L", str.tostring(pdVA_H, "#.##") + " / " + str.tostring(pdVA_L, "#.##"))
    r := _addrow(t, r, "PD O", str.tostring(pdOpen, "#.##"))
    r := _addrow(t, r, "PD H", str.tostring(pdHigh, "#.##"))
    r := _addrow(t, r, "PD L", str.tostring(pdLow, "#.##"))
    r := _addrow(t, r, "PD C", str.tostring(pdClose, "#.##"))
    r := _addrow(t, r, "PW H", str.tostring(pwHigh, "#.##"))
    r := _addrow(t, r, "PW L", str.tostring(pwLow, "#.##"))
    r := _addrow(t, r, "ONH", str.tostring(onH_prev, "#.##"))
    r := _addrow(t, r, "ONL", str.tostring(onL_prev, "#.##"))
    r := _addrow(t, r, "ONM", str.tostring(onM_prev, "#.##"))

// ===== BUILD DUMP TEXT + SHOW AS COPYABLE LABEL + LOG + FIXED PANEL =====
var label dumpLabel = na
var table dumpTbl = table.new(position.middle_right, 1, 1, border_width=1)
if showDump and barstate.islast
    txt = "=== OROCHI DUMP === " + syminfo.ticker + " @ " + str.tostring(close, "#.##") + "\n"
    txt := txt + "TIME_UTC: " + str.format_time(time, "yyyy-MM-dd HH:mm", "UTC") + "\n"
    txt := txt + "TF: " + timeframe.period + "\n"
    txt := txt + "ATR" + str.tostring(atrLen) + ": " + str.tostring(atrv, "#.##") + "\n"
    txt := txt + "-- DAILY VWAP --\n"
    txt := txt + "D-VWAP: " + str.tostring(dvw, "#.##") + "\n"
    txt := txt + "D+1σ: " + str.tostring(dva_h, "#.##") + "\n"
    txt := txt + "D-1σ: " + str.tostring(dva_l, "#.##") + "\n"
    txt := txt + "D+2σ: " + str.tostring(dva_h2, "#.##") + "\n"
    txt := txt + "D-2σ: " + str.tostring(dva_l2, "#.##") + "\n"
    txt := txt + "-- WEEKLY VWAP --\n"
    txt := txt + "W-VWAP: " + str.tostring(wvw, "#.##") + "\n"
    txt := txt + "W+1σ: " + str.tostring(wva_h, "#.##") + "\n"
    txt := txt + "W-1σ: " + str.tostring(wva_l, "#.##") + "\n"
    txt := txt + "-- MONTHLY VWAP --\n"
    txt := txt + "M-VWAP: " + str.tostring(mvw, "#.##") + "\n"
    txt := txt + "M+1σ: " + str.tostring(mva_h, "#.##") + "\n"
    txt := txt + "M-1σ: " + str.tostring(mva_l, "#.##") + "\n"
    txt := txt + "-- PRIOR DAY --\n"
    txt := txt + "PD-VWAP: " + str.tostring(pdVwapFinal, "#.##") + "\n"
    txt := txt + "PD-VA-H: " + str.tostring(pdVA_H, "#.##") + "\n"
    txt := txt + "PD-VA-L: " + str.tostring(pdVA_L, "#.##") + "\n"
    txt := txt + "PDO: "  + str.tostring(pdOpen, "#.##")  + "\n"
    txt := txt + "PDH: "  + str.tostring(pdHigh, "#.##")  + "\n"
    txt := txt + "PDL: "   + str.tostring(pdLow, "#.##")   + "\n"
    txt := txt + "PDC: " + str.tostring(pdClose, "#.##") + "\n"
    txt := txt + "-- PRIOR WEEK --\n"
    txt := txt + "PWH: " + str.tostring(pwHigh, "#.##") + "\n"
    txt := txt + "PWL: "  + str.tostring(pwLow, "#.##")  + "\n"
    txt := txt + "-- OVERNIGHT --\n"
    txt := txt + "ONH: " + str.tostring(onH_prev, "#.##") + "\n"
    txt := txt + "ONL: " + str.tostring(onL_prev, "#.##") + "\n"
    txt := txt + "ONM: " + str.tostring(onM_prev, "#.##") + "\n"
    txt := txt + "=== END DUMP ==="
    log.info(txt)
    // Method 1: Label at last bar (tap on mobile -> panel with text -> long-press -> copy)
    if not na(dumpLabel)
        label.delete(dumpLabel)
    dumpLabel := label.new(x=bar_index + 5, y=close, text="📋 DUMP (tap)\n\n" + txt, xloc=xloc.bar_index, yloc=yloc.price, style=label.style_label_left, color=color.new(color.black, 20), textcolor=color.white, size=size.small, textalign=text.align_left)
    // Method 2: Alert with dump text (set up "Any alert() function call" alert once,
    // then every session-close you get a notification with the full copyable dump)
    alert(txt, alert.freq_once_per_bar_close)
    // Method 3: Table cell at middle_right — always visible, tap-and-hold to select
    table.cell(dumpTbl, 0, 0, txt, bgcolor=color.new(color.black, 20), text_color=color.white, text_size=size.small, text_halign=text.align_left)

// ===== RENDERER =====
var array<line>  arr_lines = array.new<line>()
var array<label> arr_lbls  = array.new<label>()

if showRender and barstate.islast
    if array.size(arr_lines) > 0
        for i = 0 to array.size(arr_lines) - 1
            line.delete(array.get(arr_lines, i))
    if array.size(arr_lbls) > 0
        for i = 0 to array.size(arr_lbls) - 1
            label.delete(array.get(arr_lbls, i))
    array.clear(arr_lines)
    array.clear(arr_lbls)

    lines = str.split(gpTxt, "\n")
    biasTxt = ""

    lsize = labelSize == "tiny" ? size.tiny : labelSize == "small" ? size.small : labelSize == "large" ? size.large : size.normal

    for i = 0 to array.size(lines) - 1
        row = array.get(lines, i)
        row := str.trim(row)
        if str.length(row) == 0
            continue
        if str.startswith(row, "#")
            continue
        parts = str.split(row, "|")
        if array.size(parts) < 2
            continue
        kind = str.upper(str.trim(array.get(parts, 0)))

        if kind == "BIAS"
            biasTxt := array.size(parts) >= 2 ? array.get(parts, 1) : ""
            continue

        if kind == "LVL"
            if array.size(parts) < 5
                continue
            priceStr = str.trim(array.get(parts, 1))
            price = str.tonumber(priceStr)
            if na(price)
                continue
            dir = str.upper(str.trim(array.get(parts, 2)))
            typ = str.trim(array.get(parts, 3))
            desc = str.trim(array.get(parts, 4))
            slStr = array.size(parts) >= 6 ? str.trim(array.get(parts, 5)) : ""
            tpStr = array.size(parts) >= 7 ? str.trim(array.get(parts, 6)) : ""

            col = dir == "LONG" ? colLong : dir == "SHORT" ? colShort : colBoth

            l = line.new(x1=bar_index - 20, y1=price, x2=bar_index + extendRight, y2=price, color=col, width=lineWidth, extend=extend.right)
            array.push(arr_lines, l)

            labelTxt = typ + " " + priceStr + " (" + dir + ")"
            tip = desc
            if str.length(slStr) > 0
                tip := tip + "\n" + slStr
            if str.length(tpStr) > 0
                tip := tip + "\n" + tpStr

            lbl = label.new(x=bar_index + extendRight, y=price, text=labelTxt, style=label.style_label_left, color=col, textcolor=color.white, size=lsize, tooltip=showTooltips ? tip : "")
            array.push(arr_lbls, lbl)

    if str.length(biasTxt) > 0
        biasLbl = label.new(x=bar_index, y=high, text="BIAS: " + biasTxt, style=label.style_label_down, color=colBias, textcolor=color.black, size=size.normal, yloc=yloc.abovebar)
        array.push(arr_lbls, biasLbl)
